[info]
name = kobic
version = 0.1.0-alpha
layer = composition
description = Kobic Engine - OOP 3D game engine for Dolet. No ECS.
author = xRo0t
license = MIT

[dependencies]
json = "*"
image = "*"
dpk = "*"
vulkan = "1.3"
window = "*"
input = "*"
# Sound: buffers, WAV and the mixer; 3D scenes (audio3d, pure); the output
# device (speaker, os, which adds the `audio` target capability itself).
audio = "*"
audio3d = "*"
speaker = "*"

[target]
# Capabilities the selected target must provide; compared with the target's
# library/platform/<target-id>/platform.toml [capabilities] at compile time.
requires = "window, vulkan"
