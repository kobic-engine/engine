##############################
# Kobic - glTF Loader
# Uses the general json package. This file owns glTF-specific rules.
##############################

struct GltfLoader:
    _placeholder: i32 = 0

attach GltfLoader:

    static fun node_reaches(nodes: JsonValue, current: i32, target: i32, depth: i32) -> i32:
        if current == target:
            return 1
        if current < 0:
            return 0
        if current >= nodes.size():
            return 0
        if depth > nodes.size():
            return 0
        node: JsonValue = nodes.at(current)
        children: JsonValue = node.get("children")
        i: i32 = 0
        while i < children.size():
            child_index: i32 = children.at(i).as_i32()
            if GltfLoader.node_reaches(nodes, child_index, target, depth + 1) == 1:
                return 1
            i = i + 1
        return 0

    # The lightweight raw glTF path uploads meshes directly and intentionally
    # has no runtime scene graph. Only accept files for which that flattening is
    # exact. General hierarchy, transforms, instancing, skins, and morphs must
    # use the offline .kobicmodel cooker, which bakes static node transforms.
    static fun raw_scene_is_flat_safe(root: JsonValue) -> i32:
        nodes: JsonValue = root.get("nodes")
        meshes: JsonValue = root.get("meshes")
        scenes: JsonValue = root.get("scenes")
        node_count: i32 = nodes.size()
        mesh_count: i32 = meshes.size()
        if mesh_count <= 0:
            return 1
        if node_count <= 0:
            return 0
        if scenes.size() <= 0:
            return 0
        scene_index: i32 = 0
        scene_value: JsonValue = root.get("scene")
        if scene_value.exists() == 1:
            scene_index = scene_value.as_i32()
        if scene_index < 0:
            return 0
        if scene_index >= scenes.size():
            return 0
        scene: JsonValue = scenes.at(scene_index)
        roots: JsonValue = scene.get("nodes")
        if roots.size() <= 0:
            return 0

        ni: i32 = 0
        while ni < node_count:
            node: JsonValue = nodes.at(ni)
            if node.get("matrix").exists() == 1:
                return 0
            if node.get("translation").exists() == 1:
                return 0
            if node.get("rotation").exists() == 1:
                return 0
            if node.get("scale").exists() == 1:
                return 0
            if node.get("skin").exists() == 1:
                return 0
            if node.get("weights").exists() == 1:
                return 0
            mesh_value: JsonValue = node.get("mesh")
            if mesh_value.exists() == 1:
                mesh_index: i32 = mesh_value.as_i32()
                if mesh_index < 0:
                    return 0
                if mesh_index >= mesh_count:
                    return 0
                reachable: i32 = 0
                ri: i32 = 0
                while ri < roots.size():
                    root_index: i32 = roots.at(ri).as_i32()
                    if GltfLoader.node_reaches(nodes, root_index, ni, 0) == 1:
                        reachable = 1
                    ri = ri + 1
                if reachable == 0:
                    return 0
            ni = ni + 1

        mi: i32 = 0
        while mi < mesh_count:
            references: i32 = 0
            ni = 0
            while ni < node_count:
                mesh_value2: JsonValue = nodes.at(ni).get("mesh")
                if mesh_value2.exists() == 1:
                    if mesh_value2.as_i32() == mi:
                        references = references + 1
                ni = ni + 1
            if references != 1:
                return 0
            mesh: JsonValue = meshes.at(mi)
            primitives: JsonValue = mesh.get("primitives")
            pi: i32 = 0
            while pi < primitives.size():
                targets: JsonValue = primitives.at(pi).get("targets")
                if targets.exists() == 1:
                    if targets.size() > 0:
                        return 0
                pi = pi + 1
            mi = mi + 1
        return 1

attach Model3D:

    fun primitive_count(self) -> i32:
        if Str.equals(self.format, "kobicmodel"):
            return self.kobic_part_count
        if self.parsed == 0:
            return 0
        if self.doc.valid() == 0:
            return 0
        root: JsonValue = self.doc.root
        meshes: JsonValue = root.get("meshes")
        total: i32 = 0
        mi: i32 = 0
        mesh_count: i32 = meshes.size()
        while mi < mesh_count:
            mesh: JsonValue = meshes.at(mi)
            prims: JsonValue = mesh.get("primitives")
            total = total + prims.size()
            mi = mi + 1
        return total

    fun mesh_primitive_count(self, mesh_index: i32) -> i32:
        if Str.equals(self.format, "kobicmodel"):
            if mesh_index != 0:
                return 0
            return self.kobic_part_count
        if self.parsed == 0:
            return 0
        if self.doc.valid() == 0:
            return 0
        if mesh_index < 0:
            return 0
        root: JsonValue = self.doc.root
        meshes: JsonValue = root.get("meshes")
        if mesh_index >= meshes.size():
            return 0
        mesh: JsonValue = meshes.at(mesh_index)
        prims: JsonValue = mesh.get("primitives")
        return prims.size()

    fun primitive_material_index(self, mesh_index: i32, primitive_index: i32) -> i32:
        if Str.equals(self.format, "kobicmodel"):
            if mesh_index != 0:
                return -1
            if primitive_index < 0:
                return -1
            if primitive_index >= self.kobic_part_count:
                return -1
            return primitive_index
        if self.parsed == 0:
            return -1
        if self.doc.valid() == 0:
            return -1
        if mesh_index < 0:
            return -1
        if primitive_index < 0:
            return -1
        root: JsonValue = self.doc.root
        meshes: JsonValue = root.get("meshes")
        if mesh_index >= meshes.size():
            return -1
        mesh: JsonValue = meshes.at(mesh_index)
        prims: JsonValue = mesh.get("primitives")
        if primitive_index >= prims.size():
            return -1
        prim: JsonValue = prims.at(primitive_index)
        return prim.get_i32("material")

    fun material_name(self, material_index: i32) -> str:
        if Str.equals(self.format, "kobicmodel"):
            if material_index < 0:
                return ""
            if material_index >= self.kobic_part_count:
                return ""
            part_entry: i64 = self.kobic_part_table + ((material_index as i64) * 32)
            name_offset: i64 = Memory.read_i32(self.kobic_data + part_entry + 8) as i64
            name_size: i64 = Memory.read_i32(self.kobic_data + part_entry + 12) as i64
            if name_offset <= 0:
                return ""
            if name_size <= 0:
                return ""
            if name_offset + name_size > self.kobic_size:
                return ""
            return (self.kobic_data + name_offset) as str
        if self.parsed == 0:
            return ""
        if self.doc.valid() == 0:
            return ""
        if material_index < 0:
            return ""
        root: JsonValue = self.doc.root
        materials: JsonValue = root.get("materials")
        if material_index >= materials.size():
            return ""
        material: JsonValue = materials.at(material_index)
        return material.get_str("name")

    fun primitive_material_name(self, mesh_index: i32, primitive_index: i32) -> str:
        material_index: i32 = self.primitive_material_index(mesh_index, primitive_index)
        return self.material_name(material_index)

attach GltfLoader:

    # `resolved_path` is a located string (see AssetFiles): a pack entry or a file.
    static fun load(path: str, resolved_path: str, format: str) -> Model3D:
        if AssetFiles.exists_located(resolved_path) == 0:
            return Model3D(path=path, resolved_path=resolved_path, format=format, mesh_id=-1, found=0, parsed=0, ready=0, error="model file not found")

        if Str.equals(format, "glb"):
            return Model3D(path=path, resolved_path=resolved_path, format=format, mesh_id=-1, found=1, parsed=0, ready=0, error="GLB loading is not implemented yet")

        doc: JsonDocument = AssetFiles.parse_json(resolved_path)
        if doc.valid() == 0:
            return Model3D(path=path, resolved_path=resolved_path, format=format, mesh_id=-1, found=1, parsed=0, ready=0, error=doc.error)

        root: JsonValue = doc.root
        asset: JsonValue = root.get("asset")
        version: str = asset.get_str("version")
        if Str.equals(version, "2.0") == false:
            return Model3D(path=path, resolved_path=resolved_path, format=format, mesh_id=-1, found=1, parsed=0, ready=0, error="unsupported glTF version")

        if GltfLoader.raw_scene_is_flat_safe(root) == 0:
            return Model3D(path=path, resolved_path=resolved_path, format=format, mesh_id=-1, found=1, parsed=0, ready=0, error="glTF scene hierarchy requires a v2 .kobicmodel; cook it with Kobic Cooker")

        meshes: JsonValue = root.get("meshes")
        nodes: JsonValue = root.get("nodes")
        materials: JsonValue = root.get("materials")

        mesh_count: i32 = meshes.size()
        node_count: i32 = nodes.size()
        material_count: i32 = materials.size()

        return Model3D(
            path=path,
            resolved_path=resolved_path,
            format=format,
            doc=doc,
            mesh_id=-1,
            mesh_count=mesh_count,
            node_count=node_count,
            material_count=material_count,
            found=1,
            parsed=1,
            ready=0,
            error=""
        )
