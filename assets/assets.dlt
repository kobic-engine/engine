##############################
# Kobic - Assets
# Public resource loading facade.
##############################

static g_assets_root: str = ""
static g_assets_mounted: i32 = 0

attach Assets:

    static fun mount(root: str):
        if Str.equals(root, ""):
            g_assets_root = ""
            g_assets_mounted = 0
            return
        g_assets_root = root
        g_assets_mounted = 1

    static fun root() -> str:
        return g_assets_root

    static fun mounted() -> i32:
        return g_assets_mounted

    static fun resolve(path: str) -> str:
        if g_assets_mounted == 0:
            return ""
        if PathOps.is_absolute(path):
            return PathOps.resolve_path(path)
        joined: str = PathOps.join_path(g_assets_root, path)
        return PathOps.resolve_path(joined)

attach ModelLods:

    static fun auto(lod1_distance: f32, lod2_distance: f32) -> ModelLods:
        lod1: f32 = lod1_distance
        lod2: f32 = lod2_distance
        if lod1 < 0.0:
            lod1 = 0.0
        if lod2 < lod1:
            lod2 = lod1
        return ModelLods(lod1_distance=lod1, lod2_distance=lod2, enabled=1)

attach AssetModels:

    static fun runtime_lod1_path(path: str) -> str:
        if Str.ends_with(path, ".kobic.gltf") == false:
            return ""
        path_len: i64 = Memory.strlen(path)
        if path_len <= 10:
            return ""
        base: str = Str.substring(path, 0, path_len - 5)
        return base + ".lod1.gltf"

    static fun runtime_lod2_path(path: str) -> str:
        if Str.ends_with(path, ".kobic.gltf") == false:
            return ""
        path_len: i64 = Memory.strlen(path)
        if path_len <= 10:
            return ""
        base: str = Str.substring(path, 0, path_len - 5)
        return base + ".lod2.gltf"

    # A model is whatever its name holds: a cooked model (obin cooks every
    # glTF into the pack as one, LODs included) or glTF text read as it is.
    static fun load(path: str) -> Model3D:
        located: str = AssetFiles.locate(path)
        format: str = "gltf"
        if Str.ends_with(path, ".glb"):
            format = "glb"
        if Str.equals(located, ""):
            return Model3D(path=path, resolved_path="", format=format, mesh_id=-1, found=0, parsed=0, ready=0, error="asset root is not mounted; call Assets.mount before loading assets")
        bytes: DpkBytes = AssetFiles.read_located(located)
        if bytes.ok == 0:
            return Model3D(path=path, resolved_path=located, format=format, mesh_id=-1, found=0, parsed=0, ready=0, error="model file not found")
        if bytes.size >= 4 and Memory.read_i32(bytes.data) == KOBIC_MODEL_MAGIC:
            return KobicModelLoader.load_bytes(path, located, bytes.data, bytes.size)
        bytes.free()
        if Str.ends_with(path, ".gltf") == false and Str.ends_with(path, ".glb") == false:
            return Model3D(path=path, resolved_path=located, format="unknown", mesh_id=-1, found=1, parsed=0, ready=0, error="unsupported model format")
        return GltfLoader.load(path, located, format)

attach AssetTextures:

    # Complete editable cells; upload-time gutters never crop the PNG.
    # Material padding must be gutter/(core+2*gutter).
    static fun load_tiled_atlas(path: str, spec: TextureSpec, columns: i32, rows: i32, core_pixels: i32, gutter_pixels: i32) -> Texture2D:
        resolved: str = AssetFiles.locate(path)
        if Str.equals(resolved, ""):
            return Texture2D(path=path, texture_id=-1, error="asset root is not mounted")
        tid: i32 = Engine.upload_texture_atlas_spec(path,spec,columns,rows,core_pixels,gutter_pixels)
        if tid < 0:
            return Texture2D(path=path, resolved_path=resolved, texture_id=-1, error="atlas load or dimensions failed; requires PNG or lossless RGBA8 cooked source")
        return Texture2D(path=path, resolved_path=resolved, texture_id=tid, found=1, ready=1)

    # Read a PNG, upload it to the GPU with the default (smooth) spec, and
    # return a ready-to-use Texture2D whose texture_id is bound-able.
    static fun load(path: str) -> Texture2D:
        return AssetTextures.load(path, TextureSpec.smooth())

    # Same, but the TextureSpec controls how the image appears (filtering,
    # wrapping, color space). One CPU read + one GPU upload, done once.
    static fun load(path: str, spec: TextureSpec) -> Texture2D:
        resolved: str = AssetFiles.locate(path)
        if Str.equals(resolved, ""):
            return Texture2D(path=path, resolved_path="", texture_id=-1, found=0, ready=0, error="asset root is not mounted; call Assets.mount before loading assets")
        if AssetFiles.exists_located(resolved) == 0:
            return Texture2D(path=path, resolved_path=resolved, texture_id=-1, found=0, ready=0, error="texture file not found")
        tid: i32 = Engine.upload_texture_spec(path, spec)
        ready: i32 = 0
        if tid >= 0:
            ready = 1
        return Texture2D(path=path, resolved_path=resolved, texture_id=tid, found=1, ready=ready)

attach AssetAudio:

    static fun load(path: str) -> AudioClip:
        resolved: str = AssetFiles.locate(path)
        if Str.equals(resolved, ""):
            return AudioClip(path=path, resolved_path="", found=0, ready=0, error="asset root is not mounted; call Assets.mount before loading assets")
        found: i32 = AssetFiles.exists_located(resolved)
        return AudioClip(path=path, resolved_path=resolved, found=found, ready=0)

attach AssetShaders:

    static fun load(path: str) -> Shader3D:
        resolved: str = AssetFiles.locate(path)
        if Str.equals(resolved, ""):
            return Shader(path=path, resolved_path="", found=0, ready=0, error="asset root is not mounted; call Assets.mount before loading assets")
        found: i32 = AssetFiles.exists_located(resolved)
        return Shader(path=path, resolved_path=resolved, found=found, ready=0)
