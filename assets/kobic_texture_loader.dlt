##############################
# Kobic - Cooked Texture Loader
# v1 RGBA8 compatibility + v2 GPU-native mip chains.
##############################

imm KOBIC_TEXTURE_MAGIC: i32 = 0x58455446
imm KOBIC_TEXTURE_VERSION: i32 = 2
imm KOBIC_TEXTURE_V1_HEADER_SIZE: i64 = 32
imm KOBIC_TEXTURE_HEADER_SIZE: i64 = 64
imm KOBIC_TEXTURE_LEVEL_SIZE: i64 = 16

imm KOBIC_TEXTURE_FORMAT_RGBA8: i32 = 1
imm KOBIC_TEXTURE_FORMAT_BC7: i32 = 2
imm KOBIC_TEXTURE_FORMAT_BC5: i32 = 3
imm KOBIC_TEXTURE_FORMAT_BC4: i32 = 4

imm KOBIC_TEXTURE_SWIZZLE_IDENTITY: i32 = 0
imm KOBIC_TEXTURE_SWIZZLE_GB_FROM_RG: i32 = 1

struct CookedTexture:
    version: i32 = 0
    width: i32 = 0
    height: i32 = 0
    format: i32 = 0
    flags: i32 = 0
    mip_count: i32 = 0
    swizzle: i32 = 0
    kind: i32 = 0
    levels: i64 = 0
    pixels: i64 = 0
    size: i64 = 0
    buffer: i64 = 0
    valid: i32 = 0

    fun level_offset(self, level: i32) -> i64:
        if level < 0 or level >= self.mip_count or self.levels == 0:
            return 0
        return Memory.read_i32(self.levels + (level as i64) * KOBIC_TEXTURE_LEVEL_SIZE) as i64

    fun level_size(self, level: i32) -> i64:
        if level < 0 or level >= self.mip_count or self.levels == 0:
            return 0
        return Memory.read_i32(self.levels + (level as i64) * KOBIC_TEXTURE_LEVEL_SIZE + 4) as i64

    fun level_width(self, level: i32) -> i32:
        if level < 0 or level >= self.mip_count or self.levels == 0:
            return 0
        return Memory.read_i32(self.levels + (level as i64) * KOBIC_TEXTURE_LEVEL_SIZE + 8)

    fun level_height(self, level: i32) -> i32:
        if level < 0 or level >= self.mip_count or self.levels == 0:
            return 0
        return Memory.read_i32(self.levels + (level as i64) * KOBIC_TEXTURE_LEVEL_SIZE + 12)

    fun vk_format(self, srgb: i32) -> i32:
        if self.format == KOBIC_TEXTURE_FORMAT_BC7:
            if srgb != 0:
                return 146
            return 145
        if self.format == KOBIC_TEXTURE_FORMAT_BC5:
            return 141
        if self.format == KOBIC_TEXTURE_FORMAT_BC4:
            return 139
        if srgb != 0:
            return 43
        return 37

    fun free(self):
        if self.buffer != 0:
            Memory.free(self.buffer)
        self.version = 0
        self.width = 0
        self.height = 0
        self.format = 0
        self.flags = 0
        self.mip_count = 0
        self.swizzle = 0
        self.kind = 0
        self.levels = 0
        self.pixels = 0
        self.size = 0
        self.buffer = 0
        self.valid = 0

fun kobic_texture_expected_level_size(width: i32, height: i32, format: i32) -> i64:
    if format == KOBIC_TEXTURE_FORMAT_RGBA8:
        return (width as i64) * (height as i64) * 4
    blocks_x: i64 = ((width + 3) / 4) as i64
    blocks_y: i64 = ((height + 3) / 4) as i64
    block_size: i64 = 16
    if format == KOBIC_TEXTURE_FORMAT_BC4:
        block_size = 8
    return blocks_x * blocks_y * block_size

fun kobic_texture_load_v1(data: i64, size: i64) -> CookedTexture:
    width: i32 = Memory.read_i32(data + 8)
    height: i32 = Memory.read_i32(data + 12)
    channels: i32 = Memory.read_i32(data + 16)
    format: i32 = Memory.read_i32(data + 20)
    data_offset: i64 = Memory.read_i32(data + 24) as i64
    data_size: i64 = Memory.read_i32(data + 28) as i64
    expected: i64 = (width as i64) * (height as i64) * 4
    if width <= 0 or height <= 0 or channels != 4 or format != KOBIC_TEXTURE_FORMAT_RGBA8:
        return CookedTexture()
    if data_offset < KOBIC_TEXTURE_V1_HEADER_SIZE or data_size != expected or data_offset + data_size > size:
        return CookedTexture()
    # Reuse the v1 header's final 16 bytes as a synthetic single-level entry.
    Memory.write_i32(data + 16, 0)
    Memory.write_i32(data + 20, data_size as i32)
    Memory.write_i32(data + 24, width)
    Memory.write_i32(data + 28, height)
    return CookedTexture(version=1, width=width, height=height, format=format, flags=0, mip_count=1, swizzle=0, kind=0, levels=data + 16, pixels=data + data_offset, size=data_size, buffer=data, valid=1)

fun kobic_texture_load_v2(data: i64, size: i64) -> CookedTexture:
    if size < KOBIC_TEXTURE_HEADER_SIZE:
        return CookedTexture()
    width: i32 = Memory.read_i32(data + 8)
    height: i32 = Memory.read_i32(data + 12)
    format: i32 = Memory.read_i32(data + 16)
    flags: i32 = Memory.read_i32(data + 20)
    mip_count: i32 = Memory.read_i32(data + 24)
    swizzle: i32 = Memory.read_i32(data + 28)
    table_offset: i64 = Memory.read_i32(data + 32) as i64
    entry_size: i32 = Memory.read_i32(data + 36)
    data_offset: i64 = Memory.read_i32(data + 40) as i64
    data_size: i64 = Memory.read_i32(data + 44) as i64
    kind: i32 = Memory.read_i32(data + 48)
    if width <= 0 or height <= 0 or format < KOBIC_TEXTURE_FORMAT_RGBA8 or format > KOBIC_TEXTURE_FORMAT_BC4:
        return CookedTexture()
    if mip_count <= 0 or mip_count > 32 or entry_size != (KOBIC_TEXTURE_LEVEL_SIZE as i32):
        return CookedTexture()
    if swizzle < KOBIC_TEXTURE_SWIZZLE_IDENTITY or swizzle > KOBIC_TEXTURE_SWIZZLE_GB_FROM_RG:
        return CookedTexture()
    table_size: i64 = (mip_count as i64) * KOBIC_TEXTURE_LEVEL_SIZE
    if table_offset < KOBIC_TEXTURE_HEADER_SIZE or table_offset + table_size > size:
        return CookedTexture()
    if data_offset < table_offset + table_size or data_size <= 0 or data_offset + data_size > size:
        return CookedTexture()
    expected_width: i32 = width
    expected_height: i32 = height
    expected_offset: i64 = 0
    level: i32 = 0
    while level < mip_count:
        entry: i64 = data + table_offset + (level as i64) * KOBIC_TEXTURE_LEVEL_SIZE
        level_offset: i64 = Memory.read_i32(entry) as i64
        level_size: i64 = Memory.read_i32(entry + 4) as i64
        level_width: i32 = Memory.read_i32(entry + 8)
        level_height: i32 = Memory.read_i32(entry + 12)
        expected_size: i64 = kobic_texture_expected_level_size(expected_width, expected_height, format)
        if level_offset != expected_offset or level_size != expected_size:
            return CookedTexture()
        if level_width != expected_width or level_height != expected_height:
            return CookedTexture()
        if level_offset + level_size > data_size:
            return CookedTexture()
        expected_offset = expected_offset + level_size
        if expected_width > 1:
            expected_width = expected_width / 2
        if expected_height > 1:
            expected_height = expected_height / 2
        level = level + 1
    if expected_offset != data_size:
        return CookedTexture()
    return CookedTexture(version=2, width=width, height=height, format=format, flags=flags, mip_count=mip_count, swizzle=swizzle, kind=kind, levels=data + table_offset, pixels=data + data_offset, size=data_size, buffer=data, valid=1)

struct KobicTextureLoader:
    _placeholder: i32 = 0

attach KobicTextureLoader:

    # `resolved_path` is a located string (see AssetFiles): a pack entry or a file.
    static fun load(resolved_path: str) -> CookedTexture:
        bytes: DpkBytes = AssetFiles.read_located(resolved_path)
        if bytes.ok == 0:
            return CookedTexture()
        return KobicTextureLoader.load_bytes(bytes.data, bytes.size)

    # Parse a cooked texture from memory. Takes ownership of `data`: the
    # texture keeps it, or it is freed on failure.
    static fun load_bytes(data: i64, size: i64) -> CookedTexture:
        if size < KOBIC_TEXTURE_V1_HEADER_SIZE or size > 2147483647:
            Memory.free(data)
            return CookedTexture()
        if Memory.read_i32(data) != KOBIC_TEXTURE_MAGIC:
            Memory.free(data)
            return CookedTexture()
        version: i32 = Memory.read_i32(data + 4)
        cooked: CookedTexture = CookedTexture()
        if version == 1:
            cooked = kobic_texture_load_v1(data, size)
        elif version == KOBIC_TEXTURE_VERSION:
            cooked = kobic_texture_load_v2(data, size)
        if cooked.valid == 0:
            Memory.free(data)
        return cooked
