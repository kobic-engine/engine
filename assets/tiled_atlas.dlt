# CPU-only atlas preparation. Source cells are entirely authored pixels;
# wrapped filtering gutters live in a separate upload image, never in the PNG.
fun kobic_texture_pad_atlas(source: Image, columns: i32, rows: i32, core_pixels: i32, gutter_pixels: i32) -> Image:
    if source.is_valid() == 0:
        return Image.empty()
    if columns <= 0 or rows <= 0 or columns > 256 or rows > 256:
        return Image.empty()
    if core_pixels <= 0 or core_pixels > 2048 or gutter_pixels < 0 or gutter_pixels > core_pixels:
        return Image.empty()
    if source.width != columns*core_pixels or source.height != rows*core_pixels or source.channels != 4:
        return Image.empty()
    if source.stride < source.width*4:
        return Image.empty()
    cell: i32 = core_pixels+gutter_pixels*2
    width: i32 = columns*cell
    height: i32 = rows*cell
    if width > 8192 or height > 8192:
        return Image.empty()
    if (width as i64)*(height as i64)*4 > 67108864:
        return Image.empty()
    target: Image = Image.create(width,height)
    if target.is_valid() == 0:
        return Image.empty()
    tile_y: i32 = 0
    while tile_y < rows:
        tile_x: i32 = 0
        while tile_x < columns:
            y: i32 = 0
            while y < cell:
                sy: i32 = tile_y*core_pixels+(y+core_pixels-gutter_pixels)%core_pixels
                x: i32 = 0
                while x < cell:
                    sx: i32 = tile_x*core_pixels+(x+core_pixels-gutter_pixels)%core_pixels
                    pixel: i32 = Memory.read_i32(source.data+source.pixel_offset(sx,sy))
                    Memory.write_i32(target.data+target.pixel_offset(tile_x*cell+x,tile_y*cell+y),pixel)
                    x += 1
                y += 1
            tile_x += 1
        tile_y += 1
    return target
