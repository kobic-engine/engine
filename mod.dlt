##############################
# Kobic Engine - Module Manifest
# Grows as phases land (see ROADMAP.md).
##############################
module kobic

import window
import json
import image
requires vulkan

# Phase 1: Math
load kobic/math/math_utils
load kobic/math/vec3
load kobic/math/mat4
load kobic/math/quat
load kobic/math/color

# Phase 2: Core OOP shell
load kobic/core/platform/{os}/time
load kobic/core/time
load kobic/core/window
load kobic/core/app
load kobic/core/platform/{os}/input

# Assets
load kobic/assets/types
load kobic/assets/gltf_loader
load kobic/assets/kobic_model_loader
load kobic/assets/kobic_texture_loader
load kobic/assets/assets
load kobic/assets/tiled_atlas

# Phase 3: Scene objects
load kobic/scene/environment
load kobic/scene/node
load kobic/scene/mesh_transform_group
load kobic/scene/game_object
load kobic/scene/material3d
load kobic/scene/mesh3d
load kobic/scene/sprite3d
load kobic/scene/light3d
load kobic/scene/day_cycle
load kobic/scene/physics

# Phase 3.5: Early software rendering
load kobic/render/software_renderer

# Phase 4: Independent Vulkan GPU rendering
load kobic/render/gpu_shaders
load kobic/render/gpu_culling
load kobic/render/platform/{os}/gpu_vulkan_context
load kobic/render/gpu_swapchain
load kobic/render/gpu_texture
load kobic/render/gpu_hzb
load kobic/render/gpu_shadow
load kobic/render/gpu_sky
load kobic/render/gpu_bloom
load kobic/render/gpu_vertex_layout
load kobic/render/gpu_foliage
load kobic/render/gpu_profiler
load kobic/render/gpu_render_pass
load kobic/render/gpu_temporal
load kobic/render/gpu_renderer_core
load kobic/render/gpu_debug
load kobic/render/gpu_mesh
load kobic/render/gpu_skinning
load kobic/render/mesh_update_budget
load kobic/render/gpu
load kobic/core/runtime
load kobic/core/engine
load kobic/scene/skeleton3d
load kobic/scene/spring_arm3d
load kobic/scene/mesh_particles3d

# Benchmarks
load kobic/core/benchmark

# Umbrella hub
load kobic/kobic

