##############################
# Kobic - Quaternion (x, y, z, w)
##############################

struct Quat:
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 1.0

attach Quat:

    static fun identity() -> Quat:
        return Quat()

    static fun make(x: f32, y: f32, z: f32, w: f32) -> Quat:
        q: Quat = Quat()
        q.x = x
        q.y = y
        q.z = z
        q.w = w
        return q

    # Axis-angle rotation. axis should be normalized; angle in degrees.
    static fun from_axis_angle(ax: f32, ay: f32, az: f32, angle_deg: f32) -> Quat:
        pi: f32 = 3.14159265
        half: f32 = angle_deg * pi / 360.0
        s: f32 = @sin(half)
        return Quat.make(ax * s, ay * s, az * s, @cos(half))

    # Euler (deg) in yaw-pitch-roll order (y, x, z).
    static fun from_euler_deg(yaw: f32, pitch: f32, roll: f32) -> Quat:
        pi: f32 = 3.14159265
        cy: f32 = @cos(yaw   * pi / 360.0)
        sy: f32 = @sin(yaw   * pi / 360.0)
        cp: f32 = @cos(pitch * pi / 360.0)
        sp: f32 = @sin(pitch * pi / 360.0)
        cr: f32 = @cos(roll  * pi / 360.0)
        sr: f32 = @sin(roll  * pi / 360.0)
        q: Quat = Quat()
        q.w = cr * cp * cy + sr * sp * sy
        q.x = cr * sp * cy + sr * cp * sy
        q.y = cr * cp * sy - sr * sp * cy
        q.z = sr * cp * cy - cr * sp * sy
        return q

    fun mul(self, b: Quat) -> Quat:
        r: Quat = Quat()
        r.x = self.w * b.x + self.x * b.w + self.y * b.z - self.z * b.y
        r.y = self.w * b.y - self.x * b.z + self.y * b.w + self.z * b.x
        r.z = self.w * b.z + self.x * b.y - self.y * b.x + self.z * b.w
        r.w = self.w * b.w - self.x * b.x - self.y * b.y - self.z * b.z
        return r

    fun conjugate(self) -> Quat:
        return Quat.make(0.0 - self.x, 0.0 - self.y, 0.0 - self.z, self.w)

    fun length(self) -> f32:
        return @sqrt(self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w)

    fun normalize(self) -> Quat:
        l: f32 = self.length()
        if l < 0.0001:
            return Quat.identity()
        inv: f32 = 1.0 / l
        return Quat.make(self.x * inv, self.y * inv, self.z * inv, self.w * inv)

    # Rotate a direction from local space into world space. This is the
    # allocation-free q * v * conjugate(q) form for a unit quaternion.
    fun rotate_vec3(self, v: Vec3) -> Vec3:
        q: Quat = self.normalize()
        tx: f32 = 2.0 * (q.y * v.z - q.z * v.y)
        ty: f32 = 2.0 * (q.z * v.x - q.x * v.z)
        tz: f32 = 2.0 * (q.x * v.y - q.y * v.x)
        return Vec3.make(
            v.x + q.w * tx + q.y * tz - q.z * ty,
            v.y + q.w * ty + q.z * tx - q.x * tz,
            v.z + q.w * tz + q.x * ty - q.y * tx
        )

    # Build a column-major rigid world transform from this orientation.
    # Keeping this next to Quat makes quaternion camera/viewmodel transforms
    # use exactly one convention throughout Kobic.
    fun to_mat4(self, tx: f32, ty: f32, tz: f32) -> Mat4:
        q: Quat = self.normalize()
        xx: f32 = q.x * q.x
        yy: f32 = q.y * q.y
        zz: f32 = q.z * q.z
        xy: f32 = q.x * q.y
        xz: f32 = q.x * q.z
        yz: f32 = q.y * q.z
        xw: f32 = q.x * q.w
        yw: f32 = q.y * q.w
        zw: f32 = q.z * q.w
        m: Mat4 = Mat4()
        m.m0 = 1.0 - 2.0 * (yy + zz)
        m.m1 = 2.0 * (xy + zw)
        m.m2 = 2.0 * (xz - yw)
        m.m4 = 2.0 * (xy - zw)
        m.m5 = 1.0 - 2.0 * (xx + zz)
        m.m6 = 2.0 * (yz + xw)
        m.m8 = 2.0 * (xz + yw)
        m.m9 = 2.0 * (yz - xw)
        m.m10 = 1.0 - 2.0 * (xx + yy)
        m.m12 = tx
        m.m13 = ty
        m.m14 = tz
        return m
