# CPU-only checks for the per-mesh sphere frustum test used by the CPU cull
# path. It must be conservative at any FOV (a sphere that still touches the
# view is never rejected), reject spheres that are fully outside, honour the
# model transform (rotated/translated meshes), and agree with the normalized
# planes the GPU cull shader uses.
import std
import frog

fun frustum_check(ok: bool, message: str):
    if ok == false:
        print("FAIL: " + message)
        Command.exit(1)

# Same effective radius as _frog_instance_visible (unit model scale).
fun frustum_effective_radius(radius: f32) -> f32:
    return radius * 1.05 + 0.5

fun frustum_gpu_visible(planes: i64, x: f32, y: f32, z: f32, radius: f32) -> i32:
    i: i32 = 0
    while i < 6:
        base: i64 = (i as i64) * 16
        distance: f32 = Memory.read_f32(planes + base) * x + Memory.read_f32(planes + base + 4) * y + Memory.read_f32(planes + base + 8) * z + Memory.read_f32(planes + base + 12)
        if distance < 0.0 - radius:
            return 0
        i = i + 1
    return 1

fun run_frustum_cull_checks():
    vp: i64 = Memory.malloc_zeroed(64)
    model: i64 = Memory.malloc_zeroed(64)
    planes: i64 = Memory.malloc_zeroed(6 * 16)
    # Camera at the origin looking down -Z with the game's 70 degree vertical
    # FOV: the vertical projection scale is ~1.43, above 1.
    Mat4.perspective(70.0, 16.0 / 9.0, 0.1, 4096.0).write_to_ptr(vp)
    Mat4.identity().write_to_ptr(model)
    frog_cull_extract_planes(vp, planes)
    half_tan: f32 = 0.70020753    # tan(35 degrees)
    cos_half: f32 = 0.81915204    # cos(35 degrees)

    frustum_check(_frog_instance_visible(vp, model, 0.0, 0.0, -10.0, 1.0) == 1, "sphere straight ahead")

    # Close to the camera, centre below the bottom edge but the sphere still
    # reaches into the view. The old clip-space test rejected exactly this.
    depth: f32 = 2.0
    edge_y: f32 = 0.0 - depth * half_tan
    radius: f32 = 2.0
    inside_offset: f32 = (frustum_effective_radius(radius) * 0.8) / cos_half
    frustum_check(_frog_instance_visible(vp, model, 0.0, edge_y - inside_offset, 0.0 - depth, radius) == 1, "sphere straddling the bottom edge near the camera")
    frustum_check(_frog_instance_visible(vp, model, 0.0, 0.0 - edge_y + inside_offset, 0.0 - depth, radius) == 1, "sphere straddling the top edge near the camera")
    outside_offset: f32 = (frustum_effective_radius(radius) * 1.3) / cos_half
    frustum_check(_frog_instance_visible(vp, model, 0.0, edge_y - outside_offset, 0.0 - depth, radius) == 0, "sphere fully below the view")

    frustum_check(_frog_instance_visible(vp, model, 0.0, 0.0, 50.0, 2.0) == 0, "sphere behind the camera")
    frustum_check(_frog_instance_visible(vp, model, 0.0, 0.0, -5000.0, 2.0) == 0, "sphere beyond the far plane")

    # The model transform places the bounds: local (10,0,0) rotated -90
    # degrees about Y lands in front of the camera; unrotated it is beside it.
    Mat4.rotation_y(0.0 - 90.0).write_to_ptr(model)
    rotated_visible: i32 = _frog_instance_visible(vp, model, 10.0, 0.0, 0.0, 1.0)
    Mat4.rotation_y(90.0).write_to_ptr(model)
    other_visible: i32 = _frog_instance_visible(vp, model, 10.0, 0.0, 0.0, 1.0)
    frustum_check(rotated_visible + other_visible == 1, "rotation decides which side the bounds land on")
    Mat4.translation(0.0, 0.0, -20.0).write_to_ptr(model)
    frustum_check(_frog_instance_visible(vp, model, 0.0, 0.0, 0.0, 1.0) == 1, "translated bounds in view")
    Mat4.identity().write_to_ptr(model)

    # Agreement with the GPU shader's normalized planes over a deterministic
    # cloud of spheres around the frustum boundary.
    seed: i64 = 12345
    mismatches: i32 = 0
    tested: i32 = 0
    while tested < 4000:
        seed = (seed * 1103515245 + 12345) % 2147483648
        px: f32 = (((seed % 20000) as f32) / 10000.0 - 1.0) * 60.0
        seed = (seed * 1103515245 + 12345) % 2147483648
        py: f32 = (((seed % 20000) as f32) / 10000.0 - 1.0) * 40.0
        seed = (seed * 1103515245 + 12345) % 2147483648
        pz: f32 = 0.0 - ((seed % 10000) as f32) / 100.0 + 5.0
        seed = (seed * 1103515245 + 12345) % 2147483648
        pr: f32 = ((seed % 1000) as f32) / 100.0
        cpu: i32 = _frog_instance_visible(vp, model, px, py, pz, pr)
        gpu: i32 = frustum_gpu_visible(planes, px, py, pz, frustum_effective_radius(pr))
        if cpu != gpu:
            mismatches = mismatches + 1
        tested = tested + 1
    frustum_check(mismatches == 0, "CPU sphere test matches the GPU planes")
    Memory.free(vp)
    Memory.free(model)
    Memory.free(planes)
    print("PASS: conservative sphere frustum test at 70 degree FOV, model transforms, CPU/GPU plane agreement (4000 spheres)")

run_frustum_cull_checks()
