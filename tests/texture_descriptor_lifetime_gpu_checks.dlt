# Native regression: immutable sampler reuse, pool rollover, resize + draw paths.
# No game assets or uniform-lighting extension are required.
import std
import kobic

fun texture_lifetime_require(ok: bool, message: str):
    if ok == false:
        print("FAIL: " + message)
        Command.exit(1)

fun texture_lifetime_fixture(seed: i32) -> i32:
    pixels: i64 = Memory.malloc_zeroed(16)
    index: i32 = 0
    while index < 4:
        Memory.write_i8(pixels + index * 4, (35 + seed * 25) as i8)
        Memory.write_i8(pixels + index * 4 + 1, (180 - seed * 15) as i8)
        Memory.write_i8(pixels + index * 4 + 2, 60)
        alpha: i32 = 255
        if index == 0:
            alpha = 0
        Memory.write_i8(pixels + index * 4 + 3, alpha as i8)
        index = index + 1
    renderer: Renderer = g_engine_runtime.active_renderer()
    tex: GpuTexture = gpu_texture_upload_rgba_spec(renderer.core.device, renderer.core.phys_device, renderer.core.gfx_queue, g_engine_runtime.render_pass.vk_command_pool, pixels, 2, 2, TextureSpec.pixel())
    Memory.free(pixels)
    texture_lifetime_require(tex.ok == 1, "RGBA cutout fixture upload")
    id: i32 = renderer.core.register_texture(g_engine_runtime.render_pass, tex)
    texture_lifetime_require(id >= 0, "fixture registration")
    return id

fun run_texture_descriptor_lifetime_checks():
    Engine.window.create("Kobic texture lifetime checks", 320, 180)
    scene: Scene = Scene.create()
    camera: Camera3D = Camera3D.create("test")
    camera.position(0.0, 0.0, 8.0)
    camera.set_clip_planes(0.1, 100.0)
    scene.add_child(camera)
    Engine.scene.set(scene)
    texture_lifetime_require(Engine.start() == 1, "native startup")
    renderer: Renderer = g_engine_runtime.active_renderer()
    texture_lifetime_require(renderer.core.ensure_white_texture(g_engine_runtime.render_pass, g_engine_runtime.render_pass.vk_command_pool) >= 0, "white fallback")
    textures: i64 = Memory.malloc_zeroed(7 * 4)
    index: i32 = 0
    while index < 7:
        Memory.write_i32(textures + index * 4, texture_lifetime_fixture(index))
        index = index + 1
    first: i32 = Engine.upload_cube_mesh()
    second: i32 = Engine.register_instance(first)
    tex0: i32 = Memory.read_i32(textures)
    Engine.bind_texture(first, tex0)
    Engine.bind_texture(second, tex0)
    mat: Material3D = Material3D.create().set_alpha_clip(1)
    Engine.bind_material(first, mat)
    Engine.bind_material(second, mat)
    baseline: i64 = renderer.core.mesh_descriptor_set(g_engine_runtime.render_pass, first)
    shared: i64 = renderer.core.mesh_descriptor_set(g_engine_runtime.render_pass, second)
    texture_lifetime_require(baseline != 0 and baseline != renderer.core.white_desc_set, "real cutout descriptor")
    texture_lifetime_require(shared == baseline, "equal texture tuples share immutable descriptors")
    baseline_count: i32 = g_engine_runtime.render_pass.material_desc_count
    index = 0
    while index < 50000:
        mat.set_roughness(((index % 100) as f32) / 100.0)
        mat.set_alpha(0.5 + ((index % 2) as f32) * 0.5)
        Engine.bind_material(first, mat)
        Engine.bind_texture(first, tex0)
        texture_lifetime_require(renderer.core.mesh_descriptor_set(g_engine_runtime.render_pass, first) == baseline, "scalar updates preserve texture descriptor")
        index = index + 1
    texture_lifetime_require(g_engine_runtime.render_pass.material_desc_count == baseline_count, "50000 scalar updates allocate zero new sampler sets")
    index = 0
    while index < 50000:
        tid: i32 = Memory.read_i32(textures + (index % 7) * 4)
        Engine.bind_texture(first, tid)
        mat.set_normal_map(Texture2D(texture_id=tid))
        mat.set_emissive_map(Texture2D(texture_id=tid))
        mat.set_metallic_roughness_map(Texture2D(texture_id=tid))
        mat.set_occlusion_map(Texture2D(texture_id=tid))
        Engine.bind_material(first, mat)
        dset: i64 = renderer.core.mesh_descriptor_set(g_engine_runtime.render_pass, first)
        texture_lifetime_require(dset != 0 and dset != renderer.core.white_desc_set, "texture changes never lose cutout sampler")
        index = index + 1
    texture_lifetime_require(g_engine_runtime.render_pass.material_desc_count <= baseline_count + 7, "50000 texture/map changes reuse seven tuples")
    print("PASS: 100000 live material/texture rebinds without descriptor growth or white fallback")

    # Exercise genuine unique materials beyond a single pool's 8192-set limit.
    # Seven immutable fixtures yield 7^5 distinct valid texture combinations.
    index = 0
    while index < 9000:
        code: i32 = index
        t0: i32 = Memory.read_i32(textures + (code % 7) * 4)
        code = code / 7
        t1: i32 = Memory.read_i32(textures + (code % 7) * 4)
        code = code / 7
        t2: i32 = Memory.read_i32(textures + (code % 7) * 4)
        code = code / 7
        t3: i32 = Memory.read_i32(textures + (code % 7) * 4)
        code = code / 7
        t4: i32 = Memory.read_i32(textures + (code % 7) * 4)
        images: MaterialDescriptorImages = MaterialDescriptorImages(albedo_view=Memory.read_ptr(renderer.core.tex_views + t0 * 8), albedo_sampler=Memory.read_ptr(renderer.core.tex_samplers + t0 * 8), emissive_view=Memory.read_ptr(renderer.core.tex_views + t1 * 8), emissive_sampler=Memory.read_ptr(renderer.core.tex_samplers + t1 * 8), normal_view=Memory.read_ptr(renderer.core.tex_views + t2 * 8), normal_sampler=Memory.read_ptr(renderer.core.tex_samplers + t2 * 8), metallic_roughness_view=Memory.read_ptr(renderer.core.tex_views + t3 * 8), metallic_roughness_sampler=Memory.read_ptr(renderer.core.tex_samplers + t3 * 8), occlusion_view=Memory.read_ptr(renderer.core.tex_views + t4 * 8), occlusion_sampler=Memory.read_ptr(renderer.core.tex_samplers + t4 * 8))
        dset: i64 = g_engine_runtime.render_pass.make_material_descriptor(renderer.core.device, images)
        texture_lifetime_require(dset != 0, "unique tuple survives pool rollover")
        index = index + 1
    texture_lifetime_require(g_engine_runtime.render_pass.desc_pool_count == 2, "bounded second bank for genuine distinct materials")
    texture_lifetime_require(renderer.core.mesh_descriptor_set(g_engine_runtime.render_pass, second) == baseline, "old bank remains valid after rollover")
    print("PASS: 9000 distinct texture tuples, two retained pools, original descriptor still valid")

    # A shadow target can change without replacing the render pass. Every
    # cached tuple, including sets in old banks, must reference its new view.
    vkDeviceWaitIdle(renderer.core.device)
    texture_lifetime_require(g_engine_runtime.render_pass.shadow.ensure_target(renderer.core.device, renderer.core.phys_device, 64) == 1, "shadow target growth")
    texture_lifetime_require(g_engine_runtime.render_pass.refresh_material_shadow_descriptors(renderer.core.device) == g_engine_runtime.render_pass.material_desc_count, "all cached shadow bindings refreshed")
    renderer.core._refresh_shadow_descriptors(g_engine_runtime.render_pass)
    texture_lifetime_require(renderer.core.mesh_descriptor_set(g_engine_runtime.render_pass, second) == baseline, "shadow replacement preserves material tuple")
    texture_lifetime_require(g_engine_runtime.render_pass.shadow.ensure_target(renderer.core.device, renderer.core.phys_device, 1) == 1, "shadow target shrink")
    renderer.core._refresh_shadow_descriptors(g_engine_runtime.render_pass)
    print("PASS: shadow target replacement refreshes all retained material banks")

    had_bindless: i32 = renderer.core.bindless_enabled
    table: i64 = renderer.core.bindless_set
    old_count: i32 = g_engine_runtime.render_pass.material_desc_count
    pass_index: i32 = 0
    while pass_index < 3:
        # First resize deliberately consumes pending texture uploads.
        texture_lifetime_require(g_engine_runtime.recreate_swapchain(320, 180) == 1, "render-pass recreation")
        if had_bindless == 1:
            texture_lifetime_require(g_engine_runtime.render_pass.bindless_pipeline != 0, "bindless pipeline restored")
            texture_lifetime_require(g_engine_runtime.render_pass.bindless_transparent_pipeline != 0, "transparent pipeline restored")
            texture_lifetime_require(renderer.core.bindless_set == table, "existing texture table retained")
        texture_lifetime_require(g_engine_runtime.render_pass.desc_pool_count == 1, "old banks released on recreation")
        texture_lifetime_require(g_engine_runtime.render_pass.material_desc_count < old_count, "generation-local material cache rebuilt")
        rebound: i64 = renderer.core.mesh_descriptor_set(g_engine_runtime.render_pass, second)
        texture_lifetime_require(rebound != 0 and rebound != renderer.core.white_desc_set, "valid texture rebound after recreation")
        texture_lifetime_require(Memory.read_i32(renderer.core.mesh_tex_ids + second * 4) == tex0, "base texture ID preserved")
        mode: i32 = 0
        while mode < 2:
            if mode == 0:
                g_engine_runtime.set_culling_mode(KOBIC_CULL_MODE_CPU)
            else:
                g_engine_runtime.set_culling_mode(KOBIC_CULL_MODE_GPU)
            frame: i32 = 0
            while frame < 4:
                Engine.begin_frame()
                Engine.render()
                frame = frame + 1
            mode = mode + 1
        pass_index = pass_index + 1
    Engine.shutdown()
    Memory.free(textures)
    print("PASS: three recreations, retained texture IDs, CPU/GPU draw paths and clean shutdown")

run_texture_descriptor_lifetime_checks()
