# AudioSource3D follows its node, and its emitter is released when the node
# is destroyed (alone or with its parent's tree). One-shots stay where they
# were played while the camera moves. No device or window.
import std
import audio
import audio3d
import kobic

g_source_fails: i32 = 0

fun source_require(ok: bool, what: str):
    if ok == false:
        println("FAIL audio source: " + what)
        g_source_fails = g_source_fails + 1

fun source_rms(buf: AudioBuffer, ch: i32) -> f32:
    acc: f64 = 0.0
    f: i64 = 0
    while f < buf.frames:
        x: f64 = buf.get(f, ch) as f64
        acc = acc + x * x
        f = f + 1
    if buf.frames <= 0:
        return 0.0
    return sqrt(acc / (buf.frames as f64)) as f32

fun source_noise(rate: i32, seconds: f32) -> AudioBuffer:
    clip: AudioBuffer = AudioBuffer.create_seconds(seconds, 1, rate)
    seed: i64 = 777
    f: i64 = 0
    while f < clip.frames:
        seed = (seed * 1103515245 + 12345) % 2147483648
        clip.set(f, 0, (((seed % 2000) as f32) / 1000.0 - 1.0) * 0.4)
        f = f + 1
    return clip

# Positive: left louder (dB).
fun source_balance(scene: AudioScene) -> f32:
    warm: AudioBuffer = scene.render_buffer(4800)
    warm.free()
    mix: AudioBuffer = scene.render_buffer(9600)
    left: f32 = source_rms(mix, 0)
    right: f32 = source_rms(mix, 1)
    mix.free()
    if right < 0.000001:
        return 99.0
    if left < 0.000001:
        return -99.0
    return 20.0 * (log10((left / right) as f64) as f32)

fun run_audio_source_checks():
    source_require(Engine.audio.start_offline(48000) == 1, "offline scene")
    scene: AudioScene = Engine.audio.scene()
    camera: Camera3D = Camera3D.create()
    noise: AudioBuffer = source_noise(48000, 2.0)

    target: Node3D = Node3D.create("car")
    target.pos_x = 4.0
    target.pos_z = -1.0
    source: AudioSource3D = AudioSource3D.create(noise, AudioEmitter(looping=true, max_distance=100.0, reverb_send=0.0)).follow(target)
    Engine.audio.frame(camera)
    source_require(source.handle != AUDIO3D_NONE and source.is_playing(), "autoplay starts on the first frame")
    right_side: f32 = source_balance(scene)
    target.pos_x = -4.0
    Engine.audio.frame(camera)
    left_side: f32 = source_balance(scene)
    println("follow balance dB: node right=" + Convert.f32_to_str(right_side) + " node left=" + Convert.f32_to_str(left_side))
    source_require(right_side < -3.0 and left_side > 3.0, "the emitter follows its node from right to left")

    handle: i64 = source.handle
    source.destroy()
    Engine.audio.frame(camera)
    gone: AudioBuffer = scene.render_buffer(4800)
    gone.free()
    Engine.audio.frame(camera)
    source_require(scene.slot(handle) < 0, "destroying the node releases its looping emitter")

    parent: Node3D = Node3D.create("parent")
    child: AudioSource3D = AudioSource3D.create(noise, AudioEmitter(looping=true, reverb_send=0.0))
    child.pos_z = -3.0
    parent.add_child(child as i64)
    Engine.audio.frame(camera)
    child_handle: i64 = child.handle
    source_require(child_handle != AUDIO3D_NONE, "a child source starts")
    parent.destroy_tree()
    Engine.audio.frame(camera)
    gone2: AudioBuffer = scene.render_buffer(4800)
    gone2.free()
    Engine.audio.frame(camera)
    source_require(scene.slot(child_handle) < 0, "destroying the parent's tree releases the child's emitter")

    # A one-shot at world (3, 0, -2): the camera then moves 6 m along +X, so
    # the shot must now be on the camera's left.
    shot: i64 = Engine.audio.play_at(noise, 3.0, 0.0, -2.0, AudioEmitter(reverb_send=0.0))
    Engine.audio.frame(camera)
    before: f32 = source_balance(scene)
    camera.pos_x = 6.0
    Engine.audio.frame(camera)
    after: f32 = source_balance(scene)
    println("one-shot balance dB: before=" + Convert.f32_to_str(before) + " after camera moved=" + Convert.f32_to_str(after))
    source_require(shot != AUDIO3D_NONE and before < -3.0 and after > 3.0, "a one-shot stays at its world position while the camera moves")

    noise.free()
    Engine.audio.shutdown()
    if g_source_fails == 0:
        println("PASS audio source: follows its node, released on destroy and with the parent's tree, one-shots stay in the world")
    else:
        Command.exit(1)

run_audio_source_checks()
