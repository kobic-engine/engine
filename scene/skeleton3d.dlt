import std

fun skeleton_matrix_read(p: i64) -> Mat4:
    return Mat4(m0=Memory.read_f32(p), m1=Memory.read_f32(p+4), m2=Memory.read_f32(p+8), m3=Memory.read_f32(p+12), m4=Memory.read_f32(p+16), m5=Memory.read_f32(p+20), m6=Memory.read_f32(p+24), m7=Memory.read_f32(p+28), m8=Memory.read_f32(p+32), m9=Memory.read_f32(p+36), m10=Memory.read_f32(p+40), m11=Memory.read_f32(p+44), m12=Memory.read_f32(p+48), m13=Memory.read_f32(p+52), m14=Memory.read_f32(p+56), m15=Memory.read_f32(p+60))

@heap struct Skeleton3D:
    joint_count: i32 = 0
    parents: i64 = 0
    local_poses: i64 = 0
    model_poses: i64 = 0
    inverse_binds: i64 = 0
    palette: i64 = 0

attach Skeleton3D:
    static fun create(count: i32) -> Skeleton3D:
        rig: Skeleton3D = Skeleton3D()
        if count <= 0 or count > 128:
            return rig
        rig.parents = Memory.malloc(count * 4)
        rig.local_poses = Memory.malloc(count * 64)
        rig.model_poses = Memory.malloc(count * 64)
        rig.inverse_binds = Memory.malloc(count * 64)
        if rig.parents == 0 or rig.local_poses == 0 or rig.model_poses == 0 or rig.inverse_binds == 0:
            rig.destroy()
            return rig
        rig.joint_count = count
        i: i32 = 0
        while i < count:
            Memory.write_i32(rig.parents + i * 4, -1)
            Mat4.identity().write_to_ptr(rig.local_poses + i * 64)
            Mat4.identity().write_to_ptr(rig.model_poses + i * 64)
            Mat4.identity().write_to_ptr(rig.inverse_binds + i * 64)
            i = i + 1
        return rig

    fun configure_joint(self, joint: i32, parent: i32, local_bind: Mat4, inverse_bind: Mat4) -> i32:
        if joint < 0 or joint >= self.joint_count or parent < -1 or parent >= joint:
            return 0
        Memory.write_i32(self.parents + joint * 4, parent)
        local_bind.write_to_ptr(self.local_poses + joint * 64)
        inverse_bind.write_to_ptr(self.inverse_binds + joint * 64)
        return 1

    fun set_local_pose(self, joint: i32, pose: Mat4):
        if joint >= 0 and joint < self.joint_count:
            pose.write_to_ptr(self.local_poses + joint * 64)

    fun evaluate(self):
        i: i32 = 0
        while i < self.joint_count:
            pose: Mat4 = skeleton_matrix_read(self.local_poses + i * 64)
            parent: i32 = Memory.read_i32(self.parents + i * 4)
            if parent >= 0:
                pose = skeleton_matrix_read(self.model_poses + parent * 64).mul(pose)
            pose.write_to_ptr(self.model_poses + i * 64)
            if self.palette != 0:
                pose.mul(skeleton_matrix_read(self.inverse_binds + i * 64)).write_to_ptr(g_frog_skin_cpu + self.palette + i * 64)
            i = i + 1

    # IK/procedural controllers can publish an already solved model-space
    # deformation matrix (jointModel * inverseBind), without CPU vertex work.
    fun set_deformation(self, joint: i32, deformation: Mat4):
        if joint >= 0 and joint < self.joint_count and self.palette != 0:
            deformation.write_to_ptr(g_frog_skin_cpu + self.palette + joint * 64)

    fun destroy(self):
        Memory.free(self.parents)
        Memory.free(self.local_poses)
        Memory.free(self.model_poses)
        Memory.free(self.inverse_binds)
        self.parents = 0
        self.local_poses = 0
        self.model_poses = 0
        self.inverse_binds = 0
        self.joint_count = 0
        self.palette = 0

@heap struct SkinnedMesh3D:
    mesh_id: i32 = -1
    skeleton_ptr: i64 = 0
    error: str = ""

fun skin_finite(v: f32) -> bool:
    return v == v and v > -1000000.0 and v < 1000000.0

# Strict versioned offline format: one indexed primitive, ordered joints,
# 44-byte static geometry, 32-byte influences, 144-byte joint records.
fun skin_validate(data: i64, size: i64) -> i32:
    # Keep pointer/length guards separate: Dolet boolean expressions may
    # evaluate both operands, so malformed input must never be dereferenced.
    if data == 0 or size < 48:
        return 0
    if Memory.read_i32(data) != 0x4B535246 or Memory.read_i32(data + 4) != 1:
        return 0
    nv: i32 = Memory.read_i32(data + 8)
    ni: i32 = Memory.read_i32(data + 12)
    nj: i32 = Memory.read_i32(data + 16)
    if nv <= 0 or nv > 32768 or ni <= 0 or ni > 196608 or ni % 3 != 0 or nj <= 0 or nj > 128:
        return 0
    vo: i64 = 48
    wo: i64 = vo + (nv as i64) * 44
    io: i64 = wo + (nv as i64) * 32
    jo: i64 = io + (ni as i64) * 4
    if size != jo + (nj as i64) * 144 or Memory.read_i32(data + 20) != vo as i32 or Memory.read_i32(data + 24) != wo as i32 or Memory.read_i32(data + 28) != io as i32 or Memory.read_i32(data + 32) != jo as i32:
        return 0
    i: i32 = 0
    while i < nv:
        sum: f32 = 0.0
        k: i32 = 0
        while k < 11:
            if skin_finite(Memory.read_f32(data + vo + i * 44 + k * 4)) == false:
                return 0
            k = k + 1
        k = 0
        while k < 4:
            index: f32 = Memory.read_f32(data + wo + i * 32 + k * 4)
            weight: f32 = Memory.read_f32(data + wo + i * 32 + 16 + k * 4)
            if skin_finite(index) == false or index < 0.0 or index >= nj as f32 or index != @floor(index):
                return 0
            if skin_finite(weight) == false or weight < 0.0 or weight > 1.0:
                return 0
            sum = sum + weight
            k = k + 1
        if sum < 0.9999 or sum > 1.0001:
            return 0
        i = i + 1
    i = 0
    while i < ni:
        index2: i32 = Memory.read_i32(data + io + i * 4)
        if index2 < 0 or index2 >= nv:
            return 0
        i = i + 1
    i = 0
    while i < nj:
        p: i32 = Memory.read_i32(data + jo + i * 144)
        if p < -1 or p >= i:
            return 0
        k2: i32 = 0
        while k2 < 32:
            if skin_finite(Memory.read_f32(data + jo + i * 144 + 16 + k2 * 4)) == false:
                return 0
            k2 = k2 + 1
        i = i + 1
    return 1

attach SkinnedMesh3D:
    static fun load(path: str) -> SkinnedMesh3D:
        mesh: SkinnedMesh3D = SkinnedMesh3D()
        file: File = File.open_cwd(Assets.resolve(path), "r")
        if file.is_valid() == false:
            mesh.error = "skin asset not found"
            return mesh
        size: i64 = file.get_size()
        if size < 48 or size > FROG_SKIN_BYTES:
            file.close()
            mesh.error = "invalid skin asset size"
            return mesh
        data: i64 = Memory.malloc(size)
        if data == 0:
            file.close()
            return mesh
        bytes: i32 = file.read_bytes(data, size as i32)
        file.close()
        if bytes as i64 != size or skin_validate(data, size) == 0:
            Memory.free(data)
            mesh.error = "invalid skin asset data"
            return mesh
        nv: i32 = Memory.read_i32(data + 8)
        ni: i32 = Memory.read_i32(data + 12)
        nj: i32 = Memory.read_i32(data + 16)
        rig: Skeleton3D = Skeleton3D.create(nj)
        if rig.joint_count != nj:
            Memory.free(data)
            Memory.free(rig as i64)
            mesh.error = "skeleton allocation failed"
            return mesh
        jo: i64 = Memory.read_i32(data + 32) as i64
        i: i32 = 0
        while i < nj:
            rec: i64 = data + jo + i * 144
            rig.configure_joint(i, Memory.read_i32(rec), skeleton_matrix_read(rec + 16), skeleton_matrix_read(rec + 80))
            i = i + 1
        geometry: GpuMeshData = GpuMeshData(vertices=data + 48, vertex_count=nv, indices=data + (Memory.read_i32(data + 28) as i64), index_count=ni)
        id: i32 = Engine.upload_mesh_data(geometry)
        if id >= 0:
            rig.palette = frog_skin_reserve(id, data + (Memory.read_i32(data + 24) as i64), nv, nj)
        Memory.free(data)
        if id < 0 or rig.palette == 0:
            if id >= 0:
                Engine.set_instance_visible(id, 0)
            rig.destroy()
            Memory.free(rig as i64)
            mesh.error = "skin allocation failed"
            return mesh
        mesh.mesh_id = id
        mesh.skeleton_ptr = rig as i64
        rig.evaluate()
        Engine.set_mesh_static_batch(id, 0)
        Engine.set_shadow_flags(id, 0, 0)
        Engine.set_instance_visible(id, 0)
        # Animated bounds are conservative, rather than bind-pose-only culling.
        core: GpuRendererCore = g_engine_runtime.renderer.core
        bound: f32 = Memory.read_f32(core.mesh_bound_rs + id * 4)
        Memory.write_f32(core.mesh_bound_rs + id * 4, bound * 2.0 + 0.5)
        return mesh

    fun destroy(self):
        if self.mesh_id >= 0:
            Engine.set_instance_visible(self.mesh_id, 0)
            frog_skin_release(self.mesh_id)
        if self.skeleton_ptr != 0:
            rig: Skeleton3D = self.skeleton_ptr as Skeleton3D
            rig.destroy()
            Memory.free(rig as i64)
        self.skeleton_ptr = 0
        self.mesh_id = -1
