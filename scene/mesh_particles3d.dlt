# Bounded, reusable mesh particles. Collision/world frames are application-owned.
# This is lightweight ballistic debris, not a rigid-body/stacking solver.
struct ParticleBody3D:
    position: Vec3 = Vec3()
    velocity: Vec3 = Vec3()
    rotation: Vec3 = Vec3()
    spin: Vec3 = Vec3()
    radius: f32 = 0.05
    quiet_time: f32 = 0.0
    sleeping: i32 = 0

struct ParticleContact3D:
    # 0 = clear, 1 = collision with resolved CENTRE, 2 = unavailable world.
    status: i32 = 0
    position: Vec3 = Vec3()
    normal: Vec3 = Vec3()

fun particle_body_integrate(body: ParticleBody3D, gravity: Vec3, dt: f32) -> ParticleBody3D:
    result: ParticleBody3D = body
    if dt<=0.0 or body.sleeping!=0:
        return result
    result.position = body.position.add(body.velocity.scale(dt)).add(gravity.scale(0.5*dt*dt))
    result.velocity = body.velocity.add(gravity.scale(dt))
    result.rotation = body.rotation.add(body.spin.scale(dt))
    return result

fun particle_body_contact(body: ParticleBody3D, contact: ParticleContact3D, restitution: f32, friction: f32, dt: f32) -> ParticleBody3D:
    result: ParticleBody3D = body
    if contact.status!=1 or contact.normal.length_sq()<0.00001:
        return result
    n: Vec3 = contact.normal.normalize()
    result.position = contact.position
    vn: f32 = body.velocity.dot(n)
    tangent: Vec3 = body.velocity.sub(n.scale(vn))
    if vn<0.0:
        bounce: f32 = clamp(restitution,0.0,0.8)
        if vn> -0.8:
            bounce = 0.0
        result.velocity = tangent.scale(1.0-clamp(friction,0.0,1.0)).sub(n.scale(vn*bounce))
        result.spin = body.spin.scale(0.65)
    if result.velocity.length_sq()<0.025:
        result.quiet_time += dt
        if result.quiet_time>=0.18:
            result.sleeping = 1
            result.velocity = Vec3.zero()
            result.spin = Vec3.zero()
    else:
        result.quiet_time = 0.0
    return result

@heap struct MeshParticleSlot3D:
    active: i32 = 0
    instance: i32 = -1
    body: ParticleBody3D = ParticleBody3D()
    previous: Vec3 = Vec3()
    previous_body: ParticleBody3D = ParticleBody3D()
    contact_due: i32 = 0
    age: f32 = 0.0
    lifetime: f32 = 0.0
    size: f32 = 1.0
    support_timer: f32 = 0.0
    blocked_timer: f32 = 0.0
    contact_rest_time: f32 = 0.0
    # Optional application-owned render/material revision; reset on reuse.
    render_tag: i32 = -1

@heap struct MeshParticles3D:
    slots: i64 = 0
    capacity: i32 = 0
    count: i32 = 0
    cursor: i32 = 0
    source_mesh: i32 = -1
    render_capacity: i32 = 0
    accumulator: f32 = 0.0
    frame_steps: i32 = 0
    restitution: f32 = 0.22
    friction: f32 = 0.35
    matrix: i64 = 0

attach MeshParticles3D:
    static fun create(capacity: i32) -> MeshParticles3D:
        pool: MeshParticles3D = MeshParticles3D()
        if capacity<=0 or capacity>512:
            return pool
        pool.slots = Memory.malloc_zeroed((capacity as i64)*8)
        pool.matrix = Memory.malloc(64)
        if pool.slots==0 or pool.matrix==0:
            pool.destroy()
            return pool
        pool.capacity = capacity
        i: i32 = 0
        while i<capacity:
            slot: MeshParticleSlot3D = MeshParticleSlot3D()
            Memory.write_ptr(pool.slots+(i as i64)*8,slot as i64)
            i += 1
        return pool

    fun slot(self, index: i32) -> MeshParticleSlot3D:
        if index<0 or index>=self.capacity or self.slots==0:
            return null
        return Memory.read_ptr(self.slots+(index as i64)*8) as MeshParticleSlot3D

    # Attach once; instances borrow shared geometry/material and are reused.
    fun set_mesh(self, source: i32):
        if source<0 or self.source_mesh>=0 or self.count!=0:
            return
        self.source_mesh = source
        Engine.set_instance_visible(source,0)
        i: i32 = 0
        while i<self.capacity:
            slot: MeshParticleSlot3D = self.slot(i)
            slot.instance = Engine.register_instance(source)
            if slot.instance>=0:
                self.render_capacity += 1
                Engine.set_instance_visible(slot.instance,0)
            i += 1

    fun available(self) -> i32:
        if self.source_mesh>=0:
            return self.render_capacity-self.count
        return self.capacity-self.count

    fun emit(self, body: ParticleBody3D, size: f32, lifetime: f32) -> i32:
        if self.available()<=0 or (size>0.0 and size<=256.0 and body.radius>0.0 and body.radius<=128.0)==false:
            return -1
        i: i32 = 0
        while i<self.capacity:
            index: i32 = (self.cursor+i)%self.capacity
            slot: MeshParticleSlot3D = self.slot(index)
            if slot.active==0 and (self.source_mesh<0 or slot.instance>=0):
                slot.body = body
                slot.previous = body.position
                slot.size = size
                slot.age = 0.0
                # Zero lifetime is persistent; the application explicitly releases it.
                slot.lifetime = max_f32(0.0,lifetime)
                slot.support_timer = (index%16) as f32 * 0.015
                slot.blocked_timer = 0.0
                slot.contact_rest_time = 0.0
                slot.render_tag = -1
                slot.active = 1
                if self.count==0:
                    self.accumulator = 0.0
                self.count += 1
                self.cursor = (index+1)%self.capacity
                return index
            i += 1
        return -1

    fun release(self, index: i32):
        slot: MeshParticleSlot3D = self.slot(index)
        if (slot as i64)==0 or slot.active==0:
            return
        slot.active = 0
        self.count -= 1
        if slot.instance>=0:
            Engine.set_instance_visible(slot.instance,0)

    # Like SpringArm3D, applications supply collision RESULTS rather than a
    # stored callback. No closure lifetime, world ownership or per-step heap work.
    fun begin_frame(self, dt: f32):
        self.frame_steps = 0
        if (dt>0.0 and dt<1000000.0)==false or self.count==0:
            return
        self.accumulator += min_f32(dt,0.06666667)

    fun advance_step(self, gravity: Vec3) -> i32:
        h: f32 = 1.0/120.0
        if self.accumulator<h or self.frame_steps>=8 or self.count==0:
            return 0
        i: i32 = 0
        while i<self.capacity:
            slot: MeshParticleSlot3D = self.slot(i)
            slot.contact_due = 0
            if slot.active!=0:
                slot.age += h
                if slot.lifetime>0.0 and slot.age>=slot.lifetime:
                    self.release(i)
                else:
                    slot.previous_body = slot.body
                    slot.previous = slot.body.position
                    if slot.blocked_timer>0.0:
                        slot.blocked_timer = max_f32(0.0,slot.blocked_timer-h)
                    elif slot.body.sleeping==0:
                        slot.body = particle_body_integrate(slot.body,gravity,h)
                        slot.contact_due = 1
                    else:
                        slot.support_timer += h
                        if slot.support_timer>=0.25:
                            slot.support_timer = 0.0
                            slot.contact_due = 1
            i += 1
        self.accumulator -= h
        self.frame_steps += 1
        return 1

    fun resolve_contact(self, index: i32, contact: ParticleContact3D):
        slot: MeshParticleSlot3D = self.slot(index)
        if (slot as i64)==0 or slot.active==0 or slot.contact_due==0:
            return
        slot.contact_due = 0
        body: ParticleBody3D = slot.body
        if body.sleeping!=0:
            if contact.status==0:
                body.sleeping = 0
                body.quiet_time = 0.0
            elif contact.status==1 and body.position.distance_sq(contact.position)>0.0001:
                body.position = contact.position
                body.sleeping = 0
                body.quiet_time = 0.0
        elif contact.status==1:
            body = particle_body_contact(body,contact,self.restitution,self.friction,1.0/120.0)
            # At a multi-face support the supplied conservative solver may
            # constrain actual translation while leaving a tiny tangential
            # velocity. Sleep stable resolved poses too, not that jitter forever.
            if body.position.distance_sq(slot.previous)<0.000000111 and body.velocity.length_sq()<0.25:
                slot.contact_rest_time += 1.0/120.0
                if slot.contact_rest_time>=0.25:
                    body.sleeping = 1
                    body.velocity = Vec3.zero()
                    body.spin = Vec3.zero()
            else:
                slot.contact_rest_time = 0.0
        elif contact.status==2:
            body = slot.previous_body
            slot.blocked_timer = 0.25
        else:
            body.quiet_time = 0.0
            slot.contact_rest_time = 0.0
        slot.body = body

    # Application supplies the world/body frame (can follow a rotating planet).
    fun draw_slot(self, index: i32, frame: Mat4, visible: i32):
        slot: MeshParticleSlot3D = self.slot(index)
        if (slot as i64)==0 or slot.instance<0:
            return
        if slot.active==0:
            visible = 0
        Engine.set_instance_visible(slot.instance,visible)
        if visible==0:
            return
        size: f32 = slot.size
        if slot.lifetime>0.0:
            size *= clamp((slot.lifetime-slot.age)/0.12,0.0,1.0)
        r: Vec3 = slot.body.rotation
        model: Mat4 = frame.mul(Mat4.trs(0.0,0.0,0.0,r.x,r.y,r.z,size,size,size))
        model.write_to_ptr(self.matrix)
        Engine.set_model_matrix_raw(slot.instance,self.matrix)

    fun render_position(self, index: i32) -> Vec3:
        slot: MeshParticleSlot3D = self.slot(index)
        if (slot as i64)==0:
            return Vec3.zero()
        alpha: f32 = clamp(self.accumulator*120.0,0.0,1.0)
        return slot.previous.scale(1.0-alpha).add(slot.body.position.scale(alpha))

    fun destroy(self):
        i: i32 = 0
        while i<self.capacity:
            slot: MeshParticleSlot3D = self.slot(i)
            if (slot as i64)!=0:
                if slot.instance>=0:
                    Engine.set_instance_visible(slot.instance,0)
                Memory.free(slot as i64)
            i += 1
        if self.slots!=0:
            Memory.free(self.slots)
        if self.matrix!=0:
            Memory.free(self.matrix)
        self.slots = 0
        self.matrix = 0
        self.capacity = 0
        self.count = 0
        self.render_capacity = 0
