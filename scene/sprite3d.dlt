##############################
# Kobic - Sprite3D
# A textured billboard quad placed in world space. Faces the camera every
# frame (full or Y-axis/cylindrical billboarding), or stays fixed. Reuses the
# engine's GPU-driven instanced draw path (bindless texture + model matrix)
# with ZERO new Vulkan code: the billboard orientation is baked into the
# per-instance model matrix via Engine.set_model_matrix_raw each frame.
#
# Typical uses: particles, distant trees/foliage, icons, health bars,
# impostors. Sprites are unlit by default (no shadow cast/receive) so they
# read as flat image cards; opt into lighting via material if desired.
##############################

# Billboard modes.
imm SPRITE3D_BILLBOARD_FULL: i32 = 0     # faces camera fully (spherical)
imm SPRITE3D_BILLBOARD_Y: i32 = 1        # cylindrical: yaws to camera, stays upright
imm SPRITE3D_BILLBOARD_NONE: i32 = 2     # fixed orientation (uses rot_*)

struct Sprite3DBillboard:
    _placeholder: i32 = 0

attach Sprite3DBillboard:

    static fun full() -> i32:
        return SPRITE3D_BILLBOARD_FULL

    static fun upright() -> i32:
        return SPRITE3D_BILLBOARD_Y

    static fun none() -> i32:
        return SPRITE3D_BILLBOARD_NONE

@heap struct Sprite3D extends Node3D:
    static billboard: Sprite3DBillboard = Sprite3DBillboard()
    material: Material3D = Material3D()
    width: f32 = 1.0
    height: f32 = 1.0
    billboard_mode: i32 = 0
    # Local pivot offset in sprite space (-0.5..0.5). 0 = centered.
    pivot_x: f32 = 0.0
    pivot_y: f32 = 0.0
    # Scratch 64-byte model matrix (host buffer reused each frame).
    matrix_buf: i64 = 0
    ready: i32 = 0

fun sprite3d_create(name: str) -> Sprite3D:
    node: Sprite3D = Sprite3D()
    node.id = -1
    node.name = name
    node.active = 1
    node.kind = 3
    node.parent_ptr = 0
    node.first_child_ptr = 0
    node.next_sibling_ptr = 0
    node.mesh_id = -1
    node.pos_x = 0.0
    node.pos_y = 0.0
    node.pos_z = 0.0
    node.rot_x = 0.0
    node.rot_y = 0.0
    node.rot_z = 0.0
    node.scale_x = 1.0
    node.scale_y = 1.0
    node.scale_z = 1.0
    node.texture_id = -1
    node.cast_shadows = 0
    node.receive_shadows = 0
    node.visible = 1
    node.material = Material3D.create()
    node.material.unlit = 1
    # Sprites are cutout by default: transparent texels in the image are
    # discarded so the card shows the image shape (not an opaque square).
    node.material.alpha_clip = 1
    node.width = 1.0
    node.height = 1.0
    node.billboard_mode = SPRITE3D_BILLBOARD_FULL
    node.pivot_x = 0.0
    node.pivot_y = 0.0
    node.matrix_buf = 0
    node.ready = 0
    return node

attach Sprite3D:

    static fun create() -> Sprite3D:
        return sprite3d_create("Sprite3D")

    static fun create(name: str) -> Sprite3D:
        return sprite3d_create(name)

    fun position(self, x: f32, y: f32, z: f32) -> Sprite3D:
        self.pos_x = x
        self.pos_y = y
        self.pos_z = z
        return self

    # World-space size of the quad (width x height). Height defaults to width.
    fun set_size(self, w: f32, h: f32) -> Sprite3D:
        if w > 0.0:
            self.width = w
        if h > 0.0:
            self.height = h
        return self

    fun set_scale(self, s: f32) -> Sprite3D:
        if s > 0.0:
            self.width = s
            self.height = s
        return self

    fun set_billboard(self, mode: i32) -> Sprite3D:
        m: i32 = mode
        if m < 0:
            m = 0
        if m > 2:
            m = 0
        self.billboard_mode = m
        return self

    # Pivot in normalized sprite space: (0,0) = centered, (0,-0.5) = anchored
    # at the bottom (good for characters/trees standing on the ground).
    fun set_pivot(self, px: f32, py: f32) -> Sprite3D:
        self.pivot_x = px
        self.pivot_y = py
        return self

    fun anchor_bottom(self) -> Sprite3D:
        self.pivot_x = 0.0
        self.pivot_y = 0.5
        return self

    fun set_material(self, material: Material3D) -> Sprite3D:
        self.material = material
        return self

    # Toggle alpha cutout (on by default). Off = the full quad draws opaque
    # (useful for fully-opaque sprite sheets where every texel is solid).
    fun set_alpha_clip(self, enabled: i32) -> Sprite3D:
        self.material.set_alpha_clip(enabled)
        if self.mesh_id >= 0:
            Engine.bind_material(self.mesh_id, self.material)
        return self

    # Soft transparency (alpha blending): the sprite is drawn in the blended
    # transparent pass (src-over, depth-write off) so semi-transparent texels
    # and soft/glow edges blend smoothly over the scene. Turns OFF alpha_clip
    # (the two are different modes: clip = hard cutout, transparent = soft
    # blend). Best for glow, smoke, soft particles, fades.
    fun set_transparent(self, enabled: i32) -> Sprite3D:
        if enabled == 0:
            self.material.set_transparent(0)
        else:
            self.material.set_transparent(1)
            self.material.set_alpha_clip(0)
        if self.mesh_id >= 0:
            Engine.bind_material(self.mesh_id, self.material)
        return self

    # Color tint multiplied over the texture (RGBA). Reuses the material color,
    # which the shader multiplies with the sampled albedo.
    fun set_tint(self, color: Color) -> Sprite3D:
        self.material.set_color(color)
        if self.mesh_id >= 0:
            Engine.bind_material(self.mesh_id, self.material)
        return self

    # --- Sprite-sheet / atlas support -----------------------------------
    # Select a normalized sub-rectangle of the texture (u,v in 0..1, w,h are
    # the fractional size). Maps the quad's 0..1 UVs onto [u,u+w]x[v,v+h].
    # Uses the engine's per-instance uv transform (uv*scale + offset), so it's
    # free — no extra draw state. Combine with a grid via set_cell().
    fun set_region(self, u: f32, v: f32, w: f32, h: f32) -> Sprite3D:
        self.material.set_uv_scale(w, h)
        self.material.set_uv_offset(u, v)
        if self.mesh_id >= 0:
            Engine.bind_material(self.mesh_id, self.material)
        return self

    # Pick cell (col,row) from a uniform grid of `cols` x `rows` frames — the
    # common sprite-sheet animation case. Frame index math stays in game code.
    fun set_cell(self, col: i32, row: i32, cols: i32, rows: i32) -> Sprite3D:
        gc: i32 = cols
        gr: i32 = rows
        if gc < 1:
            gc = 1
        if gr < 1:
            gr = 1
        fw: f32 = 1.0 / (gc as f32)
        fh: f32 = 1.0 / (gr as f32)
        return self.set_region((col as f32) * fw, (row as f32) * fh, fw, fh)

    # Flip the sprite horizontally / vertically by negating the UV scale and
    # shifting the offset so the same sub-rect is mirrored in place.
    fun set_flip(self, flip_h: i32, flip_v: i32) -> Sprite3D:
        sx: f32 = self.material.uv_scale_x
        sy: f32 = self.material.uv_scale_y
        ox: f32 = self.material.uv_offset_x
        oy: f32 = self.material.uv_offset_y
        # Normalize to positive scale first (idempotent flips).
        if sx < 0.0:
            ox = ox + sx
            sx = 0.0 - sx
        if sy < 0.0:
            oy = oy + sy
            sy = 0.0 - sy
        if flip_h != 0:
            ox = ox + sx
            sx = 0.0 - sx
        if flip_v != 0:
            oy = oy + sy
            sy = 0.0 - sy
        self.material.set_uv_scale(sx, sy)
        self.material.set_uv_offset(ox, oy)
        if self.mesh_id >= 0:
            Engine.bind_material(self.mesh_id, self.material)
        return self

    fun set_texture(self, texture: Texture2D) -> Sprite3D:
        self.material.set_albedo_texture(texture)
        return self

    fun set_visible(self, on: i32) -> Sprite3D:
        if on == 0:
            self.visible = 0
        else:
            self.visible = 1
        if self.mesh_id >= 0:
            Engine.set_instance_visible(self.mesh_id, self.visible)
        return self

    fun set_lit(self, lit: i32) -> Sprite3D:
        if lit == 0:
            self.material.unlit = 1
            self.cast_shadows = 0
            self.receive_shadows = 0
        else:
            self.material.unlit = 0
        return self

    # Upload the sprite quad + register an instance. Idempotent.
    fun build(self) -> Sprite3D:
        if self.ready == 1:
            return self
        if self.matrix_buf == 0:
            self.matrix_buf = Memory.malloc_zeroed(64)
        source_mesh: i32 = Engine._shared_sprite_quad_mesh()
        if source_mesh < 0:
            return self
        instance_id: i32 = Engine.register_instance(source_mesh)
        if instance_id < 0:
            return self
        # Hide the source; only the registered instance draws.
        Engine.set_instance_visible(source_mesh, 0)
        self.mesh_id = instance_id
        tex_id: i32 = -1
        if self.material.has_albedo == 1:
            tex_id = self.material.albedo.texture_id
        Engine.bind_texture(self.mesh_id, tex_id)
        Engine.bind_material(self.mesh_id, self.material)
        # Sprites don't participate in the shadow pass by default (flat cards).
        Engine.set_shadow_flags(self.mesh_id, self.cast_shadows, self.receive_shadows)
        Engine.set_instance_visible(self.mesh_id, self.visible)
        self.ready = 1
        return self

    # Build the billboard model matrix (column-major, 64 bytes) into matrix_buf
    # and push it to the engine instance. Columns 0/1/2 are the sprite's local
    # X (right), Y (up), Z (normal) axes scaled by size; column 3 is world pos
    # (shifted by the pivot). The basis comes from the camera orientation so
    # the quad faces the viewer.
    fun _write_billboard_matrix(self, cam: Camera3D) -> Sprite3D:
        if self.matrix_buf == 0:
            self.matrix_buf = Memory.malloc_zeroed(64)
        if self.matrix_buf == 0:
            return self

        pi: f32 = 3.14159265
        pitch: f32 = cam.rot_x * pi / 180.0
        yaw: f32 = cam.rot_y * pi / 180.0
        cp: f32 = @cos(pitch)
        sp: f32 = @sin(pitch)
        cy: f32 = @cos(yaw)
        sy: f32 = @sin(yaw)

        # Camera forward (matches gpu_camera_view_into convention).
        fwd_x: f32 = (0.0 - sy) * cp
        fwd_y: f32 = sp
        fwd_z: f32 = (0.0 - cy) * cp

        # Right / up axes for the billboard.
        right_x: f32 = 0.0
        right_y: f32 = 0.0
        right_z: f32 = 0.0
        up_x: f32 = 0.0
        up_y: f32 = 0.0
        up_z: f32 = 0.0
        # Sprite normal faces the camera (opposite of camera forward).
        nrm_x: f32 = 0.0 - fwd_x
        nrm_y: f32 = 0.0 - fwd_y
        nrm_z: f32 = 0.0 - fwd_z

        if self.billboard_mode == SPRITE3D_BILLBOARD_Y:
            # Cylindrical: keep world up, yaw the quad to face the camera.
            up_x = 0.0
            up_y = 1.0
            up_z = 0.0
            # right = normalize(cross(up, camera_forward_horizontal))
            fhx: f32 = fwd_x
            fhz: f32 = fwd_z
            fh_len: f32 = @sqrt(fhx * fhx + fhz * fhz)
            if fh_len < 0.0001:
                fhx = 0.0
                fhz = 0.0 - 1.0
                fh_len = 1.0
            fhx = fhx / fh_len
            fhz = fhz / fh_len
            # right = cross(up, forward_horizontal) with up=(0,1,0)
            right_x = 0.0 - fhz
            right_y = 0.0
            right_z = fhx
            nrm_x = 0.0 - fhx
            nrm_y = 0.0
            nrm_z = 0.0 - fhz
        else:
            if self.billboard_mode == SPRITE3D_BILLBOARD_NONE:
                # Fixed orientation from rot_* (yaw/pitch), no camera facing.
                srx: f32 = self.rot_x * pi / 180.0
                sry: f32 = self.rot_y * pi / 180.0
                scx: f32 = @cos(srx)
                ssx: f32 = @sin(srx)
                scy: f32 = @cos(sry)
                ssy: f32 = @sin(sry)
                right_x = scy
                right_y = 0.0
                right_z = 0.0 - ssy
                up_x = ssy * ssx
                up_y = scx
                up_z = scy * ssx
                nrm_x = ssy * scx
                nrm_y = 0.0 - ssx
                nrm_z = scy * scx
            else:
                # Full spherical billboard: right = cross(world_up, normal).
                # normal already = -camera_forward.
                wux: f32 = 0.0
                wuy: f32 = 1.0
                wuz: f32 = 0.0
                right_x = wuy * nrm_z - wuz * nrm_y
                right_y = wuz * nrm_x - wux * nrm_z
                right_z = wux * nrm_y - wuy * nrm_x
                r_len: f32 = @sqrt(right_x * right_x + right_y * right_y + right_z * right_z)
                if r_len < 0.0001:
                    right_x = 1.0
                    right_y = 0.0
                    right_z = 0.0
                    r_len = 1.0
                right_x = right_x / r_len
                right_y = right_y / r_len
                right_z = right_z / r_len
                # up = cross(normal, right)
                up_x = nrm_y * right_z - nrm_z * right_y
                up_y = nrm_z * right_x - nrm_x * right_z
                up_z = nrm_x * right_y - nrm_y * right_x

        hw: f32 = self.width
        hh: f32 = self.height

        # Pivot shift: move the quad so the chosen pivot sits at pos.
        ox: f32 = (0.0 - self.pivot_x) * self.width
        oy: f32 = (0.0 - self.pivot_y) * self.height
        world_x: f32 = self.pos_x + right_x * ox + up_x * oy
        world_y: f32 = self.pos_y + right_y * ox + up_y * oy
        world_z: f32 = self.pos_z + right_z * ox + up_z * oy

        m: i64 = self.matrix_buf
        # Column 0 = right * width
        Memory.write_f32(m + 0, right_x * hw)
        Memory.write_f32(m + 4, right_y * hw)
        Memory.write_f32(m + 8, right_z * hw)
        Memory.write_f32(m + 12, 0.0)
        # Column 1 = up * height
        Memory.write_f32(m + 16, up_x * hh)
        Memory.write_f32(m + 20, up_y * hh)
        Memory.write_f32(m + 24, up_z * hh)
        Memory.write_f32(m + 28, 0.0)
        # Column 2 = normal
        Memory.write_f32(m + 32, nrm_x)
        Memory.write_f32(m + 36, nrm_y)
        Memory.write_f32(m + 40, nrm_z)
        Memory.write_f32(m + 44, 0.0)
        # Column 3 = world position
        Memory.write_f32(m + 48, world_x)
        Memory.write_f32(m + 52, world_y)
        Memory.write_f32(m + 56, world_z)
        Memory.write_f32(m + 60, 1.0)
        return self

    # Per-frame update: recompute the billboard matrix and push it. Call each
    # frame with the active camera (cheap: a handful of trig + a matrix write).
    fun update_billboard(self, cam: Camera3D) -> Sprite3D:
        if self.ready == 0:
            self.build()
        if self.mesh_id < 0:
            return self
        if (cam as i64) == 0:
            return self
        if self.billboard_mode == SPRITE3D_BILLBOARD_NONE:
            # Fixed sprites only need their matrix once (pos/size stable), but
            # recompute cheaply to honor runtime pos/size changes.
            self._write_billboard_matrix(cam)
        else:
            self._write_billboard_matrix(cam)
        Engine.set_model_matrix_raw(self.mesh_id, self.matrix_buf)
        return self

    fun destroy(self):
        if self.matrix_buf != 0:
            Memory.free(self.matrix_buf)
            self.matrix_buf = 0
        self.ready = 0

attach Node3D:

    fun add_child(self, child: Sprite3D):
        if (child as i64) == 0:
            return
        child.parent_ptr = self as i64
        child.next_sibling_ptr = self.first_child_ptr
        self.first_child_ptr = child as i64

attach Scene:

    fun add_child(self, child: Sprite3D):
        root: RootNode = self.root()
        if (child as i64) == 0:
            return
        child.build()
        child.parent_ptr = root as i64
        child.next_sibling_ptr = root.first_child_ptr
        root.first_child_ptr = child as i64
        if self.active_camera_ptr == 0:
            self.resolve_camera()
