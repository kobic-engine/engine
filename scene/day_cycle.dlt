##############################
# Kobic - Optional Day Cycle
# Explicit scene-owned animation for a sun, sky, stars, and fog.
##############################

@heap struct DayCycle:
    elapsed: f32 = 0.0
    duration: f32 = 120.0
    sun_ptr: i64 = 0
    moon_ptr: i64 = 0
    sun_path_depth: f32 = 0.32
    day_sun_intensity: f32 = 1.05
    day_ambient: f32 = 0.42
    night_moon_intensity: f32 = 0.22
    night_ambient: f32 = 0.13
    twilight_ambient: f32 = 0.04
    darkest_ambient: f32 = 0.02
    warm_sun_color: Color = Color()
    noon_sun_color: Color = Color()
    moon_color: Color = Color()
    night_zenith_color: Color = Color()
    day_zenith_color: Color = Color()
    night_horizon_color: Color = Color()
    day_horizon_color: Color = Color()
    night_lower_color: Color = Color()
    day_lower_color: Color = Color()
    sunset_horizon_color: Color = Color()
    sunset_lower_color: Color = Color()
    sun_visual_size: f32 = 0.045
    sun_visual_glow: f32 = 0.78
    sun_visual_softness: f32 = 0.85
    moon_visual_size: f32 = 0.032
    moon_visual_glow: f32 = 0.24
    moon_visual_softness: f32 = 0.70
    running: i32 = 1
    update_sky: i32 = 1
    update_light: i32 = 1
    update_fog: i32 = 1

fun day_cycle_color_lerp(a: Color, b: Color, t: f32) -> Color:
    amount: f32 = clamp(t, 0.0, 1.0)
    return Color.rgb(
        lerp(a.r, b.r, amount),
        lerp(a.g, b.g, amount),
        lerp(a.b, b.b, amount)
    )

fun day_cycle_abs(value: f32) -> f32:
    if value < 0.0:
        return 0.0 - value
    return value

fun day_cycle_smooth01(value: f32) -> f32:
    t: f32 = clamp(value, 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)

attach DayCycle:

    static fun create() -> DayCycle:
        cycle: DayCycle = DayCycle()
        cycle.warm_sun_color = Color.rgb(1.0, 0.55, 0.34)
        cycle.noon_sun_color = Color.rgb(1.0, 0.94, 0.82)
        cycle.moon_color = Color.rgb(0.48, 0.58, 0.82)
        cycle.night_zenith_color = Color.rgb(0.015, 0.025, 0.080)
        cycle.day_zenith_color = Color.rgb(0.42, 0.57, 0.82)
        cycle.night_horizon_color = Color.rgb(0.045, 0.060, 0.120)
        cycle.day_horizon_color = Color.rgb(0.70, 0.79, 0.92)
        cycle.night_lower_color = Color.rgb(0.025, 0.035, 0.070)
        cycle.day_lower_color = Color.rgb(0.78, 0.84, 0.94)
        cycle.sunset_horizon_color = Color.rgb(0.96, 0.34, 0.16)
        cycle.sunset_lower_color = Color.rgb(0.72, 0.18, 0.10)
        return cycle

    static fun create(sun: DirectionalLight3D) -> DayCycle:
        cycle: DayCycle = DayCycle.create()
        cycle.sun_ptr = sun as i64
        return cycle

    static fun create(sun: DirectionalLight3D, moon: DirectionalLight3D) -> DayCycle:
        cycle: DayCycle = DayCycle.create(sun)
        cycle.moon_ptr = moon as i64
        return cycle

    fun set_sun(self, sun: DirectionalLight3D) -> DayCycle:
        self.sun_ptr = sun as i64
        return self

    fun set_moon(self, moon: DirectionalLight3D) -> DayCycle:
        self.moon_ptr = moon as i64
        return self

    fun set_duration(self, seconds: f32) -> DayCycle:
        if seconds < 0.1:
            self.duration = 0.1
        else:
            self.duration = seconds
        return self

    fun set_time(self, normalized_time: f32) -> DayCycle:
        phase: f32 = normalized_time
        while phase < 0.0:
            phase = phase + 1.0
        while phase >= 1.0:
            phase = phase - 1.0
        self.elapsed = phase * self.duration
        return self

    fun time(self) -> f32:
        if self.duration <= 0.0:
            return 0.0
        return self.elapsed / self.duration

    fun active_light(self) -> DirectionalLight3D:
        if self.sun_ptr == 0:
            if self.moon_ptr != 0:
                return self.moon_ptr as DirectionalLight3D
            return self.sun_ptr as DirectionalLight3D
        sun: DirectionalLight3D = self.sun_ptr as DirectionalLight3D
        if self.moon_ptr != 0:
            moon: DirectionalLight3D = self.moon_ptr as DirectionalLight3D
            if moon.intensity > sun.intensity:
                return moon
        return sun

    fun set_sun_path_depth(self, depth: f32) -> DayCycle:
        self.sun_path_depth = clamp(depth, 0.0 - 1.0, 1.0)
        return self

    # Light energy is profile data, not a hard-coded property of time.
    # This lets a game keep a crisp, inexpensive Vanilla look and switch to
    # an HDR/shadow profile without fighting values rewritten every frame.
    fun set_day_light(self, sun_intensity: f32, ambient: f32) -> DayCycle:
        self.day_sun_intensity = clamp(sun_intensity, 0.0, 8.0)
        self.day_ambient = clamp(ambient, 0.0, 4.0)
        return self

    fun set_night_light(self, moon_intensity: f32, ambient: f32) -> DayCycle:
        self.night_moon_intensity = clamp(moon_intensity, 0.0, 8.0)
        self.night_ambient = clamp(ambient, 0.0, 4.0)
        return self

    fun set_dark_ambient(self, twilight: f32, darkest: f32) -> DayCycle:
        self.twilight_ambient = clamp(twilight, 0.0, 4.0)
        self.darkest_ambient = clamp(darkest, 0.0, 4.0)
        return self

    fun set_sun_colors(self, warm: Color, noon: Color) -> DayCycle:
        self.warm_sun_color = warm
        self.noon_sun_color = noon
        return self

    fun set_moon_color(self, color: Color) -> DayCycle:
        self.moon_color = color
        return self

    fun set_day_sky(self, zenith: Color, horizon: Color, lower: Color) -> DayCycle:
        self.day_zenith_color = zenith
        self.day_horizon_color = horizon
        self.day_lower_color = lower
        return self

    fun set_night_sky(self, zenith: Color, horizon: Color, lower: Color) -> DayCycle:
        self.night_zenith_color = zenith
        self.night_horizon_color = horizon
        self.night_lower_color = lower
        return self

    fun set_sunset_sky(self, horizon: Color, lower: Color) -> DayCycle:
        self.sunset_horizon_color = horizon
        self.sunset_lower_color = lower
        return self

    fun set_sun_visual(self, size: f32, glow: f32, softness: f32) -> DayCycle:
        self.sun_visual_size = clamp(size, 0.005, 0.20)
        self.sun_visual_glow = clamp(glow, 0.0, 1.0)
        self.sun_visual_softness = clamp(softness, 0.0, 1.0)
        return self

    fun set_moon_visual(self, size: f32, glow: f32, softness: f32) -> DayCycle:
        self.moon_visual_size = clamp(size, 0.005, 0.20)
        self.moon_visual_glow = clamp(glow, 0.0, 1.0)
        self.moon_visual_softness = clamp(softness, 0.0, 1.0)
        return self

    fun control_sky(self, enabled: i32) -> DayCycle:
        if enabled == 0:
            self.update_sky = 0
        else:
            self.update_sky = 1
        return self

    fun control_light(self, enabled: i32) -> DayCycle:
        if enabled == 0:
            self.update_light = 0
        else:
            self.update_light = 1
        return self

    fun control_fog(self, enabled: i32) -> DayCycle:
        if enabled == 0:
            self.update_fog = 0
        else:
            self.update_fog = 1
        return self

    fun play(self):
        self.running = 1

    fun pause(self):
        self.running = 0

    fun update_environment(self, env: Environment, dt: f32) -> Environment:
        if self.sun_ptr == 0:
            return env
        if self.duration <= 0.0:
            return env

        if self.running == 1:
            self.elapsed = self.elapsed + dt
            while self.elapsed >= self.duration:
                self.elapsed = self.elapsed - self.duration
            while self.elapsed < 0.0:
                self.elapsed = self.elapsed + self.duration

        phase: f32 = self.elapsed / self.duration
        angle: f32 = phase * 6.28318530 - 1.57079632
        sun_x: f32 = @cos(angle)
        sun_y: f32 = @sin(angle)

        sun: DirectionalLight3D = self.sun_ptr as DirectionalLight3D
        sun.set_direction(0.0 - sun_x, 0.0 - sun_y, 0.0 - self.sun_path_depth)
        moonlight: f32 = day_cycle_smooth01(((0.0 - sun_y) - 0.08) / 0.38)
        if self.moon_ptr != 0:
            moon: DirectionalLight3D = self.moon_ptr as DirectionalLight3D
            moon.set_direction(sun_x, sun_y, 0.0 - self.sun_path_depth)

        # Sky and ambient light can carry through twilight, but direct rays
        # must stop at the horizon. Otherwise the sun shines upward once its
        # visual position moves below the world and produces inverted shadows.
        daylight: f32 = day_cycle_smooth01((sun_y + 0.12) / 0.32)
        direct_sunlight: f32 = day_cycle_smooth01(sun_y / 0.12)
        high_sun: f32 = day_cycle_smooth01(sun_y * 1.45)
        horizon_proximity: f32 = day_cycle_smooth01(1.0 - day_cycle_abs(sun_y) * 4.5)
        twilight: f32 = horizon_proximity * day_cycle_smooth01((sun_y + 0.16) / 0.16)

        sun_color: Color = day_cycle_color_lerp(self.warm_sun_color, self.noon_sun_color, high_sun)
        moon_color: Color = self.moon_color

        if self.update_light == 1:
            sun.set_color(sun_color)
            sun.set_intensity(lerp(0.0, self.day_sun_intensity, direct_sunlight))
            sun.set_ambient(lerp(self.twilight_ambient, self.day_ambient, daylight))
            if self.moon_ptr != 0:
                moon_light: DirectionalLight3D = self.moon_ptr as DirectionalLight3D
                moon_light.set_color(moon_color)
                moon_light.set_intensity(lerp(0.0, self.night_moon_intensity, moonlight))
                moon_light.set_ambient(lerp(self.darkest_ambient, self.night_ambient, moonlight))

        if self.update_sky == 1:
            sky: Sky = env.sky
            sky.ensure_light_object(sun, "DaySkyObject", sun_color, self.sun_visual_size, self.sun_visual_glow, self.sun_visual_softness)
            if self.moon_ptr != 0:
                moon_sky: DirectionalLight3D = self.moon_ptr as DirectionalLight3D
                sky.ensure_light_object(moon_sky, "NightSkyObject", moon_color, self.moon_visual_size, self.moon_visual_glow, self.moon_visual_softness)

            zenith: Color = day_cycle_color_lerp(self.night_zenith_color, self.day_zenith_color, daylight)
            horizon: Color = day_cycle_color_lerp(self.night_horizon_color, self.day_horizon_color, daylight)
            lower: Color = day_cycle_color_lerp(self.night_lower_color, self.day_lower_color, daylight)
            horizon = day_cycle_color_lerp(horizon, self.sunset_horizon_color, twilight * 0.82)
            lower = day_cycle_color_lerp(lower, self.sunset_lower_color, twilight * 0.60)

            sky.set_zenith(zenith)
            sky.set_horizon(horizon)
            sky.set_lower(lower)
            sky.set_object_color_by_light(sun, sun_color)
            if self.moon_ptr != 0:
                moon_color_target: DirectionalLight3D = self.moon_ptr as DirectionalLight3D
                sky.set_object_color_by_light(moon_color_target, moon_color)
            sky.set_stars_object(1.0 - daylight, 110, Color.rgb(0.86, 0.89, 0.95))
            sky.update_clouds(dt, daylight)
            env.set_sky(sky)

        if self.update_fog == 1:
            fog: Fog = env.fog
            fog.color = env.sky.fog_color()
            env.set_fog(fog)

        return env

    fun destroy(self):
        Memory.free(self as i64)

attach Scene:

    fun set_day_cycle(self, cycle: DayCycle):
        new_ptr: i64 = cycle as i64
        if self.day_cycle_ptr != 0:
            if self.day_cycle_ptr != new_ptr:
                old_cycle: DayCycle = self.day_cycle_ptr as DayCycle
                old_cycle.destroy()
        self.day_cycle_ptr = new_ptr

    fun has_day_cycle(self) -> i32:
        if self.day_cycle_ptr == 0:
            return 0
        return 1

    fun day_cycle(self) -> DayCycle:
        return self.day_cycle_ptr as DayCycle

    fun clear_day_cycle(self):
        if self.day_cycle_ptr != 0:
            cycle: DayCycle = self.day_cycle_ptr as DayCycle
            cycle.destroy()
            self.day_cycle_ptr = 0

    fun update_day_cycle(self, dt: f32):
        if self.day_cycle_ptr == 0:
            return
        cycle: DayCycle = self.day_cycle_ptr as DayCycle
        self.env = cycle.update_environment(self.environment(), dt)
        light: DirectionalLight3D = cycle.active_light()
        if (light as i64) != 0:
            self.directional_light_ptr = light as i64
        self.env_initialized = 1
