##############################
# Kobic - Material3D
# High-level material descriptor for renderable 3D nodes.
##############################

struct Material3D:
    color: Color = Color()
    albedo: Texture2D = Texture2D()
    normal_map: Texture2D = Texture2D()
    metallic_roughness_map: Texture2D = Texture2D()
    occlusion_map: Texture2D = Texture2D()
    emissive_map: Texture2D = Texture2D()
    shader: Shader = Shader()
    emissive: Color = Color()
    has_albedo: i32 = 0
    has_normal_map: i32 = 0
    has_metallic_roughness_map: i32 = 0
    has_occlusion_map: i32 = 0
    has_emissive_map: i32 = 0
    has_shader: i32 = 0
    metallic: f32 = 0.0
    roughness: f32 = 1.0
    emissive_strength: f32 = 0.0
    alpha: f32 = 1.0
    unlit: i32 = 0
    # Optional authored scalar illumination: -1 keeps ordinary scene lighting.
    # Non-negative values multiply albedo uniformly, independent of normals,
    # directional lights and shadow maps. Point lights still add soft fill.
    uniform_light: f32 = -1.0
    # Camera-attached arms/weapons: independent 2cm near clip + foreground
    # depth band. Keep the scene camera's planetary depth range unchanged.
    viewmodel: i32 = 0
    # Preserve Kobic's historical two-sided rendering by default. Materials
    # that explicitly opt out can reject back-facing fragments without
    # changing the global pipeline used by legacy meshes.
    double_sided: i32 = 1
    # Alpha cutout: when 1, fragments with texture alpha below ~0.5 are
    # discarded in the shader (clean transparent edges, depth-correct, no
    # blend/ordering needed — ideal for foliage, icons, and sprite cards).
    alpha_clip: i32 = 0
    # Transparent: when 1, the mesh is drawn in the transparent pass with alpha
    # blending (src-over) and depth-write off — for soft-edged/semi-transparent
    # images (glow, smoke, soft sprites). Costs a second draw pass; ordering is
    # approximate. Prefer alpha_clip for hard-edged cutouts.
    transparent: i32 = 0
    # World-consistent atlas sampling repeats one padded tile per world unit,
    # independent of greedy-mesh or LOD patch size.
    world_pixel_sampling: i32 = 0
    uv_scale_x: f32 = 1.0
    uv_scale_y: f32 = 1.0
    uv_offset_x: f32 = 0.0
    uv_offset_y: f32 = 0.0

@heap struct ModelMaterialEntry:
    name: str = ""
    material_index: i32 = -1
    material: Material3D = Material3D()

struct ModelMaterials:
    entries: i64 = 0
    count: i32 = 0
    capacity: i32 = 0

attach Material3D:

    static fun create() -> Material3D:
        mat: Material3D = Material3D()
        mat.color = Color.white()
        mat.alpha = 1.0
        mat.metallic = 0.0
        mat.roughness = 1.0
        mat.emissive = Color.black()
        mat.emissive_strength = 0.0
        mat.has_emissive_map = 0
        mat.double_sided = 1
        mat.uv_scale_x = 1.0
        mat.uv_scale_y = 1.0
        mat.uv_offset_x = 0.0
        mat.uv_offset_y = 0.0
        return mat

    static fun colored(color: Color) -> Material3D:
        mat: Material3D = Material3D.create()
        return mat.set_color(color)

    static fun textured(texture: Texture2D) -> Material3D:
        mat: Material3D = Material3D.create()
        return mat.set_texture(texture)

    fun set_color(self, color: Color) -> Material3D:
        self.color = color
        self.alpha = color.a
        return self

    fun set_alpha(self, alpha: f32) -> Material3D:
        self.alpha = alpha
        self.color = self.color.with_alpha(alpha)
        return self

    fun set_texture(self, texture: Texture2D) -> Material3D:
        return self.set_albedo(texture)

    fun set_albedo_texture(self, texture: Texture2D) -> Material3D:
        return self.set_albedo(texture)

    fun set_albedo(self, color: Color) -> Material3D:
        return self.set_color(color)

    fun set_albedo(self, texture: Texture2D) -> Material3D:
        self.albedo = texture
        self.has_albedo = 0
        if texture.texture_id >= 0:
            self.has_albedo = 1
        return self

    fun clear_texture(self) -> Material3D:
        self.albedo = Texture2D()
        self.has_albedo = 0
        return self

    fun set_normal_map(self, texture: Texture2D) -> Material3D:
        self.normal_map = texture
        self.has_normal_map = 0
        if texture.texture_id >= 0:
            self.has_normal_map = 1
        return self

    fun set_metallic_roughness_map(self, texture: Texture2D) -> Material3D:
        self.metallic_roughness_map = texture
        self.has_metallic_roughness_map = 0
        if texture.texture_id >= 0:
            self.has_metallic_roughness_map = 1
        return self

    fun set_occlusion_map(self, texture: Texture2D) -> Material3D:
        self.occlusion_map = texture
        self.has_occlusion_map = 0
        if texture.texture_id >= 0:
            self.has_occlusion_map = 1
        return self

    fun set_emissive_map(self, texture: Texture2D) -> Material3D:
        self.emissive_map = texture
        self.has_emissive_map = 0
        if texture.texture_id >= 0:
            self.has_emissive_map = 1
        return self

    fun clear_emissive_map(self) -> Material3D:
        self.emissive_map = Texture2D()
        self.has_emissive_map = 0
        return self

    fun set_shader(self, shader: Shader) -> Material3D:
        self.shader = shader
        self.has_shader = 0
        if shader.found == 1:
            self.has_shader = 1
        return self

    fun set_metallic(self, value: f32) -> Material3D:
        self.metallic = clamp(value, 0.0, 1.0)
        return self

    fun set_roughness(self, value: f32) -> Material3D:
        self.roughness = clamp(value, 0.0, 1.0)
        return self

    fun set_surface(self, metallic: f32, roughness: f32) -> Material3D:
        self.metallic = clamp(metallic, 0.0, 1.0)
        self.roughness = clamp(roughness, 0.0, 1.0)
        return self

    fun set_emissive(self, color: Color) -> Material3D:
        self.emissive = color
        return self

    fun set_emissive(self, color: Color, strength: f32) -> Material3D:
        self.emissive = color
        return self.set_emissive_strength(strength)

    fun set_emissive_strength(self, value: f32) -> Material3D:
        if value < 0.0:
            self.emissive_strength = 0.0
            return self
        self.emissive_strength = value
        return self

    fun set_alpha_clip(self, enabled: i32) -> Material3D:
        if enabled == 0:
            self.alpha_clip = 0
        else:
            self.alpha_clip = 1
        return self

    fun set_transparent(self, enabled: i32) -> Material3D:
        if enabled == 0:
            self.transparent = 0
        else:
            self.transparent = 1
        return self

    fun set_unlit(self, enabled: i32) -> Material3D:
        self.unlit = enabled
        return self

    fun set_uniform_lighting(self, energy: f32) -> Material3D:
        self.uniform_light = clamp(energy, 0.0, 4.0)
        self.unlit = 0
        return self

    fun clear_uniform_lighting(self) -> Material3D:
        self.uniform_light = -1.0
        return self

    fun set_viewmodel(self, enabled: i32) -> Material3D:
        self.viewmodel = 0
        if enabled!=0:
            self.viewmodel = 1
        return self

    fun gpu_emission_parameter(self) -> f32:
        if self.viewmodel!=0:
            return -1.0-max_f32(0.0,self.emissive_strength)
        return self.emissive_strength

    # Keep the existing GPU material/instance ABI. Metallic is unused in the
    # uniform branch, so its otherwise-invalid negative range carries energy.
    # Ordinary PBR/vanilla materials retain their exact original encoding.
    fun gpu_surface_parameter(self) -> f32:
        if self.uniform_light >= 0.0 and self.unlit == 0:
            return -1.0 - clamp(self.uniform_light, 0.0, 4.0)
        return self.metallic

    fun set_double_sided(self, enabled: i32) -> Material3D:
        self.double_sided = enabled
        return self

    # cols/rows describe the atlas grid. padding_ratio is the gutter divided
    # by the full cell size (for a 32 px tile + 4 px gutter: 4 / 40 = 0.1).
    fun set_world_pixel_atlas(self, cols: i32, rows: i32, padding_ratio: f32) -> Material3D:
        self.world_pixel_sampling = 0
        if cols <= 0 or rows <= 0:
            return self
        self.world_pixel_sampling = 1
        self.uv_scale_x = cols as f32
        self.uv_scale_y = rows as f32
        self.uv_offset_x = clamp(padding_ratio, 0.0, 0.49)
        self.uv_offset_y = 0.0
        return self

    fun clear_world_pixel_sampling(self) -> Material3D:
        self.world_pixel_sampling = 0
        self.uv_scale_x = 1.0
        self.uv_scale_y = 1.0
        self.uv_offset_x = 0.0
        self.uv_offset_y = 0.0
        return self

    # Atlas-only interpretation of the otherwise-unused UV offset Y. Reuses
    # the existing instance ABI; ordinary mesh UV offsets are unaffected.
    # One is the legacy one-tile-per-world-unit scale. Invalid input restores it.
    fun set_world_pixel_scale(self, tiles_per_unit: f32) -> Material3D:
        if self.world_pixel_sampling == 0:
            return self
        self.uv_offset_y = 1.0
        if tiles_per_unit > 0.0 and tiles_per_unit <= 16.0:
            self.uv_offset_y = max_f32(0.0625, tiles_per_unit)
        return self

    # Compatibility alias kept for code written against the atlas-only API.
    fun clear_world_pixel_atlas(self) -> Material3D:
        return self.clear_world_pixel_sampling()

    fun set_uv_scale(self, x: f32, y: f32) -> Material3D:
        self.uv_scale_x = x
        self.uv_scale_y = y
        return self

    fun set_uv_offset(self, x: f32, y: f32) -> Material3D:
        self.uv_offset_x = x
        self.uv_offset_y = y
        return self

attach ModelMaterials:

    static fun create() -> ModelMaterials:
        mats: ModelMaterials = ModelMaterials()
        mats.capacity = 16
        mats.count = 0
        mats.entries = Memory.malloc_zeroed((mats.capacity as i64) * 8)
        return mats

    fun _ensure(self) -> ModelMaterials:
        if self.capacity <= 0:
            self.capacity = 16
            self.count = 0
            self.entries = Memory.malloc_zeroed((self.capacity as i64) * 8)
            return self
        if self.entries == 0:
            self.entries = Memory.malloc_zeroed((self.capacity as i64) * 8)
            return self
        if self.count < self.capacity:
            return self
        new_capacity: i32 = self.capacity * 2
        new_entries: i64 = Memory.malloc_zeroed((new_capacity as i64) * 8)
        if new_entries == 0:
            return self
        Memory.copy(new_entries, self.entries, (self.capacity as i64) * 8)
        Memory.free(self.entries)
        self.entries = new_entries
        self.capacity = new_capacity
        return self

    fun _entry_at(self, index: i32) -> ModelMaterialEntry:
        if self.entries == 0:
            return null
        if index < 0:
            return null
        if index >= self.count:
            return null
        ptr: i64 = Memory.read_ptr(self.entries + ((index as i64) * 8))
        return ptr as ModelMaterialEntry

    fun find_name(self, name: str) -> i32:
        if Memory.strlen(name) == 0:
            return -1
        i: i32 = 0
        while i < self.count:
            entry: ModelMaterialEntry = self._entry_at(i)
            if (entry as i64) != 0:
                if Str.equals(entry.name, name):
                    return i
            i = i + 1
        return -1

    fun find_index(self, material_index: i32) -> i32:
        if material_index < 0:
            return -1
        i: i32 = 0
        while i < self.count:
            entry: ModelMaterialEntry = self._entry_at(i)
            if (entry as i64) != 0:
                if entry.material_index == material_index:
                    return i
            i = i + 1
        return -1

    fun set(self, name: str, material: Material3D) -> ModelMaterials:
        if Memory.strlen(name) == 0:
            return self
        existing: i32 = self.find_name(name)
        if existing >= 0:
            entry_existing: ModelMaterialEntry = self._entry_at(existing)
            if (entry_existing as i64) != 0:
                entry_existing.material = material
            return self
        self._ensure()
        if self.entries == 0:
            return self
        if self.count >= self.capacity:
            return self
        entry: ModelMaterialEntry = ModelMaterialEntry()
        entry.name = Str.strcpy(name)
        entry.material_index = -1
        entry.material = material
        Memory.write_ptr(self.entries + ((self.count as i64) * 8), entry as i64)
        self.count = self.count + 1
        return self

    fun set(self, material_index: i32, material: Material3D) -> ModelMaterials:
        if material_index < 0:
            return self
        existing: i32 = self.find_index(material_index)
        if existing >= 0:
            entry_existing: ModelMaterialEntry = self._entry_at(existing)
            if (entry_existing as i64) != 0:
                entry_existing.material = material
            return self
        self._ensure()
        if self.entries == 0:
            return self
        if self.count >= self.capacity:
            return self
        entry: ModelMaterialEntry = ModelMaterialEntry()
        entry.name = ""
        entry.material_index = material_index
        entry.material = material
        Memory.write_ptr(self.entries + ((self.count as i64) * 8), entry as i64)
        self.count = self.count + 1
        return self

    fun resolve(self, name: str, material_index: i32, fallback: Material3D) -> Material3D:
        by_name: i32 = self.find_name(name)
        if by_name >= 0:
            entry_by_name: ModelMaterialEntry = self._entry_at(by_name)
            if (entry_by_name as i64) != 0:
                return entry_by_name.material
        by_index: i32 = self.find_index(material_index)
        if by_index >= 0:
            entry_by_index: ModelMaterialEntry = self._entry_at(by_index)
            if (entry_by_index as i64) != 0:
                return entry_by_index.material
        return fallback

    fun destroy(self):
        if self.entries == 0:
            return
        i: i32 = 0
        while i < self.count:
            entry: ModelMaterialEntry = self._entry_at(i)
            if (entry as i64) != 0:
                if Memory.strlen(entry.name) > 0:
                    Memory.free(entry.name as i64)
                Memory.free(entry as i64)
            i = i + 1
        Memory.free(self.entries)
        self.entries = 0
        self.count = 0
        self.capacity = 0
