    # Select the culling strategy for the main pass:
    #   KOBIC_CULL_MODE_CPU (default), _GPU, or _AUTO.
    fun set_culling_mode(self, mode: i32):
        self.renderer.set_culling_mode(mode)

    fun set_culling_auto_threshold(self, threshold: i32):
        self.renderer.set_culling_auto_threshold(threshold)

