    fun capture_frame(self, path: str) -> i32:
        return self.renderer.capture_frame(path)

    fun render_window_stat(self, stat: i32) -> i64:
        return self.renderer.render_window_stat(stat)

    fun set_shadow_min_size(self, threshold: f32):
        self.renderer.set_shadow_min_size(threshold)

    fun set_shadow_cascade0_margin(self, margin: f32):
