##############################
# Kobic - Engine Runtime
# Owns window, Vulkan state, swapchain, render pass, and renderer.
##############################

@heap struct EngineRuntime:
    app: App = App()
    ctx: VulkanContext = VulkanContext()
    swapchain: Swapchain = Swapchain()
    render_pass: RenderPass = RenderPass()
    renderer: Renderer = Renderer.create()
    cull: GpuCullPipeline = GpuCullPipeline()
    hzb: GpuHzb = GpuHzb()
    temporal: GpuTemporal = GpuTemporal()
    width: i32 = 0
    height: i32 = 0
    ready_flag: i32 = 0
    vsync_enabled: i32 = 1
    present_mode_preference: i32 = -1

attach EngineRuntime:

    static fun create(title: str, width: i32, height: i32) -> EngineRuntime:
        return EngineRuntime.create(title, width, height, 1)

    static fun create(title: str, width: i32, height: i32, vsync: i32) -> EngineRuntime:
        return EngineRuntime.create_with_gpu_preference(title, width, height, vsync, 0)

    static fun create_with_gpu_preference(title: str, width: i32, height: i32, vsync: i32, gpu_preference: i32) -> EngineRuntime:
        return EngineRuntime.create_with_options(title, width, height, vsync, gpu_preference, -1)

    static fun create_with_options(title: str, width: i32, height: i32, vsync: i32, gpu_preference: i32, present_mode: i32) -> EngineRuntime:
        sync: i32 = 1
        if vsync == 0:
            sync = 0
        runtime: EngineRuntime = EngineRuntime(width=width, height=height, ready_flag=0, vsync_enabled=sync, present_mode_preference=present_mode)
        runtime.app = App.create(title, width, height)

        ctx: VulkanContext = VulkanContext()
        if ctx.init_with_gpu_preference(runtime.app.handle(), gpu_preference) == 0:
            print("GPU context init failed")
            runtime.app.shutdown()
            return runtime
        runtime.ctx = ctx

        swapchain: Swapchain = Swapchain()
        if swapchain.init(ctx.vk_instance, ctx.vk_physical_device, ctx.vk_device, ctx.vk_surface, width, height, ctx.graphics_family, ctx.present_family, sync, present_mode) == 0:
            print("GPU swapchain init failed")
            ctx.cleanup()
            runtime.app.shutdown()
            return runtime
        runtime.swapchain = swapchain

        vert_shader: EmbeddedShader = get_textured_vert_shader()
        frag_shader: EmbeddedShader = get_textured_frag_shader()
        shadow_vert_shader: EmbeddedShader = get_shadow_vert_shader()
        sky_vert_shader: EmbeddedShader = get_sky_vert_shader()
        sky_frag_shader: EmbeddedShader = get_sky_frag_shader()
        bloom_frag_shader: EmbeddedShader = get_bloom_frag_shader()
        render_pass: RenderPass = RenderPass()
        if render_pass.init(ctx.vk_device, ctx.vk_physical_device, swapchain.format, swapchain.image_count, swapchain.image_views, swapchain.depth_view, width, height, ctx.graphics_family, vert_shader.data, vert_shader.size, frag_shader.data, frag_shader.size, shadow_vert_shader.data, shadow_vert_shader.size) == 0:
            print("GPU render pass init failed")
            swapchain.cleanup(ctx.vk_instance, ctx.vk_device)
            ctx.cleanup()
            runtime.app.shutdown()
            return runtime
        if kobic_sky_pass_init(ctx.vk_device, render_pass.vk_render_pass, render_pass.desc_set_layout, sky_vert_shader.data, sky_vert_shader.size, sky_frag_shader.data, sky_frag_shader.size) == 0:
            print("GPU sky pass init failed")
            render_pass.cleanup(ctx.vk_device)
            swapchain.cleanup(ctx.vk_instance, ctx.vk_device)
            ctx.cleanup()
            runtime.app.shutdown()
            return runtime
        if kobic_bloom_pass_init(ctx.vk_device, render_pass.vk_present_render_pass, render_pass.desc_set_layout, sky_vert_shader.data, sky_vert_shader.size, bloom_frag_shader.data, bloom_frag_shader.size) == 0:
            print("GPU post-process pass init failed")
            render_pass.cleanup(ctx.vk_device)
            swapchain.cleanup(ctx.vk_instance, ctx.vk_device)
            ctx.cleanup()
            runtime.app.shutdown()
            return runtime
        vert_shader.release()
        frag_shader.release()
        shadow_vert_shader.release()
        sky_vert_shader.release()
        sky_frag_shader.release()
        bloom_frag_shader.release()
        runtime.render_pass = render_pass

        renderer: Renderer = Renderer.create()
        renderer.init(ctx.vk_device, ctx.vk_physical_device, ctx.vk_graphics_queue, ctx.vk_present_queue)
        runtime.renderer = renderer

        temporal: GpuTemporal = GpuTemporal()
        if temporal.init(ctx.vk_device, ctx.vk_physical_device) == 1:
            print("[kobic.post] G-buffer GTAO + TAA pipeline ready")
        else:
            print("[kobic.post] temporal pipeline unavailable (direct HDR fallback)")
        runtime.temporal = temporal

        # Conservative previous-frame depth is initialized before culling so
        # every statically-used cull descriptor is valid from the self-test on.
        hzb: GpuHzb = GpuHzb()
        hzb_ready: i32 = hzb.init(ctx.vk_device, ctx.vk_physical_device)
        if hzb_ready == 1:
            hzb_ready = hzb.ensure_target(width, height, swapchain.depth_view)
        runtime.hzb = hzb

        # GPU-driven culling: create the compute pipeline (Phase 0). This
        # does NOT yet feed the graphics pass — it only proves the compute
        # pipeline + descriptor layout build on the real device. Failure is
        # non-fatal: the engine falls back to CPU culling.
        cull: GpuCullPipeline = GpuCullPipeline()
        if cull.init(ctx.vk_device, ctx.vk_physical_device) == 1:
            if hzb_ready == 1:
                cull.set_hzb_resources(hzb.image_view, hzb.sampler, hzb.state_buffer)
            print("[kobic.cull] GPU culling pipeline ready")
            cull.self_test(render_pass.vk_command_pool, ctx.vk_graphics_queue)
        else:
            print("[kobic.cull] GPU culling pipeline FAILED to init (CPU fallback)")
        runtime.cull = cull
        # NOTE: do NOT bind the cull pointer to the renderer here. `runtime`
        # is a local that gets copied by value into g_engine_runtime on
        # return, which would leave the renderer holding a dangling pointer to
        # this local's `cull`. Engine.start() calls bind_cull() AFTER the
        # final runtime is in place, so gpu_cull_ptr points at the persistent
        # g_engine_runtime.cull.
        runtime.renderer.core.set_culling_mode(KOBIC_CULL_MODE_CPU)

        # Phase 1 (R1): wire the bindless texture table. Feed device support
        # (from the detected GpuCaps) + the engine opt-in flag into the
        # renderer, then create the table objects. This allocates a descriptor
        # set layout/pool/set ONLY — it does NOT change any draw path yet
        # (tasks 1.5/1.6 wire the draw). If the device lacks descriptor
        # indexing or creation fails, bindless_enabled stays 0 -> classic path.
        bcaps: GpuCaps = ctx.caps
        runtime.renderer.core.draw_indirect_count_supported = bcaps.draw_indirect_count
        if bcaps.pipeline_statistics == 1:
            runtime.renderer.core.enable_pipeline_statistics()
        runtime.renderer.core.set_bindless_caps(bcaps.descriptor_indexing, bcaps.max_descriptor_array, g_engine_bindless_flag)
        if runtime.renderer.core._bindless_init() == 1:
            # Build the bindless graphics pipeline variant now that the table
            # layout exists. If it fails, bindless_enabled is cleared so the
            # classic pipeline/draw path stays in effect.
            if render_pass._create_bindless_pipeline(ctx.vk_device, width, height, runtime.renderer.core.bindless_layout) == 1:
                print("[kobic.bindless] pipeline ready")
                # Phase 2: also build the GPU-driven SSBO pipeline (batched
                # indirect-count draw). Non-fatal if it fails — the per-group
                # bindless indirect-count path stays as the fallback.
                render_pass._create_ssbo_pipeline(ctx.vk_device, width, height, runtime.renderer.core.bindless_layout)
                if render_pass.ssbo_pipeline != 0:
                    runtime.renderer.core.ssbo_pipeline_ready = 1
            else:
                runtime.renderer.core.bindless_enabled = 0
                print("[kobic.bindless] pipeline build failed; classic path")
        # Re-copy render_pass into the runtime so the bindless pipeline fields
        # (set on the local above) are reflected in the stored value-type copy.
        runtime.render_pass = render_pass

        runtime.ready_flag = 1
        return runtime

    # Bind the (now stably-located) cull pipeline to the renderer. Must be
    # called after this runtime is stored in its final home (g_engine_runtime),
    # so the renderer's borrowed pointer stays valid across frames.
    fun bind_cull(self):
        if self.ready_flag == 0:
            return
        if self.cull.ready == 1:
            self.renderer.core.set_gpu_culling(1, self.cull as i64)
            if self.hzb.ready == 1:
                self.renderer.core.set_gpu_hzb(self.hzb as i64)
        if self.temporal.ready == 1:
            self.renderer.core.set_gpu_temporal(self.temporal as i64)

    fun ready(self) -> i32:
        return self.ready_flag

    fun running(self) -> i32:
        if self.ready_flag == 0:
            return 0
        return self.app.running()

    fun begin_frame(self) -> f32:
        return self.app.begin_frame()

    fun begin_frame_limited(self, target_fps: i32) -> f32:
        return self.app.begin_frame_limited(target_fps)

    fun frame_count(self) -> i32:
        return self.app.frame_count()

    fun present_mode(self) -> i32:
        return self.swapchain.present_mode

    fun capture_mouse(self):
        self.app.capture_mouse()

    fun release_mouse(self):
        self.app.release_mouse()

    fun center_mouse(self):
        self.app.center_mouse()

    fun mouse_x(self) -> i32:
        return self.app.mouse_x()

    fun mouse_y(self) -> i32:
        return self.app.mouse_y()

    fun mouse_delta_x(self) -> f32:
        return self.app.mouse_delta_x()

    fun mouse_delta_y(self) -> f32:
        return self.app.mouse_delta_y()

    fun active_renderer(self) -> Renderer:
        return self.renderer

    fun upload_plane_mesh(self) -> i32:
        return self.renderer.upload_plane_mesh()

    fun upload_sprite_quad_mesh(self) -> i32:
        return self.renderer.upload_sprite_quad_mesh()

    fun _shared_sprite_quad_mesh(self) -> i32:
        return self.renderer._shared_sprite_quad_mesh()

    fun upload_colored_plane_mesh(self, color: Color) -> i32:
        return self.renderer.upload_colored_plane_mesh(color)

    fun upload_cube_mesh(self) -> i32:
        return self.renderer.upload_cube_mesh()

    fun upload_colored_cube_mesh(self, color: Color) -> i32:
        return self.renderer.upload_colored_cube_mesh(color)

    fun upload_model_mesh(self, model: Model3D) -> i32:
        return self.renderer.upload_model_mesh(model)

    fun upload_model_part(self, model: Model3D, mesh_index: i32, primitive_index: i32) -> i32:
        return self.renderer.upload_model_part(model, mesh_index, primitive_index)

    fun upload_mesh_data(self, mesh: GpuMeshData) -> i32:
        return self.renderer.upload_mesh_data(mesh)

    fun reserve_mesh_capacity(self, needed: i32) -> i32:
        return self.renderer.reserve_mesh_capacity(needed)

    fun reserve_dynamic_mesh_arena(self, vertex_bytes: i64, index_bytes: i64) -> i32:
        return self.renderer.reserve_dynamic_mesh_arena(vertex_bytes, index_bytes)

    fun reserve_dynamic_mesh_arena_pages(self, pages: i32) -> i32:
        return self.renderer.reserve_dynamic_mesh_arena_pages(pages)

    fun upload_dynamic_mesh_data(self, mesh: GpuMeshData) -> i32:
        return self.renderer.upload_dynamic_mesh_data(mesh)

    fun replace_dynamic_mesh_data(self, mesh_id: i32, mesh: GpuMeshData) -> i32:
        return self.renderer.replace_dynamic_mesh_data(mesh_id, mesh)

    fun set_mesh_static_batch(self, mesh_id: i32, on: i32) -> i32:
        return self.renderer.set_mesh_static_batch(mesh_id, on)

    fun set_mesh_late_occlusion(self, mesh_id: i32, on: i32) -> i32:
        return self.renderer.set_mesh_late_occlusion(mesh_id, on)

    fun set_mesh_fog_distance_scale(self, mesh_id: i32, scale: f32) -> i32:
        return self.renderer.set_mesh_fog_distance_scale(mesh_id, scale)

    fun replace_mesh_data(self, mesh_id: i32, mesh: GpuMeshData) -> i32:
        return self.renderer.replace_mesh_data(mesh_id, mesh)

    fun upload_model(self, path: str) -> i32:
        return self.renderer.upload_model(path)

    fun upload_model_or_cube(self, path: str) -> i32:
        mesh_id: i32 = self.upload_model(path)
        if mesh_id < 0:
            print(@"Model load failed: {path}; using cube fallback")
            mesh_id = self.upload_cube_mesh()
        return mesh_id

    fun destroy_mesh(self, mesh_id: i32) -> i32:
        return self.renderer.destroy_mesh(mesh_id)

    fun mesh_is_live(self, mesh_id: i32) -> i32:
        return self.renderer.mesh_is_live(mesh_id)

    fun register_instance(self, source_mesh: i32) -> i32:
        return self.renderer.register_instance(source_mesh)

    # Load a PNG via the image package, upload it to the GPU, and return a
    # texture id (-1 on failure). Resolves the path through Assets.
    fun upload_texture(self, path: str) -> i32:
        return self.upload_texture_spec(path, TextureSpec.smooth())

    # Same, but with an explicit TextureSpec controlling filtering/wrap/srgb.
    # The asset is whatever the pack (or the asset folder) holds under that
    # name: a cooked texture with its full mip chain, or a PNG decoded here.
    fun upload_texture_spec(self, path: str, spec: TextureSpec) -> i32:
        bytes: DpkBytes = AssetFiles.read(path)
        if bytes.ok == 0:
            print(@"Texture not found: {path}")
            return 0 - 1
        if bytes.size >= 4 and Memory.read_i32(bytes.data) == KOBIC_TEXTURE_MAGIC:
            cooked: CookedTexture = KobicTextureLoader.load_bytes(bytes.data, bytes.size)
            if cooked.valid == 0:
                print(@"Cooked texture is invalid: {path}")
                return 0 - 1
            cooked_tid: i32 = self.renderer.upload_texture_cooked_spec(self.render_pass, self.render_pass.vk_command_pool, cooked, spec)
            cooked.free()
            if cooked_tid < 0:
                print(@"Cooked texture format unsupported by this GPU: {path}")
            return cooked_tid
        img: Image = png_decode_bytes(bytes.data, bytes.size)
        bytes.free()
        if img.is_valid() == 0:
            print(@"Texture load failed: {path}")
            return 0 - 1
        tid: i32 = self.renderer.upload_texture_image_spec(self.render_pass, self.render_pass.vk_command_pool, img, spec)
        img.free()
        return tid

    fun bind_texture(self, mesh_id: i32, tex_id: i32):
        self.renderer.bind_texture(mesh_id, tex_id)

    # Prepare/upload once. The atlas needs pixels on the CPU to build its
    # gutters, so its source is a PNG or a lossless RGBA8 cooked texture.
    fun upload_texture_atlas_spec(self, path: str, spec: TextureSpec, columns: i32, rows: i32, core_pixels: i32, gutter_pixels: i32) -> i32:
        bytes: DpkBytes = AssetFiles.read(path)
        if bytes.ok == 0:
            print(@"Tiled atlas not found: {path}")
            return -1
        source: Image = Image.empty()
        cooked: CookedTexture = CookedTexture()
        if bytes.size >= 4 and Memory.read_i32(bytes.data) == KOBIC_TEXTURE_MAGIC:
            cooked = KobicTextureLoader.load_bytes(bytes.data, bytes.size)
            if cooked.valid != 0 and cooked.format == KOBIC_TEXTURE_FORMAT_RGBA8 and cooked.swizzle == 0:
                source = Image.wrap_rgba(cooked.width,cooked.height,cooked.pixels+cooked.level_offset(0))
            else:
                print(@"Tiled atlas must be a PNG or a lossless RGBA8 texture: {path}")
        else:
            source = png_decode_bytes(bytes.data, bytes.size)
            bytes.free()
        padded: Image = kobic_texture_pad_atlas(source,columns,rows,core_pixels,gutter_pixels)
        source.free()
        cooked.free()
        if padded.is_valid() == 0:
            print(@"Tiled atlas load/shape failed: {path}")
            return -1
        tid: i32 = self.renderer.upload_texture_image_spec(self.render_pass,self.render_pass.vk_command_pool,padded,spec)
        padded.free()
        return tid

