##############################
# Kobic Engine — Node
#
# `Node` is a lightweight HANDLE into the ECS scene: it pairs the
# `Scene` with an entity id. Every transform / identity operation is
# a thin wrapper over the component arrays — the Node stores no
# entity data itself, so copying a handle is free (12 bytes).
##############################

struct Node:
    scene: Scene = Scene()
    id:    i32   = -1

attach Node:

    # ---- Transform (fluent — every setter returns the handle) ----

    fun position(self, x: f32, y: f32, z: f32) -> Node:
        Node3D.set_pos(self.scene, self.id, x, y, z)
        return Node(scene=self.scene, id=self.id)

    fun rotation(self, x: f32, y: f32, z: f32) -> Node:
        Node3D.set_rot(self.scene, self.id, x, y, z)
        return Node(scene=self.scene, id=self.id)

    fun scale(self, x: f32, y: f32, z: f32) -> Node:
        Node3D.set_scale(self.scene, self.id, x, y, z)
        return Node(scene=self.scene, id=self.id)

    fun pos_x(self) -> f32:
        return Node3D.get_pos_x(self.scene, self.id)

    fun pos_y(self) -> f32:
        return Node3D.get_pos_y(self.scene, self.id)

    fun pos_z(self) -> f32:
        return Node3D.get_pos_z(self.scene, self.id)

    # ---- Identity / camera config ----

    fun set_name(self, name: str) -> Node:
        ni: i64 = self.scene.get_component(self.id, "NodeInfo")
        if ni != 0:
            Memory.write_ptr(ni + 0, name)
        return Node(scene=self.scene, id=self.id)

    fun set_fov(self, fov: f32) -> Node:
        c: i64 = self.scene.get_component(self.id, "CameraData")
        if c != 0:
            Memory.write_f32(c + 0, fov)
        return Node(scene=self.scene, id=self.id)

    # ---- Flat-array addressing ----
    # `first.at(i)` is the handle of the entity `i` slots after `first`.
    # Valid when a batch was spawned consecutively (the ECS hands out
    # sequential ids) — which is exactly how the mob arrays are built.

    fun at(self, offset: i32) -> Node:
        return Node(scene=self.scene, id=self.id + offset)

    # ---- Internal spawn helpers (used by the Spawnable impls) ----

    static fun spawn_cube(w: Scene, ren: Renderer, name: str, size: f32, x: f32, y: f32, z: f32) -> i32:
        return MeshData.spawn_cube(w, ren, name, size, x, y, z)

    static fun spawn_plane(w: Scene, ren: Renderer, name: str, sx: f32, sz: f32, x: f32, y: f32, z: f32) -> i32:
        eid: i32 = MeshData.spawn_plane(w, name, sx, sz)
        if eid < 0:
            return eid
        Node3D.set_pos(w, eid, x, y, z)
        Node._upload_mesh(w, ren, eid)
        Node.update_matrix(w, ren, eid)
        return eid

    # ---- Matrix Update — recomposes an entity's model matrix from
    # its Transform and hands it to the renderer. Called every frame
    # by App.end_frame for all mesh entities.

    static fun update_matrix(w: Scene, ren: Renderer, eid: i32) -> void:
        md: i64 = w.get_component(eid, "MeshData")
        if md == 0:
            return
        vb_idx: i32 = Memory.read_i32(md + 12)
        if vb_idx < 0:
            return
        t: i64 = w.get_component(eid, "Transform")
        if t == 0:
            return
        tpx: f32 = Memory.read_f32(t)
        tpy: f32 = Memory.read_f32(t + 4)
        tpz: f32 = Memory.read_f32(t + 8)
        trx: f32 = Memory.read_f32(t + 12)
        try_v: f32 = Memory.read_f32(t + 16)
        trz: f32 = Memory.read_f32(t + 20)
        tsx: f32 = Memory.read_f32(t + 24)
        tsy: f32 = Memory.read_f32(t + 28)
        tsz: f32 = Memory.read_f32(t + 32)
        m: Mat4 = Mat4.compose(tpx, tpy, tpz, trx, try_v, trz, tsx, tsy, tsz)
        mat_ptr: i64 = 0
        if ren.model_matrices != 0:
            mat_ptr = Memory.read_ptr(ren.model_matrices + vb_idx * 8)
        if mat_ptr == 0:
            mat_ptr = Memory.malloc_zeroed(64)
        if mat_ptr == 0:
            return
        m.write_to_ptr(mat_ptr)
        ren.set_model_matrix(vb_idx, mat_ptr)

    # ---- Mesh Upload (internal) ----

    static fun _upload_mesh(w: Scene, ren: Renderer, eid: i32) -> void:
        md: i64 = w.get_component(eid, "MeshData")
        if md == 0:
            return
        v: i64 = Memory.read_ptr(md)
        c: i32 = Memory.read_i32(md + 8)
        if v == 0:
            return
        if c <= 0:
            return
        idx: i32 = ren.upload_mesh(v, c)
        Memory.write_i32(md + 12, idx)
