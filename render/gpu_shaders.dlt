fun get_hzb_compute_shader() -> EmbeddedShader:
    shader: EmbeddedShader = EmbeddedShader()
    buf: i64 = Memory.malloc_zeroed(3788)
    if buf == 0:
        return shader
    _kobic_init_hzb_shader(buf)
    shader.data = buf
    shader.size = 3788
    return shader
