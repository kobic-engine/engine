fun get_textured_vert_shader() -> EmbeddedShader:
    shader: EmbeddedShader = EmbeddedShader()
    buf: i64 = Memory.malloc_zeroed(16080)
    if buf == 0:
        return shader
    _kobic_init_tex_vert_shader(buf)
    shader.data = buf
    shader.size = 16080
    return shader
