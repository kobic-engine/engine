fun get_outline_frag_shader() -> EmbeddedShader:
    shader: EmbeddedShader = EmbeddedShader()
    buf: i64 = Memory.malloc_zeroed(6816)
    if buf == 0:
        return shader
    _kobic_init_outline_frag_shader(buf)
    shader.data = buf
    shader.size = 6816
    return shader
