##############################
# Frog - Independent Vulkan GPU Renderer
# No Kobic dependency. Uses only window + vulkan bindings.
##############################

fun gpu_set_transform(ren: GpuRendererCore, mesh_id: i32, x: f32, y: f32, z: f32, rx: f32, ry: f32, rz: f32, sx: f32, sy: f32, sz: f32):
    if mesh_id < 0:
        return
    if mesh_id >= ren.vb_count:
        return
    if ren.model_matrices == 0:
        return
    mat_ptr: i64 = Memory.read_ptr(ren.model_matrices + mesh_id * 8)
    if mat_ptr == 0:
        mat_ptr = Memory.malloc_zeroed(64)
    if mat_ptr == 0:
        return
    m: Mat4 = Mat4.trs(x, y, z, rx, ry, rz, sx, sy, sz)
    m.write_to_ptr(mat_ptr)
    if Memory.read_ptr(ren.model_matrices + mesh_id * 8) == 0:
        ren.set_model_matrix(mesh_id, mat_ptr)
    else:
        # In-place matrix update: the GPU cull candidate buffer caches this
        # matrix, so mark it stale or the GPU-drawn mesh stays at the old
        # transform while CPU-side collision/shadow move.
        ren._mark_cull_dirty()

# Set a mesh's model matrix directly from a 64-byte (16 x f32) column-major
# matrix at `src`. Used for view-locked objects (e.g. an FPS viewmodel) where
# the caller has already composed camera_world * local.
fun gpu_set_model_matrix_raw(ren: GpuRendererCore, mesh_id: i32, src: i64):
    if mesh_id < 0:
        return
    if mesh_id >= ren.vb_count:
        return
    if ren.model_matrices == 0:
        return
    if src == 0:
        return
    mat_ptr: i64 = Memory.read_ptr(ren.model_matrices + mesh_id * 8)
    if mat_ptr == 0:
        mat_ptr = Memory.malloc_zeroed(64)
    if mat_ptr == 0:
        return
    Memory.copy(mat_ptr, src, 64)
    if Memory.read_ptr(ren.model_matrices + mesh_id * 8) == 0:
        ren.set_model_matrix(mesh_id, mat_ptr)
    else:
        ren._mark_cull_dirty()

# Update a rigid render group with one backend traversal and one cull dirty
# notification. Matrices remain independently owned by the renderer: NEVER
# alias the caller's matrix across IDs (cleanup would double-free it).
fun gpu_set_model_matrix_group(ren: GpuRendererCore, mesh_ids: i64, count: i32, src: i64) -> i32:
    if mesh_ids == 0 or src == 0 or count <= 0 or ren.model_matrices == 0:
        return 0
    updated: i32 = 0
    structural: i32 = 0
    index: i32 = 0
    while index < count:
        mesh_id: i32 = Memory.read_i32(mesh_ids + (index as i64) * 4)
        if mesh_id >= 0 and mesh_id < ren.vb_count:
            slot: i64 = ren.model_matrices + (mesh_id as i64) * 8
            matrix: i64 = Memory.read_ptr(slot)
            if matrix == 0:
                matrix = Memory.malloc(64)
                if matrix != 0:
                    Memory.write_ptr(slot, matrix)
                    structural = 1
            if matrix != 0:
                Memory.copy(matrix, src, 64)
                updated = updated + 1
        index = index + 1
    if structural != 0:
        ren._mark_cull_dirty_struct()
    elif updated > 0:
        ren._mark_cull_dirty()
    return updated

fun gpu_camera_view_roll_into(cam_x: f32, cam_y: f32, cam_z: f32, pitch: f32, yaw: f32, roll: f32, m: i64):
    if m == 0:
        return
    pi: f32 = 3.14159265
    rad_x: f32 = pitch * pi / 180.0
    rad_y: f32 = yaw * pi / 180.0
    rad_z: f32 = roll * pi / 180.0
    cx: f32 = @cos(rad_x)
    sx: f32 = @sin(rad_x)
    cy: f32 = @cos(rad_y)
    sy: f32 = @sin(rad_y)
    cz: f32 = @cos(rad_z)
    sz: f32 = @sin(rad_z)
    # Camera world rotation follows Mat4.trs: R = Ry * Rx * Rz.  The view
    # matrix stores its inverse (the transposed orthonormal rotation).  Roll
    # rotates the local right/up axes around the unchanged forward axis, which
    # is required for unrestricted six-degree-of-freedom cameras.
    r00: f32 = cy * cz + sy * sx * sz
    r01: f32 = 0.0 - cy * sz + sy * sx * cz
    r02: f32 = cx * sy
    r10: f32 = cx * sz
    r11: f32 = cx * cz
    r12: f32 = 0.0 - sx
    r20: f32 = 0.0 - sy * cz + cy * sx * sz
    r21: f32 = sy * sz + cy * sx * cz
    r22: f32 = cx * cy
    tx: f32 = 0.0 - (r00 * cam_x + r10 * cam_y + r20 * cam_z)
    ty: f32 = 0.0 - (r01 * cam_x + r11 * cam_y + r21 * cam_z)
    tz: f32 = 0.0 - (r02 * cam_x + r12 * cam_y + r22 * cam_z)
    Memory.set(m, 0, 64)
    Memory.write_f32(m + 0, r00)
    Memory.write_f32(m + 4, r01)
    Memory.write_f32(m + 8, r02)
    Memory.write_f32(m + 12, 0.0)
    Memory.write_f32(m + 16, r10)
    Memory.write_f32(m + 20, r11)
    Memory.write_f32(m + 24, r12)
    Memory.write_f32(m + 28, 0.0)
    Memory.write_f32(m + 32, r20)
    Memory.write_f32(m + 36, r21)
    Memory.write_f32(m + 40, r22)
    Memory.write_f32(m + 44, 0.0)
    Memory.write_f32(m + 48, tx)
    Memory.write_f32(m + 52, ty)
    Memory.write_f32(m + 56, tz)
    Memory.write_f32(m + 60, 1.0)

# Backward-compatible pitch/yaw camera path.
fun gpu_camera_view_into(cam_x: f32, cam_y: f32, cam_z: f32, pitch: f32, yaw: f32, m: i64):
    gpu_camera_view_roll_into(cam_x, cam_y, cam_z, pitch, yaw, 0.0, m)

fun gpu_camera_view(cam_x: f32, cam_y: f32, cam_z: f32, pitch: f32, yaw: f32) -> i64:
    m: i64 = Memory.malloc_zeroed(64)
    if m == 0:
        return 0
    gpu_camera_view_into(cam_x, cam_y, cam_z, pitch, yaw, m)
    return m

fun gpu_camera_view_roll(cam_x: f32, cam_y: f32, cam_z: f32, pitch: f32, yaw: f32, roll: f32) -> i64:
    m: i64 = Memory.malloc_zeroed(64)
    if m == 0:
        return 0
    gpu_camera_view_roll_into(cam_x, cam_y, cam_z, pitch, yaw, roll, m)
    return m

# Quaternion view path for unrestricted local-axis camera rotation. The
# quaternion describes camera-local -> world; the view stores its inverse.
fun gpu_camera_view_quat_into(cam_x: f32, cam_y: f32, cam_z: f32, qx: f32, qy: f32, qz: f32, qw: f32, m: i64):
    if m == 0:
        return
    normalized_qx: f32 = qx
    normalized_qy: f32 = qy
    normalized_qz: f32 = qz
    normalized_qw: f32 = qw
    length: f32 = @sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
    if length < 0.0001:
        normalized_qx = 0.0
        normalized_qy = 0.0
        normalized_qz = 0.0
        normalized_qw = 1.0
    else:
        inverse_length: f32 = 1.0 / length
        normalized_qx = qx * inverse_length
        normalized_qy = qy * inverse_length
        normalized_qz = qz * inverse_length
        normalized_qw = qw * inverse_length
    xx: f32 = normalized_qx * normalized_qx
    yy: f32 = normalized_qy * normalized_qy
    zz: f32 = normalized_qz * normalized_qz
    xy: f32 = normalized_qx * normalized_qy
    xz: f32 = normalized_qx * normalized_qz
    yz: f32 = normalized_qy * normalized_qz
    xw: f32 = normalized_qx * normalized_qw
    yw: f32 = normalized_qy * normalized_qw
    zw: f32 = normalized_qz * normalized_qw
    r0: f32 = 1.0 - 2.0 * (yy + zz)
    r1: f32 = 2.0 * (xy + zw)
    r2: f32 = 2.0 * (xz - yw)
    r4: f32 = 2.0 * (xy - zw)
    r5: f32 = 1.0 - 2.0 * (xx + zz)
    r6: f32 = 2.0 * (yz + xw)
    r8: f32 = 2.0 * (xz + yw)
    r9: f32 = 2.0 * (yz - xw)
    r10: f32 = 1.0 - 2.0 * (xx + yy)
    tx: f32 = 0.0 - (r0 * cam_x + r1 * cam_y + r2 * cam_z)
    ty: f32 = 0.0 - (r4 * cam_x + r5 * cam_y + r6 * cam_z)
    tz: f32 = 0.0 - (r8 * cam_x + r9 * cam_y + r10 * cam_z)
    Memory.set(m, 0, 64)
    Memory.write_f32(m + 0, r0)
    Memory.write_f32(m + 4, r4)
    Memory.write_f32(m + 8, r8)
    Memory.write_f32(m + 16, r1)
    Memory.write_f32(m + 20, r5)
    Memory.write_f32(m + 24, r9)
    Memory.write_f32(m + 32, r2)
    Memory.write_f32(m + 36, r6)
    Memory.write_f32(m + 40, r10)
    Memory.write_f32(m + 48, tx)
    Memory.write_f32(m + 52, ty)
    Memory.write_f32(m + 56, tz)
    Memory.write_f32(m + 60, 1.0)

fun gpu_camera_quat_forward(qx: f32, qy: f32, qz: f32, qw: f32) -> Vec3:
    q: Quat = Quat.make(qx, qy, qz, qw).normalize()
    return q.rotate_vec3(Vec3.forward())

fun gpu_camera_proj_into(fov: f32, aspect: f32, m: i64):
    gpu_camera_proj_into_range(fov, aspect, 0.1, 1000.0, m)

fun gpu_camera_proj_into_range(fov: f32, aspect: f32, near_plane: f32, far_plane: f32, m: i64):
    if m == 0:
        return
    near: f32 = near_plane
    if near < 0.001:
        near = 0.001
    far: f32 = far_plane
    if far <= near + 0.001:
        far = near + 1000.0
    pi: f32 = 3.14159265
    half: f32 = fov * pi / 360.0
    f: f32 = @cos(half) / @sin(half)
    ri: f32 = 1.0 / (near - far)
    Memory.set(m, 0, 64)
    Memory.write_f32(m + 0, f / aspect)
    Memory.write_f32(m + 20, 0.0 - f)
    Memory.write_f32(m + 40, far * ri)
    Memory.write_f32(m + 44, 0.0 - 1.0)
    Memory.write_f32(m + 56, near * far * ri)

fun gpu_camera_proj(fov: f32, aspect: f32) -> i64:
    m: i64 = Memory.malloc_zeroed(64)
    if m == 0:
        return 0
    gpu_camera_proj_into(fov, aspect, m)
    return m

@heap struct Renderer:
    core: GpuRendererCore = GpuRendererCore()
    model_cache_paths: i64 = 0
    model_cache_lods: i64 = 0
    model_cache_mesh_ids: i64 = 0
    model_cache_count: i32 = 0
    model_cache_capacity: i32 = 0
    model_part_cache_paths: i64 = 0
    model_part_cache_lods: i64 = 0
    model_part_cache_mesh_indices: i64 = 0
    model_part_cache_primitive_indices: i64 = 0
    model_part_cache_mesh_ids: i64 = 0
    model_part_cache_count: i32 = 0
    model_part_cache_capacity: i32 = 0

attach Renderer:

    static fun create() -> Renderer:
        renderer: Renderer = Renderer(core=GpuRendererCore())
        renderer._init_model_cache()
        renderer._init_model_part_cache()
        return renderer

    fun _init_model_cache(self):
        if self.model_cache_capacity > 0:
            return
        self.model_cache_capacity = 64
        self.model_cache_count = 0
        self.model_cache_paths = Memory.malloc_zeroed((self.model_cache_capacity as i64) * 8)
        self.model_cache_lods = Memory.malloc_zeroed((self.model_cache_capacity as i64) * 4)
        self.model_cache_mesh_ids = Memory.malloc_zeroed((self.model_cache_capacity as i64) * 4)

    fun _grow_model_cache(self):
        if self.model_cache_capacity <= 0:
            self._init_model_cache()
            return
        new_cap: i32 = self.model_cache_capacity * 2
        new_paths: i64 = Memory.malloc_zeroed((new_cap as i64) * 8)
        new_lods: i64 = Memory.malloc_zeroed((new_cap as i64) * 4)
        new_ids: i64 = Memory.malloc_zeroed((new_cap as i64) * 4)
        if new_paths == 0:
            return
        if new_lods == 0:
            Memory.free(new_paths)
            return
        if new_ids == 0:
            Memory.free(new_paths)
            Memory.free(new_lods)
            return
        Memory.copy(new_paths, self.model_cache_paths, (self.model_cache_capacity as i64) * 8)
        Memory.copy(new_lods, self.model_cache_lods, (self.model_cache_capacity as i64) * 4)
        Memory.copy(new_ids, self.model_cache_mesh_ids, (self.model_cache_capacity as i64) * 4)
        Memory.free(self.model_cache_paths)
        Memory.free(self.model_cache_lods)
        Memory.free(self.model_cache_mesh_ids)
        self.model_cache_paths = new_paths
        self.model_cache_lods = new_lods
        self.model_cache_mesh_ids = new_ids
        self.model_cache_capacity = new_cap

    fun _find_model_cache(self, resolved_path: str, lod: i32) -> i32:
        if self.model_cache_paths == 0:
            return 0 - 1
        index: i32 = 0
        while index < self.model_cache_count:
            cached_path: str = Memory.read_ptr(self.model_cache_paths + ((index as i64) * 8)) as str
            if Memory.strlen(cached_path) > 0:
                if Str.equals(cached_path, resolved_path):
                    cached_lod: i32 = Memory.read_i32(self.model_cache_lods + ((index as i64) * 4))
                    if cached_lod == lod:
                        return Memory.read_i32(self.model_cache_mesh_ids + ((index as i64) * 4))
            index = index + 1
        return 0 - 1

    fun _remember_model_cache(self, resolved_path: str, lod: i32, mesh_id: i32):
        if mesh_id < 0:
            return
        self._init_model_cache()
        existing: i32 = self._find_model_cache(resolved_path, lod)
        if existing >= 0:
            return
        if self.model_cache_count >= self.model_cache_capacity:
            self._grow_model_cache()
        if self.model_cache_count >= self.model_cache_capacity:
            return
        if Memory.strlen(resolved_path) == 0:
            return
        stored_path: str = Str.strcpy(resolved_path)
        if (stored_path as i64) == 0:
            return
        slot: i32 = self.model_cache_count
        Memory.write_ptr(self.model_cache_paths + ((slot as i64) * 8), stored_path as i64)
        Memory.write_i32(self.model_cache_lods + ((slot as i64) * 4), lod)
        Memory.write_i32(self.model_cache_mesh_ids + ((slot as i64) * 4), mesh_id)
        self.model_cache_count = slot + 1

    fun _init_model_part_cache(self):
        if self.model_part_cache_capacity > 0:
            return
        self.model_part_cache_capacity = 128
        self.model_part_cache_count = 0
        self.model_part_cache_paths = Memory.malloc_zeroed((self.model_part_cache_capacity as i64) * 8)
        self.model_part_cache_lods = Memory.malloc_zeroed((self.model_part_cache_capacity as i64) * 4)
        self.model_part_cache_mesh_indices = Memory.malloc_zeroed((self.model_part_cache_capacity as i64) * 4)
        self.model_part_cache_primitive_indices = Memory.malloc_zeroed((self.model_part_cache_capacity as i64) * 4)
        self.model_part_cache_mesh_ids = Memory.malloc_zeroed((self.model_part_cache_capacity as i64) * 4)

    fun _grow_model_part_cache(self):
        if self.model_part_cache_capacity <= 0:
            self._init_model_part_cache()
            return
        new_cap: i32 = self.model_part_cache_capacity * 2
        new_paths: i64 = Memory.malloc_zeroed((new_cap as i64) * 8)
        new_lods: i64 = Memory.malloc_zeroed((new_cap as i64) * 4)
        new_mesh_indices: i64 = Memory.malloc_zeroed((new_cap as i64) * 4)
        new_primitive_indices: i64 = Memory.malloc_zeroed((new_cap as i64) * 4)
        new_ids: i64 = Memory.malloc_zeroed((new_cap as i64) * 4)
        if new_paths == 0:
            return
        if new_lods == 0:
            Memory.free(new_paths)
            return
        if new_mesh_indices == 0:
            Memory.free(new_paths)
            Memory.free(new_lods)
            return
        if new_primitive_indices == 0:
            Memory.free(new_paths)
            Memory.free(new_lods)
            Memory.free(new_mesh_indices)
            return
        if new_ids == 0:
            Memory.free(new_paths)
            Memory.free(new_lods)
            Memory.free(new_mesh_indices)
            Memory.free(new_primitive_indices)
            return
        Memory.copy(new_paths, self.model_part_cache_paths, (self.model_part_cache_capacity as i64) * 8)
        Memory.copy(new_lods, self.model_part_cache_lods, (self.model_part_cache_capacity as i64) * 4)
        Memory.copy(new_mesh_indices, self.model_part_cache_mesh_indices, (self.model_part_cache_capacity as i64) * 4)
        Memory.copy(new_primitive_indices, self.model_part_cache_primitive_indices, (self.model_part_cache_capacity as i64) * 4)
        Memory.copy(new_ids, self.model_part_cache_mesh_ids, (self.model_part_cache_capacity as i64) * 4)
        Memory.free(self.model_part_cache_paths)
        Memory.free(self.model_part_cache_lods)
        Memory.free(self.model_part_cache_mesh_indices)
        Memory.free(self.model_part_cache_primitive_indices)
        Memory.free(self.model_part_cache_mesh_ids)
        self.model_part_cache_paths = new_paths
        self.model_part_cache_lods = new_lods
        self.model_part_cache_mesh_indices = new_mesh_indices
        self.model_part_cache_primitive_indices = new_primitive_indices
        self.model_part_cache_mesh_ids = new_ids
        self.model_part_cache_capacity = new_cap

    fun _find_model_part_cache(self, resolved_path: str, lod: i32, mesh_index: i32, primitive_index: i32) -> i32:
        if self.model_part_cache_paths == 0:
            return 0 - 1
        index: i32 = 0
        while index < self.model_part_cache_count:
            cached_path: str = Memory.read_ptr(self.model_part_cache_paths + ((index as i64) * 8)) as str
            if Memory.strlen(cached_path) > 0:
                if Str.equals(cached_path, resolved_path):
                    cached_lod: i32 = Memory.read_i32(self.model_part_cache_lods + ((index as i64) * 4))
                    cached_mesh_index: i32 = Memory.read_i32(self.model_part_cache_mesh_indices + ((index as i64) * 4))
                    cached_primitive_index: i32 = Memory.read_i32(self.model_part_cache_primitive_indices + ((index as i64) * 4))
                    if cached_lod == lod:
                        if cached_mesh_index == mesh_index:
                            if cached_primitive_index == primitive_index:
                                return Memory.read_i32(self.model_part_cache_mesh_ids + ((index as i64) * 4))
            index = index + 1
        return 0 - 1

    fun _remember_model_part_cache(self, resolved_path: str, lod: i32, mesh_index: i32, primitive_index: i32, mesh_id: i32):
        if mesh_id < 0:
            return
        self._init_model_part_cache()
        existing: i32 = self._find_model_part_cache(resolved_path, lod, mesh_index, primitive_index)
        if existing >= 0:
            return
        if self.model_part_cache_count >= self.model_part_cache_capacity:
            self._grow_model_part_cache()
        if self.model_part_cache_count >= self.model_part_cache_capacity:
            return
        if Memory.strlen(resolved_path) == 0:
            return
        stored_path: str = Str.strcpy(resolved_path)
        if (stored_path as i64) == 0:
            return
        slot: i32 = self.model_part_cache_count
        Memory.write_ptr(self.model_part_cache_paths + ((slot as i64) * 8), stored_path as i64)
        Memory.write_i32(self.model_part_cache_lods + ((slot as i64) * 4), lod)
        Memory.write_i32(self.model_part_cache_mesh_indices + ((slot as i64) * 4), mesh_index)
        Memory.write_i32(self.model_part_cache_primitive_indices + ((slot as i64) * 4), primitive_index)
        Memory.write_i32(self.model_part_cache_mesh_ids + ((slot as i64) * 4), mesh_id)
        self.model_part_cache_count = slot + 1

    fun init(self, device: i64, phys_device: i64, gfx_queue: i64, present_queue: i64):
        self.core.init(device, phys_device, gfx_queue, present_queue)

    fun upload_plane_mesh(self) -> i32:
        return self.core.upload_plane_mesh()

    fun upload_sprite_quad_mesh(self) -> i32:
        return self.core.upload_sprite_quad_mesh()

    fun _shared_sprite_quad_mesh(self) -> i32:
        return self.core._shared_sprite_quad_mesh()

    fun upload_colored_plane_mesh(self, color: Color) -> i32:
        return self.core.upload_colored_plane_mesh(color)

    fun upload_cube_mesh(self) -> i32:
        return self.core.upload_cube_mesh()

    fun upload_colored_cube_mesh(self, color: Color) -> i32:
        return self.core.upload_colored_cube_mesh(color)

    fun upload_model_mesh(self, model: Model3D) -> i32:
        return self.core.upload_model_mesh(model)

    fun upload_model_part_mesh(self, model: Model3D, mesh_index: i32, primitive_index: i32) -> i32:
        return self.core.upload_model_part_mesh(model, mesh_index, primitive_index)

    fun upload_mesh_data(self, mesh: GpuMeshData) -> i32:
        return self.core.upload_mesh_data(mesh)

    fun reserve_mesh_capacity(self, needed: i32) -> i32:
        return self.core.reserve_mesh_capacity(needed)

    fun reserve_dynamic_mesh_arena(self, vertex_bytes: i64, index_bytes: i64) -> i32:
        return self.core.reserve_dynamic_mesh_arena(vertex_bytes, index_bytes)

    fun upload_dynamic_mesh_data(self, mesh: GpuMeshData) -> i32:
        return self.core.upload_dynamic_mesh_data(mesh)

    fun replace_dynamic_mesh_data(self, mesh_id: i32, mesh: GpuMeshData) -> i32:
        return self.core.replace_dynamic_mesh_data(mesh_id, mesh)

    fun set_mesh_static_batch(self, mesh_id: i32, on: i32) -> i32:
        return self.core.set_mesh_static_batch(mesh_id, on)

    fun replace_mesh_data(self, mesh_id: i32, mesh: GpuMeshData) -> i32:
        return self.core.replace_mesh_data(mesh_id, mesh)

    fun upload_model(self, path: str) -> i32:
        model: Model3D = Assets.models.load(path)
        if model.found == 0:
            return -1
        if model.parsed == 0:
            return -1
        cached: i32 = self._find_model_cache(model.resolved_path, model.frog_lod)
        if cached >= 0:
            return cached
        mesh_id: i32 = self.upload_model_mesh(model)
        self._remember_model_cache(model.resolved_path, model.frog_lod, mesh_id)
        return mesh_id

    fun upload_model_part(self, model: Model3D, mesh_index: i32, primitive_index: i32) -> i32:
        if model.found == 0:
            return -1
        if model.parsed == 0:
            return -1
        cached: i32 = self._find_model_part_cache(model.resolved_path, model.frog_lod, mesh_index, primitive_index)
        if cached >= 0:
            return cached
        mesh_id: i32 = self.upload_model_part_mesh(model, mesh_index, primitive_index)
        self._remember_model_part_cache(model.resolved_path, model.frog_lod, mesh_index, primitive_index, mesh_id)
        return mesh_id

    fun register_instance(self, source_mesh: i32) -> i32:
        return self.core.register_instance(source_mesh)

    # Upload a decoded RGBA Image to the GPU and register it as a texture.
    # Returns a texture id, or -1 on failure. Needs the render pass (for the
    # descriptor set) and a command pool (for the upload commands).
    fun upload_texture_image(self, rp: RenderPass, cmd_pool: i64, img: Image) -> i32:
        return self.upload_texture_image_spec(rp, cmd_pool, img, TextureSpec.smooth())

    # Same, but with an explicit TextureSpec controlling filtering/wrap/srgb.
    fun upload_texture_image_spec(self, rp: RenderPass, cmd_pool: i64, img: Image, spec: TextureSpec) -> i32:
        gtex: GpuTexture = gpu_texture_upload_image_spec(self.core.device, self.core.phys_device, self.core.gfx_queue, cmd_pool, img, spec)
        if gtex.ok == 0:
            return 0 - 1
        tid: i32 = self.core.register_texture(rp, gtex)
        if tid < 0:
            gpu_texture_destroy(self.core.device, gtex)
            return 0 - 1
        return tid

    fun upload_texture_cooked_spec(self, rp: RenderPass, cmd_pool: i64, cooked: CookedTexture, spec: TextureSpec) -> i32:
        gtex: GpuTexture = gpu_texture_upload_cooked_spec(self.core.device, self.core.phys_device, self.core.gfx_queue, cmd_pool, cooked, spec)
        if gtex.ok == 0:
            return 0 - 1
        tid: i32 = self.core.register_texture(rp, gtex)
        if tid < 0:
            gpu_texture_destroy(self.core.device, gtex)
            return 0 - 1
        return tid

    fun rebuild_texture_descriptors(self, rp: RenderPass) -> i32:
        return self.core.rebuild_texture_descriptors(rp)

    fun destroy_render_scale_target(self):
        self.core.destroy_render_scale_target()

    fun bind_texture(self, mesh_id: i32, tex_id: i32):
        self.core.bind_texture(mesh_id, tex_id)

    fun bind_material(self, mesh_id: i32, material: Material3D):
        self.core.bind_material(mesh_id, material)

    fun set_shadow_flags(self, mesh_id: i32, cast_shadows: i32, receive_shadows: i32):
        self.core.set_shadow_flags(mesh_id, cast_shadows, receive_shadows)

    fun set_shadow_distance(self, mesh_id: i32, distance: f32):
        self.core.set_shadow_distance(mesh_id, distance)

    fun set_transform(self, mesh_id: i32, x: f32, y: f32, z: f32, rx: f32, ry: f32, rz: f32, sx: f32, sy: f32, sz: f32):
        self.core.set_transform(mesh_id, x, y, z, rx, ry, rz, sx, sy, sz)

    fun set_model_matrix_raw(self, mesh_id: i32, src: i64):
        self.core.set_model_matrix_raw(mesh_id, src)

    fun set_model_matrix_group(self, mesh_ids: i64, count: i32, src: i64) -> i32:
        return gpu_set_model_matrix_group(self.core, mesh_ids, count, src)

    fun set_instance_visible(self, mesh_id: i32, on: i32):
        self.core.set_instance_visible(mesh_id, on)

    fun set_render_stats(self, enabled: i32):
        self.core.set_render_stats(enabled)

    fun set_gpu_timing(self, enabled: i32):
        self.core.set_gpu_timing(enabled)

    fun set_shadow_min_size(self, threshold: f32):
        self.core.set_shadow_min_size(threshold)

    fun set_shadow_cascade0_margin(self, margin: f32):
        self.core.set_shadow_cascade0_margin(margin)

    fun set_cpu_record_timing(self, enabled: i32):
        self.core.set_cpu_record_timing(enabled)

    fun set_gpu_shadow_cull(self, enabled: i32):
        self.core.set_gpu_shadow_cull(enabled)

    fun set_collision_debug(self, enabled: i32):
        self.core.set_collision_debug(enabled)

    fun set_collision_debug_root(self, root_ptr: i64):
        self.core.set_collision_debug_root(root_ptr)

    fun begin_collision_debug_frame(self):
        self.core.begin_collision_debug_frame()

    fun add_collision_debug_box(self, center: Vec3, size: Vec3, color: Color):
        self.core.add_collision_debug_box(center, size, color)

    fun add_collision_debug_line(self, a: Vec3, b: Vec3, color: Color):
        self.core.add_collision_debug_line(a,b,color)

    fun set_instance_culling(self, enabled: i32):
        self.core.set_instance_culling(enabled)

    # Select the culling strategy: FROG_CULL_MODE_CPU / _GPU / _AUTO.
    fun set_culling_mode(self, mode: i32):
        self.core.set_culling_mode(mode)

    # Instance-count threshold for AUTO mode (GPU when vb_count >= threshold).
    fun set_culling_auto_threshold(self, threshold: i32):
        self.core.set_culling_auto_threshold(threshold)

    fun set_directional_light(self, light_ptr: i64):
        self.core.set_directional_light(light_ptr)

    fun set_point_lights(self, light_ptrs: i64, count: i32):
        self.core.set_point_lights(light_ptrs, count)

    fun set_shadow_camera(self, x: f32, y: f32, z: f32, pitch: f32, yaw: f32):
        self.core.set_shadow_camera(x, y, z, pitch, yaw)

    fun set_shadow_camera_forward(self, x: f32, y: f32, z: f32, forward_x: f32, forward_y: f32, forward_z: f32):
        self.core.set_shadow_camera_forward(x, y, z, forward_x, forward_y, forward_z)

    fun set_shadow_camera_basis(self, x: f32, y: f32, z: f32, forward_x: f32, forward_y: f32, forward_z: f32, up_x: f32, up_y: f32, up_z: f32):
        self.core.set_shadow_camera_basis(x, y, z, forward_x, forward_y, forward_z, up_x, up_y, up_z)

    fun render_camera3d_frame(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32):
        self.core.render_camera3d_frame(render_pass, swapchain, ctx, camera, width, height)

    fun render_camera3d_frame_with_environment(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32, env: Environment):
        self.core.render_camera3d_frame_with_environment(render_pass, swapchain, ctx, camera, width, height, env)

    fun render_camera3d_frame_scaled(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32, render_width: i32, render_height: i32):
        self.core.render_camera3d_frame_scaled(render_pass, swapchain, ctx, camera, width, height, render_width, render_height)

    fun render_camera3d_frame_scaled_with_environment(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32, render_width: i32, render_height: i32, env: Environment):
        self.core.render_camera3d_frame_scaled_with_environment(render_pass, swapchain, ctx, camera, width, height, render_width, render_height, env)

    fun cleanup(self):
        if self.model_cache_paths != 0:
            ci: i32 = 0
            while ci < self.model_cache_count:
                cached_path: i64 = Memory.read_ptr(self.model_cache_paths + ((ci as i64) * 8))
                if cached_path != 0:
                    Memory.free(cached_path)
                ci = ci + 1
            Memory.free(self.model_cache_paths)
            self.model_cache_paths = 0
        if self.model_cache_lods != 0:
            Memory.free(self.model_cache_lods)
            self.model_cache_lods = 0
        if self.model_cache_mesh_ids != 0:
            Memory.free(self.model_cache_mesh_ids)
            self.model_cache_mesh_ids = 0
        self.model_cache_count = 0
        self.model_cache_capacity = 0
        if self.model_part_cache_paths != 0:
            pi: i32 = 0
            while pi < self.model_part_cache_count:
                cached_part_path: i64 = Memory.read_ptr(self.model_part_cache_paths + ((pi as i64) * 8))
                if cached_part_path != 0:
                    Memory.free(cached_part_path)
                pi = pi + 1
            Memory.free(self.model_part_cache_paths)
            self.model_part_cache_paths = 0
        if self.model_part_cache_lods != 0:
            Memory.free(self.model_part_cache_lods)
            self.model_part_cache_lods = 0
        if self.model_part_cache_mesh_indices != 0:
            Memory.free(self.model_part_cache_mesh_indices)
            self.model_part_cache_mesh_indices = 0
        if self.model_part_cache_primitive_indices != 0:
            Memory.free(self.model_part_cache_primitive_indices)
            self.model_part_cache_primitive_indices = 0
        if self.model_part_cache_mesh_ids != 0:
            Memory.free(self.model_part_cache_mesh_ids)
            self.model_part_cache_mesh_ids = 0
        self.model_part_cache_count = 0
        self.model_part_cache_capacity = 0
        self.core.cleanup()

attach GpuRendererCore:

    fun set_transform(self, mesh_id: i32, x: f32, y: f32, z: f32, rx: f32, ry: f32, rz: f32, sx: f32, sy: f32, sz: f32):
        gpu_set_transform(self, mesh_id, x, y, z, rx, ry, rz, sx, sy, sz)

    fun set_model_matrix_raw(self, mesh_id: i32, src: i64):
        gpu_set_model_matrix_raw(self, mesh_id, src)

    fun upload_plane_mesh(self) -> i32:
        verts: i64 = gpu_make_plane_vertices()
        if verts == 0:
            return -1
        mesh_id: i32 = self.upload_mesh(verts, 6)
        Memory.free(verts)
        return mesh_id

    fun upload_sprite_quad_mesh(self) -> i32:
        verts: i64 = gpu_make_sprite_quad_vertices()
        if verts == 0:
            return -1
        mesh_id: i32 = self.upload_mesh(verts, 6)
        Memory.free(verts)
        return mesh_id

    fun _shared_sprite_quad_mesh(self) -> i32:
        if self.sprite_quad_source_id >= 0:
            return self.sprite_quad_source_id
        mesh_id: i32 = self.upload_sprite_quad_mesh()
        if mesh_id >= 0:
            self.sprite_quad_source_id = mesh_id
        return mesh_id

    fun upload_colored_plane_mesh(self, color: Color) -> i32:
        verts: i64 = gpu_make_colored_plane_vertices(color)
        if verts == 0:
            return -1
        mesh_id: i32 = self.upload_mesh(verts, 6)
        Memory.free(verts)
        return mesh_id

    fun upload_cube_mesh(self) -> i32:
        verts: i64 = gpu_make_cube_vertices()
        if verts == 0:
            return -1
        mesh_id: i32 = self.upload_mesh(verts, 36)
        Memory.free(verts)
        return mesh_id

    fun upload_colored_cube_mesh(self, color: Color) -> i32:
        verts: i64 = gpu_make_colored_cube_vertices(color)
        if verts == 0:
            return -1
        mesh_id: i32 = self.upload_mesh(verts, 36)
        Memory.free(verts)
        return mesh_id

    fun upload_model_mesh(self, model: Model3D) -> i32:
        mesh: GpuMeshData = GpuMeshData()
        if Str.equals(model.format, "frogmodel"):
            mesh = gpu_make_frogmodel_model_vertices(model)
        else:
            mesh = gpu_make_gltf_model_vertices(model)
        if mesh.vertices == 0:
            return -1
        if mesh.vertex_count <= 0:
            Memory.free(mesh.vertices)
            if mesh.indices != 0:
                Memory.free(mesh.indices)
            return -1
        mesh_id: i32 = -1
        if mesh.indices != 0:
            if mesh.index_count > 0:
                mesh_id = self.upload_indexed_mesh(mesh.vertices, mesh.vertex_count, mesh.indices, mesh.index_count)
        if mesh_id < 0:
            mesh_id = self.upload_mesh(mesh.vertices, mesh.vertex_count)
        Memory.free(mesh.vertices)
        if mesh.indices != 0:
            Memory.free(mesh.indices)
        return mesh_id

    fun upload_model_part_mesh(self, model: Model3D, mesh_index: i32, primitive_index: i32) -> i32:
        mesh: GpuMeshData = GpuMeshData()
        if Str.equals(model.format, "frogmodel"):
            mesh = gpu_make_frogmodel_primitive_vertices(model, mesh_index, primitive_index)
        else:
            mesh = gpu_make_gltf_primitive_vertices(model, mesh_index, primitive_index)
        if mesh.vertices == 0:
            return -1
        if mesh.vertex_count <= 0:
            Memory.free(mesh.vertices)
            if mesh.indices != 0:
                Memory.free(mesh.indices)
            return -1
        mesh_id: i32 = -1
        if mesh.indices != 0:
            if mesh.index_count > 0:
                mesh_id = self.upload_indexed_mesh(mesh.vertices, mesh.vertex_count, mesh.indices, mesh.index_count)
        if mesh_id < 0:
            mesh_id = self.upload_mesh(mesh.vertices, mesh.vertex_count)
        Memory.free(mesh.vertices)
        if mesh.indices != 0:
            Memory.free(mesh.indices)
        return mesh_id

    fun upload_mesh_data(self, mesh: GpuMeshData) -> i32:
        if mesh.vertices == 0:
            return -1
        if mesh.vertex_count <= 0:
            return -1
        mesh_id: i32 = -1
        if mesh.indices != 0:
            if mesh.index_count > 0:
                mesh_id = self.upload_indexed_mesh(mesh.vertices, mesh.vertex_count, mesh.indices, mesh.index_count)
        if mesh_id < 0:
            mesh_id = self.upload_mesh(mesh.vertices, mesh.vertex_count)
        return mesh_id

    fun render_camera3d_frame(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32):
        self.render_camera3d_frame_with_environment(render_pass, swapchain, ctx, camera, width, height, Environment.create())

    fun render_camera3d_frame_with_environment(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32, env: Environment):
        view: i64 = self.scratch_camera_view
        proj: i64 = self.scratch_camera_proj
        if camera.orientation_mode != 0:
            gpu_camera_view_quat_into(camera.pos_x, camera.pos_y, camera.pos_z, camera.orientation_x, camera.orientation_y, camera.orientation_z, camera.orientation_w, view)
            forward: Vec3 = gpu_camera_quat_forward(camera.orientation_x, camera.orientation_y, camera.orientation_z, camera.orientation_w)
            orientation: Quat = Quat.make(camera.orientation_x, camera.orientation_y, camera.orientation_z, camera.orientation_w).normalize()
            up: Vec3 = orientation.rotate_vec3(Vec3.up())
            self.set_shadow_camera_basis(camera.pos_x, camera.pos_y, camera.pos_z, forward.x, forward.y, forward.z, up.x, up.y, up.z)
        else:
            gpu_camera_view_roll_into(camera.pos_x, camera.pos_y, camera.pos_z, camera.rot_x, camera.rot_y, camera.rot_z, view)
            orientation: Quat = Quat.from_euler_deg(camera.rot_y, camera.rot_x, camera.rot_z).normalize()
            forward: Vec3 = orientation.rotate_vec3(Vec3.forward())
            up: Vec3 = orientation.rotate_vec3(Vec3.up())
            self.set_shadow_camera_basis(camera.pos_x, camera.pos_y, camera.pos_z, forward.x, forward.y, forward.z, up.x, up.y, up.z)
        gpu_camera_proj_into_range(camera.fov, (width as f32) / (height as f32), camera.near_z, camera.far_z, proj)
        self.render_frame_with_environment(render_pass, swapchain, ctx.vk_device, ctx.vk_graphics_queue, ctx.vk_present_queue, view, proj, width, height, env)

    fun render_camera3d_frame_scaled(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32, render_width: i32, render_height: i32):
        self.render_camera3d_frame_scaled_with_environment(render_pass, swapchain, ctx, camera, width, height, render_width, render_height, Environment.create())

    fun render_camera3d_frame_scaled_with_environment(self, render_pass: RenderPass, swapchain: Swapchain, ctx: VulkanContext, camera: Camera3D, width: i32, height: i32, render_width: i32, render_height: i32, env: Environment):
        view: i64 = self.scratch_camera_view
        proj: i64 = self.scratch_camera_proj
        if camera.orientation_mode != 0:
            gpu_camera_view_quat_into(camera.pos_x, camera.pos_y, camera.pos_z, camera.orientation_x, camera.orientation_y, camera.orientation_z, camera.orientation_w, view)
            forward: Vec3 = gpu_camera_quat_forward(camera.orientation_x, camera.orientation_y, camera.orientation_z, camera.orientation_w)
            orientation: Quat = Quat.make(camera.orientation_x, camera.orientation_y, camera.orientation_z, camera.orientation_w).normalize()
            up: Vec3 = orientation.rotate_vec3(Vec3.up())
            self.set_shadow_camera_basis(camera.pos_x, camera.pos_y, camera.pos_z, forward.x, forward.y, forward.z, up.x, up.y, up.z)
        else:
            gpu_camera_view_roll_into(camera.pos_x, camera.pos_y, camera.pos_z, camera.rot_x, camera.rot_y, camera.rot_z, view)
            orientation: Quat = Quat.from_euler_deg(camera.rot_y, camera.rot_x, camera.rot_z).normalize()
            forward: Vec3 = orientation.rotate_vec3(Vec3.forward())
            up: Vec3 = orientation.rotate_vec3(Vec3.up())
            self.set_shadow_camera_basis(camera.pos_x, camera.pos_y, camera.pos_z, forward.x, forward.y, forward.z, up.x, up.y, up.z)
        gpu_camera_proj_into_range(camera.fov, (render_width as f32) / (render_height as f32), camera.near_z, camera.far_z, proj)
        self.render_frame_scaled_with_environment(render_pass, swapchain, ctx.vk_device, ctx.vk_graphics_queue, ctx.vk_present_queue, view, proj, width, height, render_width, render_height, env)
