#version 450

// GPU-driven frustum culling with indirect draw output (multi-group).
// One invocation per candidate. Visible candidates are compacted (full
// 96-byte graphics instance record) into the shared output buffer at
// [outBase + local_slot], and the per-group VkDrawIndexedIndirectCommand
// (cmds[cmdIndex]) instanceCount is atomic-incremented.
//
// The CPU pre-fills each cmd with indexCount + firstInstance=outBase and
// zeroes instanceCount, so vkCmdDrawIndexedIndirect reads the group's
// slice of the shared output buffer.
//
// Candidate layout (144 bytes): model 64 + material 16 + uv 16 + texidx 32 + bounds 16.
// Output layout (128 bytes): model + material + uv + texidx (= FROG_GPU_INSTANCE_STRIDE).

layout(local_size_x = 64) in;

struct Candidate {
    vec4 col0;
    vec4 col1;
    vec4 col2;
    vec4 col3;
    vec4 material;
    vec4 uv;
    uvec4 texIndex0;   // albedo, emissive, normal, metallicRoughness
    uvec4 texIndex1;   // occlusion, spare, spare, spare
    vec4 bounds;
};

struct OutInstance {
    vec4 col0;
    vec4 col1;
    vec4 col2;
    vec4 col3;
    vec4 material;
    vec4 uv;
    uvec4 texIndex0;
    uvec4 texIndex1;
};

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, binding = 0) readonly buffer InInstances {
    Candidate inInstances[];
};

layout(std430, binding = 1) writeonly buffer OutInstances {
    OutInstance outInstances[];
};

layout(std430, binding = 2) buffer IndirectCmds {
    DrawCmd cmds[];
};

layout(binding = 3) uniform sampler2D hzbDepth;

layout(std430, binding = 4) readonly buffer HzbState {
    mat4 previousViewProjection;
    vec4 params; // width, height, valid, conservative depth bias
} hzb;

layout(push_constant) uniform CullPush {
    vec4 planes[6];
    uint candidateCount;  // candidates for THIS group
    uint inBase;          // first candidate index (shared input buffer)
    uint outBase;         // first output slot (shared output buffer)
    uint cmdIndex;        // which indirect command this group writes
    vec4 camDistance;     // xyz = cull origin (camera), w = max distance
                          //       (<= 0 disables the distance cull)
} push;

bool sphereOccluded(vec4 sphere) {
    if (hzb.params.z < 0.5) {
        return false;
    }

    vec3 center = sphere.xyz;
    float radius = max(sphere.w, 0.001);
    vec2 ndcMin = vec2(1e20);
    vec2 ndcMax = vec2(-1e20);
    float nearestDepth = 1.0;

    // These eight corners enclose the sphere, so both the screen rectangle
    // and closest depth are conservative even for a rotated camera.
    for (int corner = 0; corner < 8; ++corner) {
        vec3 signCorner = vec3(
            (corner & 1) != 0 ? 1.0 : -1.0,
            (corner & 2) != 0 ? 1.0 : -1.0,
            (corner & 4) != 0 ? 1.0 : -1.0);
        vec4 clip = hzb.previousViewProjection * vec4(center + signCorner * radius, 1.0);
        if (clip.w <= 0.0001) {
            return false;
        }
        vec3 ndc = clip.xyz / clip.w;
        ndcMin = min(ndcMin, ndc.xy);
        ndcMax = max(ndcMax, ndc.xy);
        nearestDepth = min(nearestDepth, ndc.z);
    }

    if (nearestDepth <= 0.0) {
        return false;
    }
    if (ndcMax.x < -1.0 || ndcMin.x > 1.0 || ndcMax.y < -1.0 || ndcMin.y > 1.0) {
        return false;
    }

    ivec2 size = max(ivec2(hzb.params.xy), ivec2(1));
    vec2 uvMin = clamp(ndcMin * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    vec2 uvMax = clamp(ndcMax * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    ivec2 pixelMin = clamp(ivec2(floor(uvMin * vec2(size))) - ivec2(1), ivec2(0), size - ivec2(1));
    ivec2 pixelMax = clamp(ivec2(floor(uvMax * vec2(size))) + ivec2(1), ivec2(0), size - ivec2(1));
    ivec2 span = pixelMax - pixelMin + ivec2(1);

    // Large/near bounds are inexpensive to draw but expensive to scan.
    if (span.x * span.y > 128) {
        return false;
    }

    float farthestOccluder = 0.0;
    for (int y = pixelMin.y; y <= pixelMax.y; ++y) {
        for (int x = pixelMin.x; x <= pixelMax.x; ++x) {
            farthestOccluder = max(farthestOccluder, texelFetch(hzbDepth, ivec2(x, y), 0).r);
        }
    }
    return nearestDepth > farthestOccluder + hzb.params.w;
}

void main() {
    uint local = gl_GlobalInvocationID.x;
    if (local >= push.candidateCount) {
        return;
    }
    uint idx = push.inBase + local;

    Candidate inst = inInstances[idx];
    mat4 model = mat4(inst.col0, inst.col1, inst.col2, inst.col3);
    vec3 centerWorld = (model * vec4(inst.bounds.xyz, 1.0)).xyz;

    float sx = length(inst.col0.xyz);
    float sy = length(inst.col1.xyz);
    float sz = length(inst.col2.xyz);
    float maxScale = max(sx, max(sy, sz));
    if (maxScale < 0.001) {
        maxScale = 1.0;
    }
    // The stored radius already encloses the mesh AABB and includes one world
    // unit of padding. Match the CPU path's small numerical/motion margin
    // without the old 2.25x double expansion that retained off-screen chunks.
    float radius = inst.bounds.w * maxScale * 1.05 + 0.5;

    bool visible = true;
    for (int i = 0; i < 6; i++) {
        vec4 p = push.planes[i];
        float dist = dot(p.xyz, centerWorld) + p.w;
        if (dist < -radius) {
            visible = false;
        }
    }

    // Optional distance cull (shadow pass): reject casters whose bounding
    // sphere is entirely beyond maxDistance from the cull origin. Disabled
    // when camDistance.w <= 0 (the main camera pass passes 0 -> no change).
    if (push.camDistance.w > 0.0) {
        vec3 d = centerWorld - push.camDistance.xyz;
        float limit = push.camDistance.w + radius;
        if (dot(d, d) > limit * limit) {
            visible = false;
        }
    }
    // Dynamic camera-relative geometry has its own 2cm near plane. World
    // frustum/HZB cannot classify this foreground depth band. Shadow lists
    // exclude viewmodels through the normal per-instance cast flag.
    if (inst.material.z < 0.0 && push.camDistance.w == 0.0) {
        visible = true;
    }

    // Static-arena command mode. cmds[cmdIndex].instanceCount is a page-local
    // atomic draw counter/header; visible slices append compact commands after
    // it. The graphics pass consumes only that compact prefix through
    // vkCmdDrawIndexedIndirectCount, so invisible commands cost no MDI parsing.
    if (push.camDistance.w < 0.0) {
        if (visible && push.camDistance.w < -1.5) {
            visible = !sphereOccluded(vec4(centerWorld, radius));
        }
        if (visible) {
            uint drawSlot = atomicAdd(cmds[push.cmdIndex].instanceCount, 1u);
            uint command = push.cmdIndex + 1u + drawSlot;
            cmds[command].indexCount = inst.texIndex1.y;
            cmds[command].instanceCount = 1u;
            cmds[command].firstIndex = inst.texIndex1.z;
            cmds[command].vertexOffset = int(inst.texIndex1.w);
            cmds[command].firstInstance = 0u;
        }
        return;
    }

    if (visible) {
        uint local_slot = atomicAdd(cmds[push.cmdIndex].instanceCount, 1u);
        uint slot = push.outBase + local_slot;
        outInstances[slot].col0 = inst.col0;
        outInstances[slot].col1 = inst.col1;
        outInstances[slot].col2 = inst.col2;
        outInstances[slot].col3 = inst.col3;
        outInstances[slot].material = inst.material;
        outInstances[slot].uv = inst.uv;
        outInstances[slot].texIndex0 = inst.texIndex0;
        outInstances[slot].texIndex1 = inst.texIndex1;
    }
}
