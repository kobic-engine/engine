##############################
# Kobic Engine — GPU Profiler
# Per-frame GPU timing via VK_QUERY_TYPE_TIMESTAMP. Measures the GPU wall
# time of the shadow pass, the main pass, and the post/bloom pass, then
# prints a rolling average. Zero effect on the rendered image — it only
# inserts vkCmdWriteTimestamp calls and reads results back a frame later
# (double-buffered queries) so the GPU is never stalled.
#
# Enable via Engine.debug.gpu_timing(1) (off by default).
##############################

# 4 timestamps per frame: [0]=frame start, [1]=after shadow, [2]=after main,
# [3]=after bloom/present. Double-buffered across 2 slots so we read slot
# (frame-1) results while slot (frame) is being written.
# Indices 4..7 split the main pass: [4] after sky, [5] after static-batch
# draws, [6] after GPU-driven per-group draws, [7] before the render pass
# ends. [2] then also covers the HZB/end-of-pass work.
imm KOBIC_GPU_TS_PER_FRAME: i32 = 8
imm KOBIC_GPU_TS_SLOTS: i32 = 4
imm KOBIC_GPU_TS_TOTAL: i32 = 32   # KOBIC_GPU_TS_PER_FRAME * KOBIC_GPU_TS_SLOTS

struct GpuProfiler:
    device:        i64 = 0
    query_pool:    i64 = 0
    readback:      i64 = 0    # u64[KOBIC_GPU_TS_TOTAL] scratch for results
    ts_period_ns:  f32 = 1.0  # nanoseconds per timestamp tick (device limit)
    valid_bits:    i32 = 0
    enabled:       i32 = 0    # user opt-in
    ready:         i32 = 0    # pool created
    frame:         i32 = 0    # global frame counter (slot = frame % SLOTS)
    have_prev:     i32 = 0    # a previous slot has completed timestamps
    # Rolling accumulators (printed every N frames).
    acc_count:     i32 = 0
    acc_shadow_ms: f32 = 0.0
    acc_main_ms:   f32 = 0.0
    acc_post_ms:   f32 = 0.0
    acc_total_ms:  f32 = 0.0
    acc_sky_ms:    f32 = 0.0
    acc_static_ms: f32 = 0.0
    acc_groups_ms: f32 = 0.0
    acc_inst_ms:   f32 = 0.0
    acc_tail_ms:   f32 = 0.0
    acc_groups:    i64 = 0
    # Latest completed frame (ms): 0 total, 1 shadow, 2 main, 3 post, 4 sky,
    # 5 static batches, 6 per-group draws, 7 end of pass. -1 before any.
    last_ms: i64 = 0
    last_serial: i32 = 0
    # Bit i set once timestamp i was written this frame. Every query of the
    # slot must be written before readback (WAIT would otherwise block), so
    # missing sub-marks are filled at the main-pass boundary.
    written_mask:  i32 = 0
    # Pipeline statistics of the static-batch draws (device feature
    # pipelineStatisticsQuery): one query per slot, read back with the
    # timestamps. last_stats: input primitives, vertex invocations, clipping
    # invocations, clipping primitives, fragment invocations.
    stats_pool:    i64 = 0
    stats_ready:   i32 = 0
    stats_open:    i32 = 0
    stats_readback: i64 = 0
    last_stats:    i64 = 0
    stats_serial:  i32 = 0

attach GpuProfiler:

    # Create the timestamp query pool. phys_device is used to read the
    # timestampPeriod (ns/tick) and timestampValidBits from device limits.
    # Returns 1 on success. Safe to call once at renderer init.
    fun init(self, device: i64, phys_device: i64) -> i32:
        self.device = device

        # timestampPeriod (ns per tick). Hand-computing its byte offset in
        # VkPhysicalDeviceProperties proved unreliable (read 0). NVIDIA and AMD
        # both report exactly 1.0 ns/tick, so default to 1.0 — correct on this
        # RTX. The raw timestamp deltas are already in ~ns at period 1.0.
        period: f32 = 1.0
        self.ts_period_ns = period

        # VkQueryPoolCreateInfo (sType = 11):
        #  0 sType, 8 pNext, 16 flags, 20 queryType, 24 queryCount, 28 pipelineStats
        qp_ci: i64 = Memory.malloc_zeroed(32)
        if qp_ci == 0:
            return 0
        Memory.write_i32(qp_ci, 11)                  # QUERY_POOL_CREATE_INFO
        Memory.write_i32(qp_ci + 20, 2)              # VK_QUERY_TYPE_TIMESTAMP = 2
        Memory.write_i32(qp_ci + 24, KOBIC_GPU_TS_TOTAL)
        qp_out: i64 = Memory.malloc_zeroed(8)
        r: i32 = vkCreateQueryPool(self.device, qp_ci, 0, qp_out)
        self.query_pool = Memory.read_ptr(qp_out)
        Memory.free(qp_out)
        Memory.free(qp_ci)
        if r != 0:
            print(@"[kobic.gpu_timer] query pool creation failed r={r}")
            return 0
        self.readback = Memory.malloc_zeroed((KOBIC_GPU_TS_TOTAL as i64) * 8)
        if self.readback == 0:
            return 0
        self.ready = 1
        return 1

    # Requires the pipelineStatisticsQuery device feature (GpuCaps).
    fun init_pipeline_statistics(self) -> i32:
        if self.device == 0 or self.stats_ready != 0:
            return self.stats_ready
        qp_ci: i64 = Memory.malloc_zeroed(32)
        qp_out: i64 = Memory.malloc_zeroed(8)
        if qp_ci == 0 or qp_out == 0:
            Memory.free(qp_ci)
            Memory.free(qp_out)
            return 0
        Memory.write_i32(qp_ci, 11)                  # QUERY_POOL_CREATE_INFO
        Memory.write_i32(qp_ci + 20, 1)              # VK_QUERY_TYPE_PIPELINE_STATISTICS
        Memory.write_i32(qp_ci + 24, KOBIC_GPU_TS_SLOTS)
        # IA primitives 2, VS invocations 4, clipping invocations 32,
        # clipping primitives 64, FS invocations 128 (results in bit order).
        Memory.write_i32(qp_ci + 28, 2 + 4 + 32 + 64 + 128)
        r: i32 = vkCreateQueryPool(self.device, qp_ci, 0, qp_out)
        self.stats_pool = Memory.read_ptr(qp_out)
        Memory.free(qp_out)
        Memory.free(qp_ci)
        if r != 0:
            self.stats_pool = 0
            return 0
        self.stats_readback = Memory.malloc_zeroed(5 * 8)
        self.last_stats = Memory.malloc_zeroed(5 * 8)
        if self.stats_readback == 0 or self.last_stats == 0:
            return 0
        self.stats_ready = 1
        return 1

    # Static-batch draws only; both calls are inside the main render pass.
    fun begin_static_stats(self, cmd: i64):
        if self.is_active() == 0 or self.stats_ready == 0 or self.stats_open != 0:
            return
        slot: i32 = self.frame - (self.frame / KOBIC_GPU_TS_SLOTS) * KOBIC_GPU_TS_SLOTS
        vkCmdBeginQuery(cmd, self.stats_pool, slot, 0)
        self.stats_open = 1

    fun end_static_stats(self, cmd: i64):
        if self.stats_open == 0:
            return
        slot: i32 = self.frame - (self.frame / KOBIC_GPU_TS_SLOTS) * KOBIC_GPU_TS_SLOTS
        vkCmdEndQuery(cmd, self.stats_pool, slot)
        self.stats_open = 0

    fun last_pipeline_stat(self, stat: i32) -> i64:
        if self.last_stats == 0 or stat < 0 or stat > 4:
            return 0 - 1
        return Memory.read_i64(self.last_stats + (stat as i64) * 8)

    fun set_enabled(self, on: i32):
        if on == 0:
            self.enabled = 0
        else:
            self.enabled = 1
            self.have_prev = 0
            self.acc_count = 0
            self.acc_shadow_ms = 0.0
            self.acc_main_ms = 0.0
            self.acc_post_ms = 0.0
            self.acc_total_ms = 0.0

    fun is_active(self) -> i32:
        if self.ready == 0:
            return 0
        return self.enabled

    # First query index of the current frame's slot.
    fun _slot_base(self) -> i32:
        slot: i32 = self.frame - (self.frame / KOBIC_GPU_TS_SLOTS) * KOBIC_GPU_TS_SLOTS
        return slot * KOBIC_GPU_TS_PER_FRAME

    # Begin-of-frame: reset this slot's queries and write the start timestamp.
    # Must be called inside the command buffer, before the shadow pass.
    fun begin_frame(self, cmd: i64):
        if self.is_active() == 0:
            return
        base: i32 = self._slot_base()
        vkCmdResetQueryPool(cmd, self.query_pool, base, KOBIC_GPU_TS_PER_FRAME)
        if self.stats_ready != 0:
            vkCmdResetQueryPool(cmd, self.stats_pool, base / KOBIC_GPU_TS_PER_FRAME, 1)
        # Write at TOP_OF_PIPE (stage bit 1) for the frame-start marker.
        vkCmdWriteTimestamp(cmd, 1, self.query_pool, base)
        self.written_mask = 1

    # Mark a stage boundary (1 = after shadow, 2 = after main, 3 = after post).
    # Written at BOTTOM_OF_PIPE (stage bit 4096) so it captures all prior work.
    fun mark(self, cmd: i64, stage_index: i32):
        if self.is_active() == 0:
            return
        if stage_index < 1:
            return
        if stage_index >= KOBIC_GPU_TS_PER_FRAME:
            return
        base: i32 = self._slot_base()
        if stage_index == 2:
            # Fill any main-pass sub-mark this frame skipped (same instant).
            sub: i32 = 4
            while sub < KOBIC_GPU_TS_PER_FRAME:
                if (self.written_mask >> sub) % 2 == 0:
                    vkCmdWriteTimestamp(cmd, 4096, self.query_pool, base + sub)
                    self.written_mask = self.written_mask | (1 << sub)
                sub = sub + 1
        if (self.written_mask >> stage_index) % 2 == 1:
            return
        vkCmdWriteTimestamp(cmd, 4096, self.query_pool, base + stage_index)
        self.written_mask = self.written_mask | (1 << stage_index)

    # Number of GPU-driven draw groups issued this frame (one indirect draw
    # command each), reported next to the segment times.
    fun note_groups(self, groups: i32):
        if self.is_active() == 0:
            return
        self.acc_groups = self.acc_groups + (groups as i64)

    # End-of-frame (CPU side, after submit): read back the PREVIOUS slot's
    # completed timestamps and accumulate. Advances the frame counter.
    fun end_frame(self):
        if self.is_active() == 0:
            self.frame = self.frame + 1
            return

        # Read back a slot that completed several frames ago (KOBIC_GPU_TS_SLOTS
        # rotation means the GPU is long done with it). No WAIT flag: a frame
        # that ended early (resize/scale change) leaves queries unwritten, and
        # waiting on those can stall; NOT_READY just skips that sample.
        if self.frame >= KOBIC_GPU_TS_SLOTS:
            old_frame: i32 = self.frame - (KOBIC_GPU_TS_SLOTS - 1)
            prev_slot: i32 = old_frame - (old_frame / KOBIC_GPU_TS_SLOTS) * KOBIC_GPU_TS_SLOTS
            prev_base: i32 = prev_slot * KOBIC_GPU_TS_PER_FRAME
            # flags: VK_QUERY_RESULT_64_BIT (1). Read all u64 results of the slot.
            # (8 is PARTIAL: results came back as u32, so timestamps wrapped
            # every ~4.3 s at 1 ns/tick and produced negative segments.)
            r: i32 = vkGetQueryPoolResults(self.device, self.query_pool, prev_base, KOBIC_GPU_TS_PER_FRAME, (KOBIC_GPU_TS_PER_FRAME as i64) * 8, self.readback, 8, 1)
            if self.stats_ready != 0:
                # No WAIT: a frame that never began the query reports NOT_READY.
                rs: i32 = vkGetQueryPoolResults(self.device, self.stats_pool, prev_slot, 1, 5 * 8, self.stats_readback, 5 * 8, 1)
                if rs == 0:
                    Memory.copy(self.last_stats, self.stats_readback, 5 * 8)
                    self.stats_serial = self.stats_serial + 1
            if r == 0:
                t0: i64 = Memory.read_i64(self.readback + 0)
                t1: i64 = Memory.read_i64(self.readback + 8)
                t2: i64 = Memory.read_i64(self.readback + 16)
                t3: i64 = Memory.read_i64(self.readback + 24)
                t4: i64 = Memory.read_i64(self.readback + 32)
                t5: i64 = Memory.read_i64(self.readback + 40)
                t6: i64 = Memory.read_i64(self.readback + 48)
                t7: i64 = Memory.read_i64(self.readback + 56)
                self.acc_sky_ms = self.acc_sky_ms + self._ticks_to_ms(t4 - t1)
                self.acc_static_ms = self.acc_static_ms + self._ticks_to_ms(t5 - t4)
                self.acc_groups_ms = self.acc_groups_ms + self._ticks_to_ms(t6 - t5)
                self.acc_inst_ms = self.acc_inst_ms + self._ticks_to_ms(t7 - t6)
                self.acc_tail_ms = self.acc_tail_ms + self._ticks_to_ms(t2 - t7)
                self.acc_shadow_ms = self.acc_shadow_ms + self._ticks_to_ms(t1 - t0)
                self.acc_main_ms = self.acc_main_ms + self._ticks_to_ms(t2 - t1)
                self.acc_post_ms = self.acc_post_ms + self._ticks_to_ms(t3 - t2)
                self.acc_total_ms = self.acc_total_ms + self._ticks_to_ms(t3 - t0)
                self.acc_count = self.acc_count + 1
                if self.last_ms == 0:
                    self.last_ms = Memory.malloc_zeroed(8 * 4)
                if self.last_ms != 0:
                    Memory.write_f32(self.last_ms + 0, self._ticks_to_ms(t3 - t0))
                    Memory.write_f32(self.last_ms + 4, self._ticks_to_ms(t1 - t0))
                    Memory.write_f32(self.last_ms + 8, self._ticks_to_ms(t2 - t1))
                    Memory.write_f32(self.last_ms + 12, self._ticks_to_ms(t3 - t2))
                    Memory.write_f32(self.last_ms + 16, self._ticks_to_ms(t4 - t1))
                    Memory.write_f32(self.last_ms + 20, self._ticks_to_ms(t5 - t4))
                    Memory.write_f32(self.last_ms + 24, self._ticks_to_ms(t6 - t5))
                    Memory.write_f32(self.last_ms + 28, self._ticks_to_ms(t2 - t7))
                    self.last_serial = self.last_serial + 1
                if self.acc_count >= 120:
                    n: f32 = self.acc_count as f32
                    sh: f32 = self.acc_shadow_ms / n
                    mn: f32 = self.acc_main_ms / n
                    po: f32 = self.acc_post_ms / n
                    tot: f32 = self.acc_total_ms / n
                    print(@"[kobic.gpu_timer] gpu_ms total={tot} shadow={sh} main={mn} post={po} (avg/{self.acc_count})")
                    sky_ms: f32 = self.acc_sky_ms / n
                    static_ms: f32 = self.acc_static_ms / n
                    groups_ms: f32 = self.acc_groups_ms / n
                    inst_ms: f32 = self.acc_inst_ms / n
                    tail_ms: f32 = self.acc_tail_ms / n
                    groups_per_frame: i64 = self.acc_groups / (self.acc_count as i64)
                    print(@"[kobic.gpu_timer] main split: sky={sky_ms} staticBatches={static_ms} perGroupDraws={groups_ms} (groups/frame={groups_per_frame}) instances={inst_ms} endPassHzb={tail_ms}")
                    self.acc_sky_ms = 0.0
                    self.acc_static_ms = 0.0
                    self.acc_groups_ms = 0.0
                    self.acc_inst_ms = 0.0
                    self.acc_tail_ms = 0.0
                    self.acc_groups = 0
                    self.acc_count = 0
                    self.acc_shadow_ms = 0.0
                    self.acc_main_ms = 0.0
                    self.acc_post_ms = 0.0
                    self.acc_total_ms = 0.0

        self.have_prev = 1
        self.frame = self.frame + 1

    fun last_segment_ms(self, segment: i32) -> f32:
        if self.last_ms == 0 or segment < 0 or segment > 7:
            return 0.0 - 1.0
        return Memory.read_f32(self.last_ms + (segment as i64) * 4)

    fun _ticks_to_ms(self, ticks: i64) -> f32:
        ns: f32 = (ticks as f32) * self.ts_period_ns
        return ns / 1000000.0

    fun cleanup(self):
        if self.query_pool != 0:
            vkDestroyQueryPool(self.device, self.query_pool, 0)
            self.query_pool = 0
        if self.readback != 0:
            Memory.free(self.readback)
            self.readback = 0
        if self.stats_pool != 0:
            vkDestroyQueryPool(self.device, self.stats_pool, 0)
            self.stats_pool = 0
        if self.stats_readback != 0:
            Memory.free(self.stats_readback)
            self.stats_readback = 0
        if self.last_stats != 0:
            Memory.free(self.last_stats)
            self.last_stats = 0
        self.stats_ready = 0
        self.ready = 0
        self.enabled = 0
